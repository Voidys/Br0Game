{% extends layout_template %}
{% block title %}{{ LNG.siteTitleLostPassword }}{{ parent() }}{% endblock %}
{% block content %}
<p>{{ LNG.passwordInfo }}</p>
<form class="form" action="./?page=lostPassword" method="post" data-action="./?page=lostPassword">
  <input type="hidden" value="send" name="mode">
  <div class="field">
    <label for="username">{{ LNG.passwordUsername }}</label>
    <input type="text" name="username" id="username" autocomplete="username">
  </div>
  <div class="field">
    <label for="mail">{{ LNG.passwordMail }}</label>
    <input type="email" name="mail" id="mail" autocomplete="email">
  </div>
  <div class="form__actions">
    <button type="submit" class="btn--primary btn-hero">{{ icon('send') }}{{ LNG.passwordSubmit }}</button>
  </div>
</form>
{% endblock %}
