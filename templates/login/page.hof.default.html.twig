{% import '_macros/forms.html.twig' as forms -%}
{% extends layout_template %}
{% macro lbl(label) %}{{ LNG.has(label) ? LNG[label] : label }}{% endmacro %}
{% block title %}{{ LNG.siteTitleHOF }}{{ parent() }}{% endblock %}

{% block content %}
{% if hof is null %}
  <p class="empty">{{ LNG.hof_empty }}</p>
{% else %}
  {% if universeSelect|length > 1 %}
  <form class="filter-bar" name="stats" id="stats" method="get" action="">
    <select name="universe" id="universe" class="changeUni" data-autosubmit>{{ forms.html_options({'options': universeSelect, 'selected': universe}) }}</select>
  </form>
  {% endif %}
  {% if hof.title %}<h2>{{ _self.lbl(hof.title) }}</h2>{% endif %}
  <div class="table-scroll">
  <table class="HOF-Table">
    <tr>
      <th>{{ LNG.theme }}</th>
      <th>{{ LNG.players }}</th>
      <th>{{ LNG.points_amount }}</th>
    </tr>
    {% for section in hof.sections %}
      {% if section.label != '' %}
    <tr><th colspan="3">{{ _self.lbl(section.label) }}</th></tr>
      {% endif %}
      {% for entry in section.entries %}
    <tr>
      <td>{{ _self.lbl(entry.label) }}</td>
      <td>
        {% for rank in entry.ranks %}
          {% if not loop.first %}<br>{% endif %}
          {% if rank.pos is defined %}<span class="{{ {1: 'gold', 2: 'silver', 3: 'bronze'}[rank.pos] ?? '' }}">{{ rank.pos }}.</span> {% endif %}
          {% if rank.label is defined %}{{ _self.lbl(rank.label) }}{% if rank.player != '' %}: {% endif %}{% endif %}
          {{ rank.player }}
        {% endfor %}
      </td>
      <td>
        {% for rank in entry.ranks %}
          {% if not loop.first %}<br>{% endif %}
          {{ rank.value ?? '' }}
        {% endfor %}
      </td>
    </tr>
      {% endfor %}
    {% endfor %}
  </table>
  </div>
{% endif %}
{% endblock %}
