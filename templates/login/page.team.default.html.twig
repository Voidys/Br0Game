{% extends layout_template %}
{% block title %}{{ LNG.team }}{{ parent() }}{% endblock %}

{% block content %}
	<div class="prose team-intro">{{ LNG.kontakt }}</div>
	{% if members|length > 0 %}
	<div class="table-scroll">
	<table class="team">
		<thead>
		<tr>
			<th>{{ LNG.teamMemberName }}</th>
			<th>{{ LNG.teamRole }}</th>
			<th>{{ LNG.teamMemberContact }}</th>
			<th>{{ LNG.teamMemberAbout }}</th>
		</tr>
		</thead>
		<tbody>
		{% for member in members %}
		<tr>
			<td><strong>{{ member.name|e }}</strong></td>
			<td>{{ member.position|e }}</td>
			<td>{{ member.contact|e }}</td>
			<td>{{ member.description|e|nl2br }}</td>
		</tr>
		{% endfor %}
		</tbody>
	</table>
	</div>
	{% else %}
	<p class="muted">{{ LNG.teamEmpty }}</p>
	{% endif %}
{% endblock %}
