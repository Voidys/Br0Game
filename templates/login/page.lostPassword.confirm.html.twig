{% extends layout_template %}
{% block title %}{{ LNG.siteTitleLostPassword }}{{ parent() }}{% endblock %}
{% block content %}
<p>{{ LNG.passwordConfirmInfo }}</p>
<form class="form" action="./?page=lostPassword" method="post">
  <input type="hidden" value="newPassword" name="mode">
  <input type="hidden" value="{{ accountID }}" name="u">
  <input type="hidden" value="{{ validationKey }}" name="k">
  <div class="form__actions">
    <button type="submit" class="btn--primary btn-hero">{{ icon('send') }}{{ LNG.passwordConfirmSubmit }}</button>
  </div>
</form>
{% endblock %}
