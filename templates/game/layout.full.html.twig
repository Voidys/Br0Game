{% extends 'game/layout.base.html.twig' %}

{% block bodyclass %}layout layout--full{% endblock %}

{% block body %}
<a class="skip-link" href="#content">{{ LNG.ui_skip_to_content|default('Skip to content') }}</a>

<header class="topbar">
  {% include 'game/main.topnav.html.twig' %}
</header>

<aside class="sidebar" id="sidebar" aria-label="{{ LNG.ui_menu|default('Menu') }}">
  <button type="button" class="sidebar__close icon-button" data-sidebar-toggle aria-label="{{ LNG.ui_close }}">{{ icon('x') }}<span>{{ LNG.ui_close }}</span></button>
  <div class="drawer-head">
    <details class="drawer-planets">
      <summary>{{ icon('globe') }}<span class="drawer-planets__current">{{ PlanetSelect[current_pid]|default(LNG.ui_planet) }}</span>{{ icon('chevron-down') }}</summary>
      <ul>
        {% for pid, pname in PlanetSelect %}
          <li><button type="button" class="drawer-planets__item" data-planet-goto="{{ pid }}"{% if pid == current_pid %} aria-current="true"{% endif %}>{{ pname }}</button></li>
        {% endfor %}
      </ul>
    </details>
    <div class="drawer-account">
      <a class="drawer-account__item drawer-account__user" href="{{ path('game_settings_show') }}">{{ icon('user') }}<span>{{ username }}</span></a>
      {% if authlevel > 0 %}<a class="drawer-account__item drawer-account__admin" href="./admin" title="{{ LNG.lm_administration }}">{{ icon('shield-alert', LNG.lm_administration) }}</a>{% endif %}
      <div class="drawer-account__tools">
        {% if isModuleAvailable(constant('MODULE_NOTICE')) and (not noobInterface or not tutorial) %}<a class="drawer-account__item" href="{{ path('game_notes_show') }}" data-action="popup" data-url="{{ path('game_notes_show') }}" data-width="720" title="{{ LNG.lm_notes }}">{{ icon('sticky-note', LNG.lm_notes) }}</a>{% endif %}
        {% if account_id != 0 %}<a class="drawer-account__item" href="{{ path('account_account_show') }}" title="{{ LNG['Account'] }}">{{ icon('user', LNG['Account']) }}</a>{% endif %}
        <a class="drawer-account__item" href="{{ path('login_data_privacy_show') }}" data-dialog data-dialog-width="820" title="{{ LNG.lm_dataPrivacy }}">{{ icon('shield-check', LNG.lm_dataPrivacy) }}</a>
      </div>
      <span class="drawer-account__item drawer-account__clock" title="{{ LNG.ui_server_time|default('Server time') }}">{{ icon('clock') }}<span class="servertime">{{ serverClock|default('') }}</span></span>
      <a data-method="post" class="drawer-account__item drawer-account__logout" href="{{ path('game_logout_show') }}" title="{{ LNG.lm_logout }}">{{ icon('log-out', LNG.lm_logout) }}<span>{{ LNG.lm_logout }}</span></a>
    </div>
  </div>
  {% include 'game/main.navigation.html.twig' %}
</aside>
<div class="sidebar-backdrop" aria-hidden="true"></div>
{% include 'game/main.tabbar.html.twig' %}

<main class="content" id="content">
  {% if hasAdminAccess %}
    <div class="globalWarning">
      {{ icon('shield-alert') }}
      <span>{{ LNG.admin_access_1 }} <a id="drop-admin" href="#">{{ LNG.admin_access_link }}</a>{{ LNG.admin_access_2 }}</span>
    </div>
  {% endif %}
  {% if noobInterface and tutorial %}
    <div class="globalWarning globalWarning--info">
      {{ icon('info') }}
      <span>{{ LNG.noob_interface }}</span>
    </div>
  {% endif %}
  {% if hasRebuildProtection %}
    <div class="globalWarning">
      {{ icon('shield') }}
      <span>{{ LNG.rebuild_proteciton_mode }} <a id="drop-rebuild-protection" href="#" data-url="{{ path('game_rebuild_protection_ajax_show') }}">{{ LNG.rebuild_proteciton_link }}</a>
        <span class="countdown" data-time="{{ rebuildProtectionUntil }}"></span></span>
    </div>
  {% endif %}
  {% if uni_status == 1 or uni_status == 2 %}
    <div class="infobox">{{ icon('triangle-alert') }}<span>{{ LNG.ov_closed }}</span></div>
  {% elseif delete %}
    <div class="infobox">{{ icon('triangle-alert') }}<span>{{ delete }}</span></div>
  {% elseif vacation %}
    <div class="infobox">{{ icon('moon') }}<span>{{ vacation }}</span></div>
  {% endif %}

  {% include 'game/main.sectiontabs.html.twig' %}
  {% block pagehead %}{% endblock %}
  {% block content %}{% endblock %}
</main>

{% if loginNotice %}
  {# once per login (AbstractGameController::newMessagesNotice); the top bar badge keeps the count afterwards #}
  <div class="login-notice" role="status" data-login-notice>
    {{ icon('mail') }}
    <a class="login-notice__link" href="{{ loginNotice.url }}">{{ loginNotice.text }}</a>
    <button type="button" class="login-notice__close" data-login-notice-close aria-label="{{ LNG.ui_close }}">{{ icon('x') }}</button>
  </div>
{% endif %}

{% include 'shared/cookie_notice.html.twig' %}

<footer class="footer">
  {% include 'game/main.footer.html.twig' %}
</footer>
{% endblock %}
