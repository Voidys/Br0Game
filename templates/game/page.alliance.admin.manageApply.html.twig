{% extends layout_template %}
{% block title %}{{ LNG.lm_alliance }}{{ parent() }}{% endblock %}
{% block content %}
<table>
	<tr>
		<th colspan="2">{{ LNG.al_request_list }}</th>
	</tr>
	<tr>
		<th>{{ LNG.al_candidate }}</th>
		<th>{{ LNG.al_request_date }}</th>
	</tr>
	{% for applyRow in applyList %}
	<tr>
		<td><a href="{{ path('game_alliance_admin_detail_apply', {id: applyRow.id}) }}">{{ applyRow.username }}</a></td>
		<td><a href="{{ path('game_alliance_admin_detail_apply', {id: applyRow.id}) }}">{{ applyRow.time }}</a></td>
	</tr>
	{% else %}
	<tr>
		<td colspan="2">{{ LNG.al_no_requests }}</td>
	</tr>
	{% endfor %}
	<tr>
		<th colspan="2"><a href="{{ path('game_alliance_show') }}">{{ LNG.al_back }}</a></th>
	</tr>
</table>
{% endblock %}