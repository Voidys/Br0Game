<table class='tt-galaxy'>
    <tr>
        <th colspan='2'>{{ currentPlanet.user.playerrank }}</th>
    </tr>
    {% if currentPlanet.action.message %}
        <tr>
            <td>
                <a href='#' data-action="dialog-pm" data-id="{{ currentPlanet.user.id }}">
                    {{ LNG.write_message }}
                </a>
            </td>
        </tr>
    {% endif %}
    {% if not currentPlanet.user.isBuddy and not currentPlanet.ownPlanet %}
        <tr>
            <td>
                <a href='#' data-action="dialog-buddy" data-id="{{ currentPlanet.user.id }}">
                    {{ LNG.gl_buddy_request }}
                </a>
            </td>
        </tr>
    {% endif %}
    <tr>
        <td>
            <a href='#' playerid='{{ currentPlanet.user.id }}' data-action="dialog-playercard" data-id="{{ currentPlanet.user.id }}">
                {{ LNG.gl_playercard }}
            </a>
        </td>
    </tr>
    <tr>
        <td>
            <a href='{{ path('game_statistics_show', {who: 1, start: currentPlanet.user.rank}) }}'>
                {{ LNG.gl_see_on_stats }}
            </a>
        </td>
    </tr>
</table>