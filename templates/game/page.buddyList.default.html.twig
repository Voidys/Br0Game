{% extends layout_template %}
{% block title %}{{ LNG.lm_buddylist }}{{ parent() }}{% endblock %}
{% block content %}
<table>
<tr><th colspan="5">{{ LNG.bu_buddy_list }}</th></tr>
{% if otherRequestList %}
<tr><th colspan="5">{{ LNG.bu_requests }}</th></tr>
<tr>
	<th>{{ LNG.bu_player }}</th>
	<th>{{ LNG.bu_alliance }}</th>
	<th class="ctr">{{ LNG.bu_coords }}</th>
	<th>{{ LNG.bu_text }}</th>
	<th class="ctr">{{ LNG.bu_action }}</th>
</tr>
{% for otherRequestID, otherRequestRow in otherRequestList %}
<tr>
	<td><a href="#" data-action="dialog-pm" data-id="{{ otherRequestRow.id }}">{{ otherRequestRow.username }}</a></td>
	<td>{% if otherRequestRow.ally_name %}<a href="{{ path('game_alliance_info', {id: otherRequestRow.ally_id}) }}">{{ otherRequestRow.ally_name }}</a>{% else %}-{% endif %}</td>
	<td class="ctr"><a href="{{ path('game_galaxy_show', {galaxy: otherRequestRow.galaxy, system: otherRequestRow.system}) }}">[{{ otherRequestRow.galaxy }}:{{ otherRequestRow.system }}:{{ otherRequestRow.planet }}]</a></td>
	<td>{{ otherRequestRow.text }}</td>
	<td class="act"><a data-method="post" href="{{ path('game_buddy_list_accept', {id: otherRequestID}) }}"><img src="styles/resource/images/true.webp" alt="{{ LNG.bu_accept }}" title="{{ LNG.bu_accept }}"></a><a data-method="post" href="{{ path('game_buddy_list_delete', {id: otherRequestID}) }}"><img src="styles/resource/images/false.webp" alt="{{ LNG.bu_decline }}" title="{{ LNG.bu_decline }}"></a></td>
</tr>
{% else %}
<tr><td colspan="5">{{ LNG.bu_no_request }}</td></tr>
{% endfor %}
{% endif %}
{% if myRequestList %}
<tr><th colspan="5">{{ LNG.bu_my_requests }}</th></tr>
<tr>
	<th>{{ LNG.bu_player }}</th>
	<th>{{ LNG.bu_alliance }}</th>
	<th class="ctr">{{ LNG.bu_coords }}</th>
	<th>{{ LNG.bu_text }}</th>
	<th class="ctr">{{ LNG.bu_action }}</th>
</tr>
{% for myRequestID, myRequestRow in myRequestList %}
<tr>
	<td><a href="#" data-action="dialog-pm" data-id="{{ myRequestRow.id }}">{{ myRequestRow.username }}</a></td>
	<td>{% if myRequestRow.ally_name %}<a href="{{ path('game_alliance_info', {id: myRequestRow.ally_id}) }}">{{ myRequestRow.ally_name }}</a>{% else %}-{% endif %}</td>
	<td class="ctr"><a href="{{ path('game_galaxy_show', {galaxy: myRequestRow.galaxy, system: myRequestRow.system}) }}">[{{ myRequestRow.galaxy }}:{{ myRequestRow.system }}:{{ myRequestRow.planet }}]</a></td>
	<td>{{ myRequestRow.text }}</td>
	<td class="act"><a data-method="post" href="{{ path('game_buddy_list_delete', {id: myRequestID}) }}"><img src="styles/resource/images/false.webp" alt="{{ LNG.bu_cancel_request }}" title="{{ LNG.bu_cancel_request }}"></a></td>
</tr>
{% else %}
<tr><td colspan="5">{{ LNG.bu_no_request }}</td></tr>
{% endfor %}
{% endif %}
<tr><th colspan="5">{{ LNG.bu_partners }}</th></tr>
	<tr>
	<th>{{ LNG.bu_player }}</th>
	<th>{{ LNG.bu_alliance }}</th>
	<th class="ctr">{{ LNG.bu_coords }}</th>
	<th class="ctr">{{ LNG.bu_online }}</th>
	<th class="ctr">{{ LNG.bu_action }}</th>
</tr>
{% for myBuddyID, myBuddyRow in myBuddyList %}
<tr>
	<td><a href="#" data-action="dialog-pm" data-id="{{ myBuddyRow.id }}">{{ myBuddyRow.username }}</a></td>
	<td>{% if myBuddyRow.ally_name %}<a href="{{ path('game_alliance_info', {id: myBuddyRow.ally_id}) }}">{{ myBuddyRow.ally_name }}</a>{% else %}-{% endif %}</td>
	<td class="ctr"><a href="{{ path('game_galaxy_show', {galaxy: myBuddyRow.galaxy, system: myBuddyRow.system}) }}">[{{ myBuddyRow.galaxy }}:{{ myBuddyRow.system }}:{{ myBuddyRow.planet }}]</a></td>
	<td class="ctr">
	{% if myBuddyRow.onlinetime < 4 %}
	<span class="colorPositive">{{ LNG.bu_connected }}</span>
	{% elseif myBuddyRow.onlinetime >= 4 and myBuddyRow.onlinetime <= 15 %}
	<span class="color-yellow">{{ myBuddyRow.onlinetime }} {{ LNG.bu_minutes }}</span>
	{% else %}
	<span class="colorNegative">{{ LNG.bu_disconnected }}</span>
	{% endif %}
	</td>
	<td class="act"><a data-method="post" href="{{ path('game_buddy_list_delete', {id: myBuddyID}) }}"><img src="styles/resource/images/false.webp" alt="{{ LNG.bu_delete }}" title="{{ LNG.bu_delete }}"></a></td>
</tr>
{% else %}
<tr><td colspan="5">{{ LNG.bu_no_buddys }}</td></tr>
{% endfor %}
</table>
{% endblock %}