{% import '_macros/forms.html.twig' as forms -%}
<form action="?page=fleetTable&amp;action=acs" method="post">
<input name="fleetID" value="{{ acsData.mainFleetID }}" type="hidden">
	<table>
		<tr>
			<th colspan="2">{{ LNG.fl_sac_of_fleet }}</th>
		</tr>
		<tr>
			<th colspan="2">{{ LNG.fl_modify_sac_name }} (<a href="#" data-action="acs-rename" data-fleet="{{ acsData.mainFleetID }}" data-prompt="{{ LNG.fl_acs_change_name|e('html_attr') }}" data-name="{{ acsData.acsName }}">{{ LNG.fl_acs_change }}</a>)</th>
		</tr>
		<tr>
			<td colspan="2" id="acsName">{{ acsData.acsName }}</td>
		</tr>
		<tr>
			<th>{{ LNG.fl_members_invited }}</th>
			<th>{{ LNG.fl_invite_members }}</th>
		</tr>
		{% if not empty(acsData.statusMessage) %}
		<tr>
			<td colspan="2">
				{{ acsData.statusMessage }}
			</td>
		</tr>
		{% endif %}
		<tr>
			<td>
				<select size="5" class="control-wide">
					{{ forms.html_options({'options': acsData.invitedUsers}) }}
                </select>
			</td>
			<td>
				<p><input name="username" type="text" class="control-wide"></p>
				<p class="form-actions"><input type="submit" value="{{ LNG.fl_continue }}"></p>
			</td>
		</tr>
	</table>
</form>
<script type="module" src="./scripts/game/acs.js?v={{ asset_version }}"></script>
