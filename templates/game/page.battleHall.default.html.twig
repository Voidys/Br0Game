{% extends layout_template %}
{% block title %}{{ LNG.lm_topkb }}{{ parent() }}{% endblock %}
{% block content %}
<form name="stats" id="stats" method="post" action="">
	<table class="form-table">
		<tr>
			<th colspan="2">{{ LNG.tkb_top }}</th>
		</tr>
		<tr>
			<td><label for="memorial">{{ LNG.tkb_memorial }}</label></td>
			<td><select name="memorial" id="memorial" onchange="this.form.requestSubmit();">{{ html_options({'options': Selectors.memorial, 'selected': memorial}) }}</select></td>
		</tr>
		<tr>
			<td><label for="timeframe">{{ LNG.tkb_timeframe }}</label></td>
			<td><select name="timeframe" id="timeframe" onchange="this.form.requestSubmit();">{{ html_options({'options': Selectors.timeframe, 'selected': timeframe}) }}</select></td>
		</tr>
		<tr>
			<td><label for="diplomacy">{{ LNG.tkb_diplomacy }}</label></td>
			<td><select name="diplomacy" id="diplomacy" onchange="this.form.requestSubmit();">{{ html_options({'options': Selectors.diplomacy, 'selected': diplomacy}) }}</select></td>
		</tr>
		<tr>
			<td><label for="galaxy">{{ LNG.tkb_galaxy }}</label></td>
			<td><select name="galaxy" id="galaxy" onchange="this.form.requestSubmit();">{{ html_options({'options': Selectors.galaxy, 'selected': galaxy}) }}</select></td>
		</tr>
	</table>
</form>
<table>
<tbody>
<tr>
    <th colspan="4">{{ LNG.tkb_top }}</th>
</tr>
<tr>
    <td colspan="4">{{ LNG.tkb_gratz }}</td>
</tr>
<tr>
    <td class="ctr">{{ LNG.tkb_platz }}</td>
	<td>{{ LNG.tkb_owners }}</td>
    <td>{{ LNG.tkb_datum }}</td>
	<td class="num">{{ LNG.tkb_units }}</td>
</tr>
{% for row in (TopKBList)|php_iter %}
    <tr>
        <td class="ctr">{{ loop.index }}</td>
        <td><a href="game?page=raport&amp;raport={{ row.rid }}" target="_blank">
        {% if row.result == "a" %}
        <span class="colorPositive">{{ row.attacker }}</span> VS <span class="colorNegative">{{ row.defender }}</span>
        {% elseif row.result == "r" %}
        <span class="colorNegative">{{ row.attacker }}</span> VS <span class="colorPositive">{{ row.defender }}</span>
        {% else %}
        {{ row.attacker }} VS {{ row.defender }}
        {% endif %}
        </a></td>
        <td>{{ row.date }}</td>
        <td class="num">{{ pretty_number(row.units) }}</td>
    </tr>
{% endfor %}
<tr>
<td colspan="4">{{ LNG.tkb_legende }}<span class="colorPositive">{{ LNG.tkb_gewinner }}</span><span class="colorNegative">{{ LNG.tkb_verlierer }}</span></td></tr>
</tbody>
</table>
{% endblock %}
