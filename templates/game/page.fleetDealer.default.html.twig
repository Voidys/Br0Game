{% extends layout_template %}
{% block title %}{{ LNG.lm_fleettrader }}{{ parent() }}{% endblock %}
{% block content %}
<form action="game?page=fleetDealer" method="post">
	<input type="hidden" name="mode" value="send">
	<table>
        <tr>
			<th>{{ LNG.ft_head }}</th>
		</tr>
        <tr>
			<td>
				<div class="transparent text-left float-left"><img id="img" alt="" data-src="{{ dpath }}gebaeude/"></div>
				<div class="transparent text-right float-right fleet-dealer-pick">
					<select name="shipID" id="shipID" onchange="updateVars()">
						{% for shipID in (shipIDs)|php_iter %}
						<option value="{{ shipID }}">{{ LNG.tech[shipID] }}</option>
						{% endfor %}
					</select>
				</div>
				<div class="fleet-dealer-body">
					<h2 id="traderHead"></h2>
					<p>
            {{ LNG.ft_count }}:
            <span class="control-group">
              <input type="text" id="count" name="count" onkeyup="Total();" class="num">
              <button onclick="MaxShips();return false;">{{ LNG.ft_max }}</button>
            </span>
          </p>
					<p>
            {{ LNG.tech[901] }}: <span id="metal" class="bold"></span> &bull;
            {{ LNG.tech[902] }}: <span id="crystal" class="bold"></span> &bull;
            {{ LNG.tech[903] }}: <span id="deuterium" class="bold"></span>
          </p>
					<p>
            {{ LNG.ft_total }}:
            {{ LNG.tech[901] }}: <span id="total_metal" class="bold"></span> &bull;
            {{ LNG.tech[902] }}: <span id="total_crystal" class="bold"></span> &bull;
            {{ LNG.tech[903] }}: <span id="total_deuterium" class="bold"></span>
          </p>
					<p><input type="submit" value="{{ LNG.ft_absenden }}"></p>
					<p>{{ LNG.ft_charge }}: {{ Charge }}%</p>
				</div>
			</td>
		</tr>
	</table>
</form>
{% endblock %}
{% block script %}{{ parent() }}
<script type="module" src="scripts/game/fleettrader.js"></script>
<script>
var CostInfo = {{ CostInfos|json_encode|raw }};
var Charge = {{ Charge }};
</script>
{% endblock %}
