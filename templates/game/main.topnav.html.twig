{% import '_macros/forms.html.twig' as forms -%}
<button type="button" class="topbar__menu icon-button" data-sidebar-toggle aria-controls="sidebar" aria-label="{{ LNG.ui_menu|default('Menu') }}">
  {{ icon('menu') }}
</button>

<a class="topbar__brand" href="{{ path('game_overview_show') }}">
  <span class="wordmark">V<b>0</b>Game</span>
</a>

<div class="planet-switch">
  <a class="planet-switch__image" href="{{ path('game_overview_show') }}" title="{{ LNG.lm_overview }}">
    {% if planet_style == 1 %}
      <img src="{{ theme_asset('planeten/varianten/v1_magic/' ~ image ~ '_v1_magic.webp') }}" width="40" height="40" alt="">
    {% elseif planet_style == 2 %}
      <img src="{{ theme_asset('planeten/varianten/v2_storm/' ~ image ~ '_v2_storm.webp') }}" width="40" height="40" alt="">
    {% elseif planet_style == 3 %}
      <img src="{{ theme_asset('planeten/varianten/v3_voronoi/' ~ image ~ '_v3_voronoi.webp') }}" width="40" height="40" alt="">
    {% else %}
      <img src="{{ theme_asset('planeten/' ~ image ~ '.jpg') }}" width="40" height="40" alt="">
    {% endif %}
  </a>
  <label class="visually-hidden" for="planetSelector">{{ LNG.ui_planet|default('Planet') }}</label>
  <button type="button" class="planet-switch__step" data-planet-step="-1" title="{{ LNG.ui_planet_prev }} ([)" aria-label="{{ LNG.ui_planet_prev }}">{{ icon('chevron-left') }}</button>
  <select id="planetSelector" class="planet-switch__select">
    {{ forms.html_options({'options': PlanetSelect, 'selected': current_pid}) }}
  </select>
  <button type="button" class="planet-switch__step" data-planet-step="1" title="{{ LNG.ui_planet_next }} (])" aria-label="{{ LNG.ui_planet_next }}">{{ icon('chevron-right') }}</button>
</div>

<ul class="resources" aria-label="{{ LNG.lm_resources|default('Resources') }}">
  {% for resourceID, resourceData in resourceTable %}
    {% set tipFull = resourceData.current is defined and resourceData.current is not null and resourceData.max is defined and resourceData.max is not null and resourceData.current >= resourceData.max %}
    {% set tipHtml %}{% if resourceData.current is not defined or resourceData.current is null %}<div>{{ LNG.tech[resourceID] }}</div><div class="res_current{% if resourceData.max + resourceData.used < 0 %} colorNegative{% endif %}">{{ pretty_number(resourceData.max + resourceData.used) }}</div><div class="res_max colorPositive">{{ pretty_number(resourceData.max) }}</div><div class="res_rate">{{ LNG.ui_energy_used }}: {{ pretty_number(-resourceData.used) }}</div>{% else %}<div>{{ LNG.tech[resourceID] }}</div><div class="res_current{% if tipFull %} colorNegative{% endif %}">{{ pretty_number(resourceData.current) }}</div>{% if resourceData.max is defined and resourceData.max is not null %}<div class="res_max colorPositive">{{ pretty_number(resourceData.max) }}</div>{% endif %}{% if resourceData.production is defined %}<div class="res_rate {{ resourceData.production < 0 ? 'colorNegative' : 'colorPositive' }}">{{ resourceData.production < 0 ? '' : '+' }}{{ pretty_number(resourceData.production) }}/h</div>{% if resourceData.max is defined and resourceData.max is not null and resourceData.production > 0 %}<div class="res_full">{% if tipFull %}{{ LNG.ui_storage_full }}{% else %}{{ LNG.ui_full_in }}: <span class="res_full_val"></span>{% endif %}</div>{% endif %}{% endif %}{% endif %}{% endset %}
    <li class="resource resource--{{ resourceData.name }} tooltip" data-tooltip-content="{{ tipHtml|e('html') }}"{% if resourceData.current is defined and resourceData.current is not null %} data-ticker-tip="current_{{ resourceData.name }}" data-full-text="{{ LNG.ui_storage_full }}"{% endif %}>
      <a class="resource__icon"{% if noobInterface %} href="#" data-action="dialog-info" data-id="{{ resourceID }}"{% endif %}>
        <img src="{{ theme_asset('images/' ~ resourceData.name ~ '.gif') }}" alt="" width="32" height="22">
      </a>
      <span class="resource__body">
        <span class="resource__name">{{ LNG.tech[resourceID] }}</span>
        {% if resourceData.current is not defined or resourceData.current is null %}
          {# energy: free / total #}
          {% set free = resourceData.max + resourceData.used %}
          <span class="resource__value{% if free < 0 %} colorNegative{% endif %}">{{ pretty_number(free) }}<span class="resource__max"> / {{ pretty_number(resourceData.max) }}</span></span>
        {% else %}
          {% set full = (resourceData.max is defined and resourceData.max is not null) and resourceData.current >= resourceData.max %}
          <span class="resource__value resource__value--full res_current{% if full %} colorNegative{% endif %}" id="current_{{ resourceData.name }}" data-ticker="current_{{ resourceData.name }}" data-real="{{ resourceData.current }}">{{ shortlyNumber ? shortly_number(resourceData.current) : pretty_number(resourceData.current) }}</span>
          <span class="resource__value resource__value--short res_current{% if full %} colorNegative{% endif %}" data-ticker="current_{{ resourceData.name }}">{{ shortly_number(resourceData.current, null, true) }}</span>
          {% if resourceData.max is defined and resourceData.max is not null %}
            <span class="resource__max res_max" id="max_{{ resourceData.name }}" data-real="{{ resourceData.max }}">{{ pretty_number(resourceData.max) }}</span>
            <span class="resource__max resource__max--short">/ {{ shortly_number(resourceData.max, null, true) }}</span>
            <span class="resource__bar{% if full %} is-full{% endif %}" data-ticker-bar="current_{{ resourceData.name }}" style="--fill: {{ resourceData.max > 0 ? min(100, resourceData.current / resourceData.max * 100)|round(1) : 0 }}%" aria-hidden="true"></span>
          {% endif %}
        {% endif %}
      </span>
    </li>
  {% endfor %}
</ul>

<nav class="topbar__status" aria-label="{{ LNG.lm_options|default('Account') }}">
  <span class="topbar__item topbar__universe" title="{{ uni_name }}">
    {{ icon('globe') }}<span class="topbar__label">{{ uni_name }}</span>
  </span>
  <span class="topbar__item topbar__clock" title="{{ LNG.ui_server_time|default('Server time') }}">
    {{ icon('clock') }}<span class="servertime">{{ serverClock|default('') }}</span>
  </span>
  {% if isModuleAvailable(constant('MODULE_MESSAGES')) %}
    <a class="topbar__item{% if new_message > 0 %} has-badge{% endif %}" href="{{ path('game_messages_show') }}" title="{{ LNG.ui_messages|default('Messages') }}">
      {{ icon('mail', LNG.ui_messages|default('Messages')) }}
      {% if new_message > 0 %}<span class="badge" id="newmesnum">{{ new_message }}</span>{% endif %}
    </a>
  {% endif %}
  {% if isModuleAvailable(constant('MODULE_STATISTICS')) %}
    <a class="topbar__item topbar__rank" href="{{ path('game_statistics_show') }}" title="{{ LNG.ui_points|default('Points') }}: {{ pretty_number(userPoints) }}">
      {{ icon('trophy') }}<span><span class="topbar__label">{{ LNG.ui_rank|default('Rank') }}</span> {{ userRank > 0 ? pretty_number(userRank) : '–' }}</span>
    </a>
  {% endif %}
  <div class="usermenu" data-usermenu>
    <button type="button" class="topbar__item topbar__user usermenu__button" aria-haspopup="true" aria-expanded="false" aria-controls="usermenu-panel" aria-label="{{ LNG.ui_user_menu }}" title="{{ LNG.ui_user_menu }}">
      {{ icon('user') }}<span class="topbar__label">{{ username }}</span>{{ icon('chevron-down') }}
    </button>
    <div class="usermenu__panel" id="usermenu-panel" hidden>
      <a class="usermenu__item" href="{{ path('game_settings_show') }}">{{ icon('settings') }}<span>{{ LNG.lm_options }}</span></a>
      {% if account_id != 0 %}
        <a class="usermenu__item" href="{{ path('account_account_show') }}">{{ icon('user') }}<span>{{ LNG['Account'] }}</span></a>
      {% endif %}
      {% if isModuleAvailable(constant('MODULE_NOTICE')) and (not noobInterface or not tutorial) %}
        <a class="usermenu__item" href="{{ path('game_notes_show') }}" data-action="popup" data-url="{{ path('game_notes_show') }}" data-width="720">{{ icon('sticky-note') }}<span>{{ LNG.lm_notes }}</span></a>
      {% endif %}
      <a class="usermenu__item" href="{{ path('login_data_privacy_show') }}" data-dialog data-dialog-width="820">{{ icon('shield-check') }}<span>{{ LNG.lm_dataPrivacy }}</span></a>
      {% if authlevel > 0 %}
        <a class="usermenu__item" href="./admin" title="{{ LNG.lm_administration }} ({{ version }})">{{ icon('shield-alert') }}<span>{{ LNG.lm_administration }}</span></a>
      {% endif %}
      <hr class="usermenu__sep">
      <a data-method="post" class="usermenu__item usermenu__item--logout" href="{{ path('game_logout_show') }}">{{ icon('log-out') }}<span>{{ LNG.lm_logout }}</span></a>
    </div>
  </div>
</nav>

{% if not vmode %}
{# resource counters (scripts/app/ticker.js initResourceTickers) #}
{% set tickers = [] %}
{% for resourceID, resourceData in resourceTable %}{% if resourceData.production is defined and resourceData.production is not null %}
  {% set tickers = tickers|merge([{
    available: resourceData.current,
    limit: [0, resourceData.max],
    production: resourceData.production,
    valueElem: 'current_' ~ resourceData.name
  }]) %}
{% endif %}{% endfor %}
{{ data_island('resource-tickers', {tickers: tickers}) }}
{% if hasGate %}<script type="module" src="scripts/game/gate.js?v={{ asset_version }}"></script>{% endif %}
{% endif %}
