{% extends layout_template %}
{% block title %}{{ LNG.lm_resources }}{{ parent() }}{% endblock %}
{% block content %}
	<form action="?page=resources" method="post">
		<input type="hidden" name="mode" value="send">
		<div class="table-scroll">
		<table class="prod-table">
			<tbody>
				<tr>
					<th colspan="6">{{ header }}</th>
				</tr>
				<tr>
					<td>&nbsp;</td>
					<td class="num"><a href='#' onclick='return Dialog.info(901)' class='tooltip'
							data-tooltip-content="<table><tr><th>{{ LNG.tech[901] }}</th></tr><tr><table class='hoverinfo'><tr><td><img class='inline max-w-none' src='{{ theme_asset('gebaeude/901.gif') }}'></td><td>{{ LNG.shortDescription[901] }}</td></tr></table></tr></table>">{{ LNG.tech[901] }}</a>
					</td>
					<td class="num"><a href='#' onclick='return Dialog.info(902)' class='tooltip'
							data-tooltip-content="<table><tr><th>{{ LNG.tech[902] }}</th></tr><tr><table class='hoverinfo'><tr><td><img class='inline max-w-none' src='{{ theme_asset('gebaeude/902.gif') }}'></td><td>{{ LNG.shortDescription[902] }}</td></tr></table></tr></table>">{{ LNG.tech[902] }}</a>
					</td>
					<td class="num"><a href='#' onclick='return Dialog.info(903)' class='tooltip'
							data-tooltip-content="<table><tr><th>{{ LNG.tech[903] }}</th></tr><tr><table class='hoverinfo'><tr><td><img class='inline max-w-none' src='{{ theme_asset('gebaeude/903.gif') }}'></td><td>{{ LNG.shortDescription[903] }}</td></tr></table></tr></table>">{{ LNG.tech[903] }}</a>
					</td>
					<td class="num"><a href='#' onclick='return Dialog.info(911)' class='tooltip'
							data-tooltip-content="<table><tr><th>{{ LNG.tech[911] }}</th></tr><tr><table class='hoverinfo'><tr><td><img class='inline max-w-none' src='{{ theme_asset('gebaeude/911.gif') }}'></td><td>{{ LNG.shortDescription[911] }}</td></tr></table></tr></table>">{{ LNG.tech[911] }}</a>
					</td>
					<td class="act"></td>
				</tr>
				<tr>
					<td>{{ LNG.rs_basic_income }}</td>
					<td class="num">{{ pretty_number(basicProduction[901]) }}</td>
					<td class="num">{{ pretty_number(basicProduction[902]) }}</td>
					<td class="num">{{ pretty_number(basicProduction[903]) }}</td>
					<td class="num">{{ pretty_number(basicProduction[911]) }}</td>
					<td class="act"></td>
				</tr>
				{% for productionID, productionRow in (productionList)|php_iter %}
					<tr>
						<td><a href='#' onclick='return Dialog.info({{ productionID }});' class='tooltip'
								data-tooltip-content="<table><tr><th>{{ LNG.tech[productionID] }}</th></tr><tr><table class='hoverinfo'><tr><td><img class='inline max-w-none' src='{{ theme_asset('gebaeude/' ~ productionID ~ '.' ~ ((productionID >=600 and productionID <= 699) ? 'jpg' : 'gif')) }}'></td><td>{{ LNG.shortDescription[productionID] }}</td></tr></table></tr></table>">{{ LNG.tech[productionID] }}</a>
							({% if productionID > 200 %}{{ LNG.rs_amount }}{% else %}{{ LNG.rs_lvl }}{% endif %} {{ productionRow.elementLevel }})
						</td>
						<td class="num"><span
								class="{% if productionRow.production[901] > 0 %}colorPositive{% elseif productionRow.production[901] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(productionRow.production[901]) }}</span>
						</td>
						<td class="num"><span
								class="{% if productionRow.production[902] > 0 %}colorPositive{% elseif productionRow.production[902] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(productionRow.production[902]) }}</span>
						</td>
						<td class="num"><span
								class="{% if productionRow.production[903] > 0 %}colorPositive{% elseif productionRow.production[903] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(productionRow.production[903]) }}</span>
						</td>
						<td class="num"><span
								class="{% if productionRow.production[911] > 0 %}colorPositive{% elseif productionRow.production[911] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(productionRow.production[911]) }}</span>
						</td>
						<td class="act">
							{{ html_options({'name': "prod[#{productionID}]", 'options': prodSelector[productionID], 'selected': productionRow.prodLevel}) }}
						</td>
					</tr>
				{% endfor %}
				<tr>
					<td>{{ LNG.rs_ress_bonus }}</td>
					<td class="num"><span
							class="{% if bonusProduction[901] > 0 %}colorPositive{% elseif bonusProduction[901] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(bonusProduction[901]) }}</span><br>({{ metalProcTech * 2 }}%)
					</td>
					<td class="num"><span
							class="{% if bonusProduction[902] > 0 %}colorPositive{% elseif bonusProduction[902] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(bonusProduction[902]) }}</span><br>({{ crystalProcTech * 2 }}%)
					</td>
					<td class="num"><span
							class="{% if bonusProduction[903] > 0 %}colorPositive{% elseif bonusProduction[903] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(bonusProduction[903]) }}</span><br>({{ deuteriumProcTech *2 }}%)
					</td>
					<td class="num"><span
							class="{% if bonusProduction[911] > 0 %}colorPositive{% elseif bonusProduction[911] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(bonusProduction[911]) }}</span>
					</td>
					<td class="act"><input value="{{ LNG.rs_calculate }}" type="submit"></td>
				</tr>
				{% if positionBasedRessourceBonus %}
					<tr>
						<td>{{ LNG.rs_ress_bonus_position }}</td>
						<td class="num"><span
								class="{% if bonusProductionPositionBased[901] > 0 %}colorPositive{% elseif bonusProductionPositionBased[901] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(bonusProductionPositionBased[901]) }}</span><br>({{ metalBonusPercent }}%)
						</td>
						<td class="num"><span
								class="{% if bonusProductionPositionBased[902] > 0 %}colorPositive{% elseif bonusProductionPositionBased[902] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(bonusProductionPositionBased[902]) }}</span><br>({{ crystalBonusPercent }}%)
						</td>
						<td class="num"><span
								class="{% if bonusProductionPositionBased[903] > 0 %}colorPositive{% elseif bonusProductionPositionBased[903] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(bonusProductionPositionBased[903]) }}</span><br>({{ deuteriumBonusPercent }}%)
						</td>
						<td class="num"><span
								class="{% if bonusProductionPositionBased[911] > 0 %}colorPositive{% elseif bonusProductionPositionBased[911] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(bonusProductionPositionBased[911]) }}</span>
						</td>
						<td class="act"></td>
					</tr>
				{% endif %}
				<tr>
					<td>{{ LNG.rs_storage_capacity }}</td>
					<td class="num"><span class="colorPositive">{{ storage[901] }}</span></td>
					<td class="num"><span class="colorPositive">{{ storage[902] }}</span></td>
					<td class="num"><span class="colorPositive">{{ storage[903] }}</span></td>
					<td class="num">-</td>
					<td class="act"></td>
				</tr>
				<tr>
					<td>{{ LNG.rs_sum }}:</td>
					<td class="num"><span
							class="{% if totalProduction[901] > 0 %}colorPositive{% elseif totalProduction[901] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(totalProduction[901]) }}</span>
					</td>
					<td class="num"><span
							class="{% if totalProduction[902] > 0 %}colorPositive{% elseif totalProduction[902] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(totalProduction[902]) }}</span>
					</td>
					<td class="num"><span
							class="{% if totalProduction[903] > 0 %}colorPositive{% elseif totalProduction[903] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(totalProduction[903]) }}</span>
					</td>
					<td class="num"><span
							class="{% if totalProduction[911] > 0 %}colorPositive{% elseif totalProduction[911] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(totalProduction[911]) }}</span>
					</td>
					<td class="act"></td>
				</tr>
				<tr>
					<td>{{ LNG.rs_daily }}</td>
					<td class="num"><span
							class="{% if dailyProduction[901] > 0 %}colorPositive{% elseif dailyProduction[901] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(dailyProduction[901]) }}</span>
					</td>
					<td class="num"><span
							class="{% if dailyProduction[902] > 0 %}colorPositive{% elseif dailyProduction[902] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(dailyProduction[902]) }}</span>
					</td>
					<td class="num"><span
							class="{% if dailyProduction[903] > 0 %}colorPositive{% elseif dailyProduction[903] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(dailyProduction[903]) }}</span>
					</td>
					<td class="num"><span
							class="{% if dailyProduction[911] > 0 %}colorPositive{% elseif dailyProduction[911] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(dailyProduction[911]) }}</span>
					</td>
					<td class="act"></td>
				</tr>
				<tr>
					<td>{{ LNG.rs_weekly }}</td>
					<td class="num"><span
							class="{% if weeklyProduction[901] > 0 %}colorPositive{% elseif weeklyProduction[901] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(weeklyProduction[901]) }}</span>
					</td>
					<td class="num"><span
							class="{% if weeklyProduction[902] > 0 %}colorPositive{% elseif weeklyProduction[902] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(weeklyProduction[902]) }}</span>
					</td>
					<td class="num"><span
							class="{% if weeklyProduction[903] > 0 %}colorPositive{% elseif weeklyProduction[903] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(weeklyProduction[903]) }}</span>
					</td>
					<td class="num"><span
							class="{% if weeklyProduction[911] > 0 %}colorPositive{% elseif weeklyProduction[911] < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(weeklyProduction[911]) }}</span>
					</td>
					<td class="act"></td>
				</tr>
			</tbody>
		</table>
		</div>
	</form>
{% endblock %}