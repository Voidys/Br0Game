{% extends layout_template %}
{% block title %}{{ LNG.lm_repairdock }}{{ parent() }}{% endblock %}
{% block content %}
  <p class="repair-infobox">{{ LNG.bd_repairdock_time }}: <span class="countdown" data-time="{{ wftime }}"></span></p><br><br>
  {% if repdock_level == 0 %}
    <p class="repair-infobox">{{ LNG.bd_repairdock_required }}</p><br><br>
  {% else %}
    {% if busy %}
      <p class="repair-infobox">{{ LNG.bd_repairdock_busy }}</p><br><br>
    {% endif %}
    {% if List %}
      <div class="infos1 repair-list">
        {% set ctime = 0 %}
        <div class="repairb">
          {% for shipID, amount in List.ships|default([]) %}
            {{ LNG.tech[shipID] }} {{ amount }}<br>
          {% endfor %}
          {% set ctime = List.resttime+ ctime %}
          <span id="progress">
            <br>
            <progress id="progressbar" data-time="{{ List.resttime }}" max="100" value="0"></progress>
          </span>
        </div>
        <div class="repaira">
          <div id="time" data-time="{{ List.time }}"><br></div>
          {% if umode == 0 %}
            <form action="{{ path('game_repairdock_deploy') }}" method="post" class="build_form">
              <button type="submit" class="build_submit onlist" id="deployRepaired" style="display:none">{{ LNG.bd_deploy }}</button>
            </form>
          {% else %}
            -
          {% endif %}
          <br><span class="colorPositive timer" data-time="{{ List.endtime }}" data-umode="{{ umode }}">{% if umode == 0 %}{{ List.pretty_end_time }}{% else %}{{ LNG.bd_paused }}{% endif %}</span>
        </div>
      </div><br>
    {% endif %}

    <div>
      <div class="planeto">
        <span class="segmented" role="group"><button id="ship1">{{ LNG.fm_civil }}</button><button id="ship2">{{ LNG.fm_military }}</button><button id="ship3">{{ LNG.fm_all }}</button></span>
      </div>
      <form action="{{ path('game_repairdock_start') }}" method="post">
        {% if not busy %}
          <br>
          <div class="planeto">
            <input type="button" value="{{ LNG.bd_max_ships }}" data-action="repair-all">
            <input class="b colorPositive" type="submit" value="{{ LNG.bd_repair_ships }}">
          </div>
        {% endif %}
        {% for ID, Element in elementList %}
          <div class="infos" id="s{{ ID }}">
            <div class="repairShipHeader">
              <a href="#" data-action="dialog-info" data-id="{{ ID }}">{{ LNG.tech[ID] }}</a>
              <span id="val_{{ ID }}">{% if Element.available != 0 %} ({{ LNG.bd_available }} {{ pretty_number(Element.available) }}){% endif %}</span>
            </div>
            <div class="repairShipContainer">
              <a class="repair-element-link" href="#" data-action="dialog-info" data-id="{{ ID }}">
                <img class="float-left" src="{{ theme_asset('gebaeude/' ~ ID ~ '.gif') }}" alt="{{ LNG.tech[ID] }}" width="120" height="120" loading="lazy" decoding="async">
              </a>
              <div class="repairShipContainerContent">
                <span>
                  <p>{{ LNG.bd_wreck_count }}: <span class="bold">{{ pretty_number(Element.wrecks) }}</span></p>
                  <p>{{ LNG.bd_repair_rate }}: <span class="bold">{{ pretty_number(repairRate, 1) }}%</span></p>
                  <p>{{ LNG.bd_max_ships_repair }}: <span class="bold">{{ pretty_number(Element.maxBuildable) }}</span></p>
                </span>
              </div>
              <div class="repairShipContainerContent">
                <span>
                  {% if ID==212 %} +{{ SolarEnergy }} {{ LNG.tech[911] }}<br>{% endif %}
                  {% if not busy and Element.maxBuildable > 0 %}
                    <input type="number" class="numfield" data-max="{{ Element.maxBuildable }}" name="fmenge[{{ ID }}]" id="input_{{ ID }}" value="0" tabindex="{{ null }}">
                    <input type="button" value="{{ LNG.bd_max_ships }}" data-action="fill-input" data-target="input_{{ ID }}" data-value="{{ Element.maxBuildable }}">
                    <br>
                  {% endif %}
                  {{ LNG.fgr_time }}
                  <span class="statictime" timestamp="{{ Element.elementTime }}"></span>
                </span>
              </div>
            </div>
          </div>
        {% endfor %}
        {% if not busy %}
          <br>
          <div class="planeto">
            <input type="button" value="{{ LNG.bd_max_ships }}" data-action="repair-all">
            <input class="b colorPositive" type="submit" value="{{ LNG.bd_repair_ships }}">
          </div>
        {% endif %}
      </form>
    </div>
  {% endif %}
{% endblock %}
