{% extends layout_template %}
{% block title %}{{ LNG.lm_alliance }}{{ parent() }}{% endblock %}
{% block content %}
    <form action="game?page=alliance&amp;mode=admin&amp;action=membersSave" method="post">
        <div class="table-scroll">
        <table id="memberList" data-sortable>
            <thead>
            <tr>
                <th colspan="9">{{ al_users_list }}</th>
            </tr>
            <tr>
                <th class="no-sort ctr">{{ LNG.al_num }}</th>
                <th>{{ LNG.al_member }}</th>
                <th class="ctr">{{ LNG.al_message }}</th>
                <th class="no-sort">{{ LNG.al_position }}</th>
                <th class="num">{{ LNG.al_points }}</th>
                <th class="ctr">{{ LNG.al_coords }}</th>
                <th>{{ LNG.al_member_since }}</th>
                <th class="ctr">{{ LNG.al_estate }}</th>
                <th class="no-sort ctr">{{ LNG.al_actions }}</th>
            </tr>
            </thead>
            <tbody>
            {% for userID, memberListRow in (memberList)|php_iter %}
                <tr>
                    <td class="ctr">{{ loop.index }}</td>
                    <td><a href="#" onclick="return Dialog.Playercard({{ userID }},'{{ memberListRow.username }}');">{{ memberListRow.username }}</a> {% if not empty(memberListRow.class) %}{% for class in (memberListRow.class)|php_iter %}{% if not loop.first %}&nbsp;{% endif %}<span class="galaxy-short-{{ class }} galaxy-short">{{ ShortStatus[class] }}</span>{% endfor %}{% endif %}</td>
                    <td class="ctr"><a href="#" onclick="return Dialog.PM({{ userID }});"><img class="inline" src="{{ theme_asset('img/m.gif') }}" border="0" title="{{ LNG.write_message }}"></a></td>
                    <td>{% if memberListRow.rankID == -1 %}{{ founder }}{% elseif not empty(rankSelectList) %}{{ html_options({'class': "rankSelect", 'name': "rank[#{userID}]", 'options': rankSelectList, 'selected': memberListRow.rankID}) }}{% else %}{{ rankList[memberListRow.rankID] }}{% endif %}</td>
                    <td class="num" data-sort="{{ memberListRow.points }}"><span title="{{ pretty_number(memberListRow.points) }}">{{ shortly_number(memberListRow.points) }}</span></td>
                    <td class="ctr" data-sort="{{ memberListRow.galaxy * 1000000 + memberListRow.system * 1000 + memberListRow.planet }}"><a href="game?page=galaxy&amp;galaxy={{ memberListRow.galaxy }}&amp;system={{ memberListRow.system }}">[{{ memberListRow.galaxy }}:{{ memberListRow.system }}:{{ memberListRow.planet }}]</a></td>
                    <td class="registerTime" data-sort="{{ memberListRow.register_time }}" data-time="{{ memberListRow.register_time }}">{{ memberListRow.register_time }}</td>
                    <td class="ctr">{% if rights.ONLINESTATE %}{% if memberListRow.onlinetime < 4 %}<span class="colorPositive">{{ LNG.al_memberlist_on }}</span>{% elseif memberListRow.onlinetime >= 4 and memberListRow.onlinetime <= 60 %}<span class="color-yellow">{{ memberListRow.onlinetime }} {{ LNG.al_memberlist_min }}</span>{% else %}<span class="colorNegative">{{ LNG.al_memberlist_off }}</span>{% endif %}{% else %}-{% endif %}</td>
                    <td class="act">{% if memberListRow.rankID != -1 %}
                            {% if canKick %}<a href="game?page=alliance&amp;mode=admin&amp;action=membersKick&amp;id={{ userID }}" onclick="return confirm('{{ memberListRow.kickQuestion }}');" class="member-kick"><img src="{{ theme_asset('pic/abort.gif') }}" border="0" alt=""></a>{% endif %}{% else %}-{% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
            <tr>
                <th colspan="9"><a href="game?page=alliance&amp;mode=admin">{{ LNG.al_back }}</a></th>
            </tr>
        </table>
        </div>
    </form>
{% endblock %}
{% block script %}{{ parent() }}
    <script type="module">
    import { post, serialize, NotifyBox } from './scripts/app/core.js';
    onPageInit(function() {
        document.querySelectorAll('.rankSelect').forEach(function (select) {
            select.addEventListener('change', async function () {
                NotifyBox(await post('game?page=alliance&mode=admin&action=rank&ajax=1', serialize([select]), 'json'));
            });
        });

        const months = {{ LNG.months|json_encode|raw }};
        document.querySelectorAll('.registerTime').forEach(function (el) {
            const date = new Date(el.innerHTML * 1000);
            el.innerHTML = date.getDate() + ". " + months[date.getMonth()] + " " + date.getFullYear() + " " + date.getHours() + ":" + date.getMinutes() + ":" + date.getSeconds();
        });
    });
    </script>
{% endblock %}
