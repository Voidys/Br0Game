{% extends layout_template %}
{% block title %}{{ LNG.lm_fleet }}{{ parent() }}{% endblock %}
{% block content %}
<form action="game?page=fleetStep3" method="post" onsubmit="return CheckResources()" id="form">
<input type="hidden" name="token" value="{{ token }}">
{% if Exchange %}
<input type="hidden" name="metal" value="">
<input type="hidden" name="crystal" value="">
<input type="hidden" name="deuterium" value="">
{% endif %}
   	<table>
        <tr>
        	<th colspan="2">{{ galaxy }}:{{ system }}:{{ planet }} - {{ LNG["type_planet_#{type}"] }}</th>
        </tr>
		<tr>
			<th>{{ LNG.fl_mission }}</th>
        	<th>{{ LNG.fl_resources }}</th>
        </tr>
		<tr>
			<td class="left top w-50 p-0"{% if not empty(StaySelector) %} rowspan="{% if Exchange %}6{% else %}5{% endif %}"{% endif %}>
        <table border="0" cellpadding="0" cellspacing="0" class="m-0 p-0">
          {% for MissionID in (MissionSelector)|php_iter %}
					<tr>
						<td class="transparent left">
						<input id="radio_{{ MissionID }}" type="radio" name="mission" value="{{ MissionID }}" {% if mission == MissionID or loop.length == 1 %}checked="checked"{% endif %} onchange="checkHold({{ MissionID }})" class="fleet-radio"><label for="radio_{{ MissionID }}">{{ LNG["type_mission_#{MissionID}"] }}</label><br>
							{% if MissionID == 17 %}<br><div class="fleet-alert">{{ LNG.fl_transfer_alert_message }}</div><br>{% endif %}
							{% if MissionID == 15 %}<br><div class="fleet-alert">{{ LNG.fl_expedition_alert_message }}</div><br>{% endif %}
						</td>
					</tr>
					{% endfor %}
					{% if Exchange %}
					<tr class="fleet-noreturn">
						<td class="transparent left fleet-warning">
							{{ LNG.market_info_no_return }}
						</td>
					</tr>
					{% endif %}
        </table>
      </td>
      <td class="top">
				<table border="0" cellpadding="0" cellspacing="0">
          {% if Exchange %}
          <tr id="tradeOfferRow">
            <td class="transparent">
              <select name="resOffer">
                <option value="1" selected>{{ LNG.tech[901] }}</option>
                <option value="2">{{ LNG.tech[902] }}</option>
                <option value="3">{{ LNG.tech[903] }}</option>
              </select>
            </td>
            <td class="transparent num"><span class="control-group"><a href="javascript:maxTradeOffer();">{{ LNG.fl_max }}</a> <input id="tradeOfferAmount" type="number" class="fleet-amount"></span></td>
          </tr>
          {% else %}
          <tr>
            <td class="transparent">{{ LNG.tech[901] }}</td>
            <td class="transparent num"><span class="control-group"><a href="javascript:maxResource('metal');">{{ LNG.fl_max }}</a> <input name="metal" onchange="calculateTransportCapacity();" type="number" class="fleet-amount"></span></td>
          </tr>
          <tr>
            <td class="transparent">{{ LNG.tech[902] }}</td>
            <td class="transparent num"><span class="control-group"><a href="javascript:maxResource('crystal');">{{ LNG.fl_max }}</a> <input name="crystal" onchange="calculateTransportCapacity();" type="number" class="fleet-amount"></span></td>
          </tr>
          <tr>
            <td class="transparent">{{ LNG.tech[903] }}</td>
            <td class="transparent num"><span class="control-group"><a href="javascript:maxResource('deuterium');">{{ LNG.fl_max }}</a> <input name="deuterium" onchange="calculateTransportCapacity();" type="number" class="fleet-amount"></span></td>
          </tr>
          {% endif %}
          <tr>
            <td class="transparent">{{ LNG.fl_resources_left }}</td>
            <td class="transparent num" id="remainingresources">-</td>
          </tr>
          {% if not Exchange %}
          <tr>
            <td class="transparent" colspan="2"><a href="javascript:maxResources()">{{ LNG.fl_all_resources }}</a></td>
          </tr>
          {% endif %}
          <tr id="selectedResRow">
            <td class="transparent" colspan="2"><a  id="selectedres" href="javascript:selectedResources(this)" data="{{ predefinedRes['met'] }},{{ predefinedRes['krist'] }},{{ predefinedRes['deut'] }},{{ consumption }}">{{ LNG.fl_selected_resources }}</a></td>
          </tr>
          <tr>
            <td class="transparent" colspan="2">{{ LNG.fl_fuel_consumption }}: <span id="consumption" class="consumption">{{ consumption }}</span></td>
          </tr>
          <tr>
            <td class="transparent" colspan="2">{{ LNG.fl_flying_arrival }}: <span id="arr_time" duration="{{ duration }}"></span></td>
          </tr>
				</table>
			</td>
		</tr>
		{% if Exchange %}
		<tr>
			<th colspan="2">{{ LNG.fl_exchange }}</th>
		</tr>
		<tr>
			<td colspan="2">
				<table class="form-table">
				<tr class="no-border">
					<td>{{ LNG.market_p_cost_type }}</td>
					<td>{{ LNG.market_p_cost_amount }}</td>
				</tr>
				<tr class="no-border">
					<td>
						<select name="resEx">
							<option value="1">{{ LNG.tech[901] }}</option>
							<option value="2" selected>{{ LNG.tech[902] }}</option>
							<option value="3">{{ LNG.tech[903] }}</option>
						</select>
					</td>
					<td>
						<input name="exchange" type="number" class="fleet-amount">
					</td>
				</tr>
				<tr class="no-border">
					<td>{{ LNG.market_p_ratio }}</td>
					<td id="tradeRelativeRatio">-</td>
				</tr>
			</table>
			<!--
			Max flight time (0 = unlimited):
			<input name="maxFlightTime" type="text" value="0"> hours<br/>
			-->
			</td>
		</tr>
		<tr>
			<td colspan="2">
				<table class="form-table">
				<tr class="no-border">
					<td>
						{{ LNG.fl_visibility }}
					</td>
					<td>
						<select name="visibility">
							<option value="2" selected>{{ LNG.fl_visibility_no_enemies }}</option>
							<option value="1">{{ LNG.fl_visibility_alliance }}</option>
							<option value="0">{{ LNG.fl_visibility_all }}</option>
						</select>
					</td>
				</tr>
				<tr class="no-border">
					<td>
						{{ LNG.fl_market_type }}
					</td>
					<td>
						<select name="markettype">
							{% if isModuleAvailable(php_const('MODULE_MARKET_TRADE')) and isModuleAvailable(php_const('MODULE_MARKET_TRANSFER')) %}
								<option value="0" selected>{{ LNG.fl_mt_resources }}</option>
								<option value="1">{{ LNG.fl_mt_fleet }}</option>
							{% elseif isModuleAvailable(php_const('MODULE_MARKET_TRADE')) %}
								<option value="0" selected>{{ LNG.fl_mt_resources }}</option>
							{% elseif isModuleAvailable(php_const('MODULE_MARKET_TRANSFER')) %}
								<option value="1" selected>{{ LNG.fl_mt_fleet }}</option>
							{% endif %}
						</select>
					</td>
				</tr>
				</table>
			</td>
		</tr>
		{% endif %}

		{% if not empty(StaySelector) %}
		<tr id="stay_head">
			<th>{{ LNG.fl_hold_time }}</th>
		</tr>
		<tr id="stay">
			<td>
			{{ html_options({'name': 'staytime', 'options': StaySelector}) }} {{ LNG.fl_hours }}
			</td>
		</tr>
		{% endif %}
        <tr id="submit">
			<td colspan="2" class="form-actions"><input value="{{ LNG.fl_continue }}" type="submit" onclick="return sendFleet('{{ question }}');"/></td>
        </tr>
		<tr id="wait" style="display:none;">
			<td colspan="2" class="ctr">{{ LNG.fl_continue }}</td>
		</tr>
    </table>
</form>
{% endblock %}
{% block script %}{{ parent() }}
<script type="text/javascript">
	data	= {{ fleetdata|json_encode|raw }};
	token	= '{{ token }}';
	questionList = {{ questionList|json_encode|raw }};
	tradeMarket = {{ tradeMarket|json_encode|raw }};
</script>
{% endblock %}
