{% import '_macros/forms.html.twig' as forms -%}
{% extends layout_template %}
{% block title %}{{ LNG.lm_options }}{{ parent() }}{% endblock %}
{% block content %}
	<table class="form-table">
		<tbody>
			<form action="{{ path('game_settings_send') }}" method="post">
				{% if userAuthlevel > 0 %}
					<tr>
						<th colspan="2">{{ LNG.op_admin_title_options }}</th>
					</tr>
					<tr>
						<td>{{ LNG.op_admin_planets_protection }}</td>
						<td><input name="adminprotection" type="checkbox" value="1" {% if adminProtection > 0 %}checked="checked" {% endif %}></td>
					</tr>
					<tr>
						<td>{{ LNG.op_admin_discord_id }}</td>
						<td><input name="discord_id" value="{{ discord_id }}" type="text" maxlength="25"></td>
					</tr>
					<tr>
						<td>{{ LNG.op_admin_discord_hook }}</td>
						<td><input name="discord_hook" value="{{ discord_hook }}" type="text" maxlength="150"></td>
					</tr>
				{% endif %}
				<tr>
					<th colspan="2">{{ LNG.op_user_data }}</th>
				</tr>
				<tr>
					<td>{{ LNG.op_username }}</td>
					<td>{% if changeNickTime < 0 %}<input name="username" value="{{ username }}" type="text" maxlength="32">{% else %}{{ username }}{% endif %}</td>
				</tr>
				<tr>
					<th colspan="2">{{ LNG.op_general_settings }}</th>
				</tr>
				<tr>
					<td>{{ LNG.op_timezone }}</td>
					<td>{{ forms.html_options({'name': 'timezone', 'options': Selectors.timezones, 'selected': timezone}) }}</td>
				</tr>
				{% if Selectors.lang|length > 1 %}
					<tr>
						<td>{{ LNG.op_lang }}</td>
						<td>{{ forms.html_options({'name': 'language', 'options': Selectors.lang, 'selected': userLang}) }}</td>
					</tr>
				{% endif %}
				<tr>
					<td>{{ LNG.op_decimal_separator }}</td>
					<td>{{ forms.html_options({'name': 'decimalSeparator', 'options': Selectors.decimalSeparators, 'selected': decimalSeparator}) }}</td>
				</tr>
				<tr>
					<td>{{ LNG.op_sort_planets_by }}</td>
					<td>{{ forms.html_options({'name': 'planetSort', 'options': Selectors.Sort, 'selected': planetSort}) }}</td>
				</tr>
				<tr>
					<td>{{ LNG.op_sort_kind }}</td>
					<td>
						{{ forms.html_options({'name': 'planetOrder', 'options': Selectors.SortUpDown, 'selected': planetOrder}) }}
					</td>
				</tr>
				{% if (Selectors.ImageSkins|default([]))|length > 1 %}
					<tr>
						<td>{{ LNG.op_skin_example }} (IMG)</td>
						<td>{{ forms.html_options({'options': Selectors.ImageSkins, 'selected': imageTheme, 'name': "imageTheme", 'id': "imageTheme"}) }}</td>
					</tr>
				{% endif %}
				{% if (Selectors.CssSkins|default([]))|length > 1 %}
					<tr>
						<td>{{ LNG.op_skin_example }} (CSS)</td>
						<td>{{ forms.html_options({'options': Selectors.CssSkins, 'selected': cssTheme, 'name': "cssTheme", 'id': "cssTheme"}) }}</td>
					</tr>
				{% endif %}
				<tr>
					<td>{{ LNG.op_noob_interface }}</td>
					<td><input name="noob_interface" type="checkbox" value="1" {% if noobInterface == 1 %}checked="checked"{% endif %}></td>
				</tr>
				<tr>
					<td>{{ LNG.op_enable_planet_styles }}</td>
					<td><input name="enablePlanetStyles" type="checkbox" value="1" {% if enablePlanetStyles == 1 %}checked="checked"{% endif %}></td>
				</tr>
				<tr>
					<td>{{ LNG.op_show_message_category }}</td>
					<td><input name="showMessageCategory" type="checkbox" value="1" {% if showMessageCategory == 1 %}checked="checked"{% endif %}></td>
				</tr>
				<tr>
					<td>{{ LNG.op_active_build_messages }}</td>
					<td><input name="queueMessages" type="checkbox" value="1" {% if queueMessages == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td>{{ LNG.op_active_spy_messages_mode }}</td>
					<td><input name="spyMessagesMode" type="checkbox" value="1" {% if spyMessagesMode == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td>{{ LNG.op_collapse_spy_reports }}</td>
					<td><input name="spyReportsCollapsed" type="checkbox" value="1" {% if spyReportsCollapsed == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td>{{ LNG.op_block_pm }}</td>
					<td><input name="blockPM" type="checkbox" value="1" {% if blockPM == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td>{{ LNG.recordsOptIn }}</td>
					<td><input name="recordsOptIn" type="checkbox" value="1" {% if recordsOptIn == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td>{{ LNG.colonyWarn }}</td>
					<td><input name="colonyWarn" type="checkbox" value="1" {% if colonyWarn == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td>{{ LNG.messagesPerPage }}</td>
					<td><input name="messagesPerPage" value="{{ messagesPerPage }}" type="number" min="3" max="50"></td>
				</tr>

				<tr>
					<th colspan="2">{{ LNG.op_build_pages }}</th>
				</tr>
				<tr>
					<td>{{ LNG.op_show_all_buildable_elements }}</td>
					<td><input name="show_all_buildable_elements" type="checkbox" value="1" {% if show_all_buildable_elements == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td>{{ LNG.op_missing_requirements_opacity }}</td>
					<td><input name="missing_requirements_opacity" type="checkbox" value="1" {% if missing_requirements_opacity == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td>{{ LNG.op_missing_resources_opacity }}</td>
					<td><input name="missing_resources_opacity" type="checkbox" value="1" {% if missing_resources_opacity == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td>{{ LNG.op_hide_useless }}</td>
					<td><input name="hide_useless" type="checkbox" value="1" {% if hide_useless == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td>{{ LNG.op_hangar_filters }}</td>
					<td><input name="hangarFiltersEnabled" type="checkbox" value="1" {% if hangarFiltersEnabled == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td>{{ LNG.op_hangar_group_filters }}</td>
					<td>
						<label><input name="hangarFilterCivil" type="checkbox" value="1" {% if hangarGroupCivil %}checked="checked" {% endif %}> {{ LNG.fm_civil }}</label>
						<label><input name="hangarFilterMilitary" type="checkbox" value="1" {% if hangarGroupMilitary %}checked="checked" {% endif %}> {{ LNG.fm_military }}</label>
						<label><input name="hangarFilterRecycler" type="checkbox" value="1" {% if hangarGroupRecycler %}checked="checked" {% endif %}> {{ LNG.fm_recycler }}</label>
						<label><input name="hangarFilterAll" type="checkbox" value="1" {% if hangarGroupAll %}checked="checked" {% endif %}> {{ LNG.fm_all }}</label>
					</td>
				</tr>
				
				<tr>
					<th colspan="2">{{ LNG.op_galaxy_settings }}</th>
				</tr>
				<tr>
					<td><a title="{{ LNG.op_spy_probes_number_descrip }}">{{ LNG.op_spy_probes_number }}</a></td>
					<td><input name="spycount" value="{{ spycount }}" type="number"></td>
				</tr>
				<tr>
					<td>{{ LNG.op_max_fleets_messages }}</td>
					<td><input name="fleetactions" maxlength="2" value="{{ fleetActions }}" type="number"></td>
				</tr>

				<tr>
					<th>{{ LNG.op_shortcut }}</th>
					<th>{{ LNG.op_show }}</th>
				</tr>
				<tr>
					<td><img class="inline" src="{{ theme_asset('img/e.gif') }}" alt="">{{ LNG.op_spy }}</td>
					<td><input name="galaxySpy" type="checkbox" value="1" {% if galaxySpy == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
