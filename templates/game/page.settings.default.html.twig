				</tr>
				<tr>
					<td><img class="inline" src="{{ theme_asset('img/m.gif') }}" alt="">{{ LNG.op_write_message }}</td>
					<td><input name="galaxyMessage" type="checkbox" value="1" {% if galaxyMessage == 1 %}checked="checked" {% endif %}></td>
				</tr>
