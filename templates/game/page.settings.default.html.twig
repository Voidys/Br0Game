					<td><input name="galaxySpyReport" type="checkbox" value="1" {% if galaxySpyReport == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td><a title="{{ LNG.op_spy_report_fresh_time_tooltip }}">{{ LNG.op_spy_report_fresh_time }}</a></td>
					<td><input name="spyReportFreshHours" value="{{ spyReportFreshHours }}" type="number"> {{ LNG.fl_hours }}</td>
				</tr>
				<tr>
					<td><a title="{{ LNG.op_spy_report_recent_time_tooltip }}">{{ LNG.op_spy_report_recent_time }}</a></td>
