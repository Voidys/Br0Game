				</tr>

				<tr>
					<th colspan="2" data-action="toggle-rows" data-target="custom-colors-options-3" class="clickable"><span id="custom-colors-options-3-toggle">▲</span> {{ LNG.general_colors }}</th>
				</tr>
				<tr class="hidden custom-colors-options-3">
					<td>{{ LNG.positiv }}</td>
					<td>
						<span class="control-group">
							<input type="color" name="colorPositive" value="{{ signalColors.colorPositive }}" basecolor="{{ defaultSignalColors.colorPositive }}">
							<button data-action="reset-color" type="button">{{ LNG['nt_reset'] }}</button>
						</span>
					</td>
				</tr>
				<tr class="hidden custom-colors-options-3">
					<td>{{ LNG.negativ }}</td>
					<td>
						<span class="control-group">
							<input type="color" name="colorNegative" value="{{ signalColors.colorNegative }}" basecolor="{{ defaultSignalColors.colorNegative }}">
							<button data-action="reset-color" type="button">{{ LNG['nt_reset'] }}</button>
						</span>
					</td>
				</tr>
				<tr class="hidden custom-colors-options-3">
					<td>{{ LNG.neutral }}</td>
					<td>
						<span class="control-group">
							<input type="color" name="colorNeutral" value="{{ signalColors.colorNeutral }}" basecolor="{{ defaultSignalColors.colorNeutral }}">
							<button data-action="reset-color" type="button">{{ LNG['nt_reset'] }}</button>
						</span>
					</td>
				</tr>
				<tr class="hidden custom-colors-options-3">
					<td>{{ LNG.StaticTimer }}</td>
					<td>
						<span class="control-group">
							<input type="color" name="colorStaticTimer" value="{{ colors.colorStaticTimer }}" basecolor="{{ defaultColors.colorStaticTimer }}">
							<button data-action="reset-color" type="button">{{ LNG['nt_reset'] }}</button>
						</span>
					</td>
				</tr>

				<tr>
					<th colspan="2" data-action="toggle-rows" data-target="custom-mission-prio" class="clickable"><span id="custom-mission-prio-toggle">▲</span> {{ LNG.fleetPrio }}</th>
				</tr>
				{% for ID, score in missionPrios|default([]) %}
					<tr class="hidden custom-mission-prio">
						<td>{{ LNG[ID] }}</td>
						<td><input min="0" max="99" type="number" name="{{ ID }}" value="{{ score }}"></td>
					</tr>
				{% endfor %}

				<tr>
					<th colspan="2">Scavengers Toolbox{% if game_config('userscripts_url') %} <a href="{{ game_config('userscripts_url')|e('html_attr') }}" target="_blank" rel="noopener">❓ FAQ ❓</a>{% endif %}</th>
				</tr>
				<tr>
					<td>{{ LNG.stb_activ }}</td>
					<td>
						<input name="stb_enabled" type="checkbox" value="1" {% if stb_enabled == 1 %}checked="checked" {% endif %}>
					</td>
				</tr>
				<tr>
					<td>
						<a title="{{ LNG.stb_low_ress_tooltip }}">{{ LNG.stb_low_ress }}</a>
					</td>
					<td>
						<input name="stb_small_ress" value="{{ stb_small_ress }}" type="number">
					</td>
				</tr>
				<tr>
					<td>
						<a title="{{ LNG.stb_mid_ress_tooltip }}">{{ LNG.stb_mid_ress }}</a>
					</td>
					<td>
						<input name="stb_med_ress" value="{{ stb_med_ress }}" type="number">
					</td>
				</tr>
				<tr>
					<td>
						<a title="{{ LNG.stb_big_ress_tooltip }}">{{ LNG.stb_big_ress }}</a>
					</td>
					<td>
						<input name="stb_big_ress" value="{{ stb_big_ress }}" type="number">
					</td>
				</tr>
				<tr>
					<td>
						<a title="{{ LNG.stb_small_time_tooltip }}">{{ LNG.stb_small_time }}</a>
					</td>
					<td>
						<input name="stb_small_time" value="{{ stb_small_time }}" type="number">
					</td>
				</tr>
				<tr>
					<td>
						<a title="{{ LNG.stb_med_time_tooltip }}">{{ LNG.stb_med_time }}</a>
					</td>
					<td>
						<input name="stb_med_time" value="{{ stb_med_time }}" type="number">
					</td>
				</tr>
				<tr>
					<td>
						<a title="{{ LNG.stb_big_time_tooltip }}">{{ LNG.stb_big_time }}</a>
					</td>
					<td>
						<input name="stb_big_time" value="{{ stb_big_time }}" type="number">
					</td>
				</tr>
				<tr>
					<td colspan="2" class="form-actions"><input value="{{ LNG.op_save_changes }}" type="submit"></td>
				</tr>
			</form>

			<tr>
				<th colspan="2">{{ LNG.op_vacation_delete_mode }}</th>
			</tr>
			<tr>
				<td class="ctr">
					<form action="{{ path('game_settings_toggle_vacation') }}" method="post">
						<input name="vacation" type="submit" value="{{ LNG.op_activate_vacation_mode }}" data-confirm="{{ LNG.op_activate_vacation_mode_confirm|e('html_attr') }}"> <img src="./styles/resource/images/admin/i.webp" width="16" height="16" alt="" class="inline tooltip" data-tooltip-content="{{ LNG.op_activate_vacation_mode_descrip }}">
					</form>
				</td>
				<td class="ctr">
					<form action="{{ path('game_settings_toggle_delete') }}" method="post">
						<input name="delete" type="submit" value="{% if delete %}{{ LNG.op_stop_dlte_account }}{% else %}{{ LNG.op_dlte_account }}{% endif %}"> <img src="./styles/resource/images/admin/i.webp" width="16" height="16" alt="" class="inline tooltip" data-tooltip-content="{{ LNG.op_dlte_account_descrip }}">
					</form>
				</td>
			</tr>
		</tbody>
	</table>
{% endblock %}
{% block script %}{{ parent() }}
<script type="module" src="./scripts/game/settings.js?v={{ asset_version }}"></script>
{% endblock %}
