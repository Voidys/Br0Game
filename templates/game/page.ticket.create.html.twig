{% extends layout_template %}
{% block title %}{{ LNG.ti_create_head }} - {{ LNG.lm_support }}{{ parent() }}{% endblock %}
{% block content %}
<form action="game?page=ticket&mode=send" method="post" id="form">
<input type="hidden" name="id" value="0">
<table class="form-table">
	<tr>
		<th colspan="2">{{ LNG.ti_create_head }}</th>
	</tr>
	<tr>
		<td colspan="2" class="left">{{ LNG.ti_create_info }}</td>
	</tr>
	<tr>
		<td><label for="category">{{ LNG.ti_category }}</label></td>
		<td><select id="category" name="category">{{ html_options({'options': categoryList}) }}</select></td>
	</tr>
	<tr>
		<td><label for="subject">{{ LNG.ti_subject }}</label></td>
		<td><input type="text" required id="subject" name="subject" maxlength="255"></td>
	</tr>
	<tr>
		<td><label for="message">{{ LNG.ti_message }}</label></td>
		<td><textarea required id="message" name="message" class="ticket-message"></textarea></td>
	</tr>
	<tr>
		<td colspan="2" class="form-actions"><input type="submit" value="{{ LNG.ti_submit }}"></td>
	</tr>
</table>
</form>
{% endblock %}
