{% extends layout_template %}
{% block title %}{{ LNG.lm_alliance }}{{ parent() }}{% endblock %}
{% block content %}
<form action="game?page=alliance&amp;mode=create&amp;action=send" method="POST">
	<table class="form-table">
		<tr>
			<th colspan="2">{{ LNG.al_make_alliance }}</th>
		</tr>
		<tr>
			<td>{{ LNG.al_make_ally_tag_required }}</td>
			<td><input type="text" name="atag" maxlength="8" value=""></td>
		</tr>
		<tr>
			<td>{{ LNG.al_make_ally_name_required }}</td>
			<td><input type="text" name="aname" maxlength="30" value=""></td>
		</tr>
		<tr>
			<td colspan="2" class="form-actions"><input type="submit" value="{{ LNG.al_make_submit }}"></td>
		</tr>
	</table>
</form>
{% endblock %}