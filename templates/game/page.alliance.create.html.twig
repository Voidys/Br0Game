{% extends layout_template %}
{% block title %}{{ LNG.lm_alliance }}{{ parent() }}{% endblock %}
{% block content %}
<form action="{{ path('game_alliance_create_send') }}" method="POST">
	<table class="form-table">
		<tr>
			<th colspan="2">{{ LNG.al_make_alliance }}</th>
		</tr>
		<tr>
			<td><label for="atag">{{ LNG.al_make_ally_tag_required }}</label></td>
			<td><input type="text" name="atag" id="atag" maxlength="8" value="" required></td>
		</tr>
		<tr>
			<td><label for="aname">{{ LNG.al_make_ally_name_required }}</label></td>
			<td><input type="text" name="aname" id="aname" maxlength="30" value="" required></td>
		</tr>
		<tr>
			<td colspan="2" class="form-actions"><input type="submit" value="{{ LNG.al_make_submit }}"></td>
		</tr>
	</table>
</form>
{% endblock %}