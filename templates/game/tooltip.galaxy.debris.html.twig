<table class='tt-galaxy'>
    <tr>
        <th colspan='2'>{{ LNG.gl_debris_field }} [{{ galaxy }}:{{ system }}:{{ planet.planet_position }}]</th>
    </tr>
    <tr>
        <td class='tt-galaxy-icon'><img src='{{ theme_asset('planeten/debris.jpg') }}' height='75'></td>
        <td>
            <table class='w-100'>
                <tr>
                    <th colspan='2'>{{ LNG.gl_resources }}:</th>
                </tr>
                <tr>
                    <td>{{ LNG.tech[901] }}: </td>
                    <td>{{ pretty_number(debris.metal) }}</td>
                </tr>
                <tr>
                    <td>{{ LNG.tech[902] }}: </td>
                    <td>{{ pretty_number(debris.crystal) }}</td>
                </tr>
                {% if missions[8] and recyclers > 0 %}
                    <tr>
                        <th colspan='2'>{{ LNG.gl_actions }}</th>
                    </tr>
                    <tr>
                        <td colspan='2'><a href='#' data-action='galaxy-mission' data-mission='8' data-planet='{{ id }}'>{{ LNG["type_mission_8"] }}</a></td>
                    </tr>
                {% endif %}
                {% if missions[22] and recyclers > 0 %}
                    <tr>
                        <th colspan='2'>{{ LNG.gl_actions }}</th>
                    </tr>
                    <tr>
                        <td colspan='2'><a href='#' data-action='galaxy-mission' data-mission='22' data-planet='{{ id }}'>{{ LNG["type_mission_22"] }}</a></td>
                    </tr>
                {% endif %}
            </table>
        </td>
    </tr>
</table>