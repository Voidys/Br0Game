{% extends layout_template %}
{% block title %}{{ LNG.lm_alliance }}{{ parent() }}{% endblock %}
{% block content %}
<table class="form-table">
<tr>
	<th colspan="3">{{ LNG.al_ally_information }}</th>
</tr>
{% if ally_image %}
<tr>
	<td colspan="3">
		<img class="alliance-image" src="{{ ally_image }}" alt="{{ ally_tag }}">
	</td>
</tr>
{% endif %}
<tr>
	<td colspan="2">{{ LNG.al_ally_info_tag }}</td>
	<td>{{ ally_tag }}</td>
</tr>
<tr>
	<td colspan="2">{{ LNG.al_ally_info_name }}</td>
	<td>{{ ally_name }}</td>
</tr>
<tr>
	<td colspan="2">{{ LNG.al_ally_info_members }}</td>
	<td>{{ ally_member_scount }} / {{ ally_max_members }}</td>
</tr>
{% if ally_request %}
<tr>
	<td colspan="2">{{ LNG.al_request }}</td>
	{% if ally_request_min_points %}
	<td><a href="game?page=alliance&amp;mode=apply&amp;id={{ ally_id }}">{{ LNG.al_click_to_send_request }}</a></td>
	{% else %}
		<td>{{ ally_request_min_points_info }}</td>
	{% endif %}
</tr>
{% endif %}
<tr>
	<td colspan="3" class="ally-description">{% if not empty(ally_description) %}{{ ally_description }}{% else %}{{ LNG.al_description_message }}{% endif %}</td>
</tr>
{% if ally_web %}
<tr>
	<td colspan="2">{{ LNG.al_web_text }}</td>
	<td><a href="{{ ally_web }}">{{ ally_web }}</a></td>
</tr>
{% endif %}
{% if diplomaticData %}
<tr>
	<th colspan="3">{{ LNG.al_diplo }}</th>
</tr>
<tr>
	<td colspan="3">
	{% if diplomats %}
		<b><u>{{ LNG.al_rank_diplo }}</u></b><br><br>
		{% for diplomat in diplomats %}{{ diplomat.username }} - {{ diplomat.rankName }} <a href="#" data-action="dialog-pm" data-id="{{ diplomat.id }}"><img src="{{ theme_asset('img/m.gif') }}" title="{{ LNG.write_message }}" alt=""></a><br>{% endfor %}
		<br>
	{% endif %}
	{% if diplomaticData and (not empty(diplomaticData[0]) or not empty(diplomaticData[1]) or not empty(diplomaticData[2]) or not empty(diplomaticData[3]) or not empty(diplomaticData[4])) %}
		{% if not empty(diplomaticData[0]) %}<b><u>{{ LNG.al_diplo_level[0] }}</u></b><br><br>{% for PaktInfo in diplomaticData[0] %}<a href="?page=alliance&mode=info&amp;id={{ PaktInfo[1] }}">{{ PaktInfo[0] }}</a><br>{% endfor %}<br>{% endif %}
		{% if not empty(diplomaticData[1]) %}<b><u>{{ LNG.al_diplo_level[1] }}</u></b><br><br>{% for PaktInfo in diplomaticData[1] %}<a href="?page=alliance&mode=info&amp;id={{ PaktInfo[1] }}">{{ PaktInfo[0] }}</a><br>{% endfor %}<br>{% endif %}
		{% if not empty(diplomaticData[2]) %}<b><u>{{ LNG.al_diplo_level[2] }}</u></b><br><br>{% for PaktInfo in diplomaticData[2] %}<a href="?page=alliance&mode=info&amp;id={{ PaktInfo[1] }}">{{ PaktInfo[0] }}</a><br>{% endfor %}<br>{% endif %}
		{% if not empty(diplomaticData[3]) %}<b><u>{{ LNG.al_diplo_level[3] }}</u></b><br><br>{% for PaktInfo in diplomaticData[3] %}<a href="?page=alliance&mode=info&amp;id={{ PaktInfo[1] }}">{{ PaktInfo[0] }}</a><br>{% endfor %}<br>{% endif %}
		{% if not empty(diplomaticData[4]) %}<b><u>{{ LNG.al_diplo_level[4] }}</u></b><br><br>{% for PaktInfo in diplomaticData[4] %}<a href="?page=alliance&mode=info&amp;id={{ PaktInfo[1] }}">{{ PaktInfo[0] }}</a><br>{% endfor %}<br>{% endif %}
	{% else %}
		{{ LNG.al_no_diplo }}
	{% endif %}
	</td>
</tr>
{% endif %}
{% if not empty(statisticData) and show %}
<tr>
	<th colspan="3">{{ LNG.pl_fightstats }}</th>
</tr>
<tr>
	<td colspan="2">{% if not show %}<div class="tooltip1"><img src="./styles/resource/images/icons/lock.webp" height="10" width="10"><span class="tooltiptext">{{ LNG.spytech_playercard.level6 }}</span></div> {% endif %}{{ LNG.pl_totalfight }}</td>
	<td class="num">{% if show %}{{ pretty_number(totalfight) }}{% else %}-{% endif %}</td>
</tr>
<tr>
	<td colspan="2">{% if not show %}<div class="tooltip1"><img src="./styles/resource/images/icons/lock.webp" height="10" width="10"><span class="tooltiptext">{{ LNG.spytech_playercard.level6 }}</span></div> {% endif %}{{ LNG.pl_fightwon }}</td>
	<td class="num">{% if show %}{{ pretty_number(fightwon) }} {% if totalfight %}({{ round(fightwon / totalfight * 100, 2) }}%){% endif %}{% else %}-{% endif %}</td>
</tr>
<tr>	
	<td colspan="2">{% if not show %}<div class="tooltip1"><img src="./styles/resource/images/icons/lock.webp" height="10" width="10"><span class="tooltiptext">{{ LNG.spytech_playercard.level6 }}</span></div> {% endif %}{{ LNG.pl_fightlose }}</td>
	<td class="num">{% if show %}{{ pretty_number(fightlose) }} {% if totalfight %}({{ round(fightlose / totalfight * 100, 2) }}%){% endif %}{% else %}-{% endif %}</td>
</tr>
<tr>
	<td colspan="2">{% if not show %}<div class="tooltip1"><img src="./styles/resource/images/icons/lock.webp" height="10" width="10"><span class="tooltiptext">{{ LNG.spytech_playercard.level6 }}</span></div> {% endif %}{{ LNG.pl_fightdraw }}</td>
	<td class="num">{% if show %}{{ pretty_number(fightdraw) }} {% if totalfight %}({{ round(fightdraw / totalfight * 100, 2) }}%){% endif %}{% else %}-{% endif %}</td>
</tr>
<tr>
	<td colspan="2">{% if not show %}<div class="tooltip1"><img src="./styles/resource/images/icons/lock.webp" height="10" width="10"><span class="tooltiptext">{{ LNG.spytech_playercard.level6 }}</span></div> {% endif %}{{ LNG.pl_unitsshot }}</td>
	<td class="num">{% if show %}{{ unitsshot }}{% else %}-{% endif %}</td>
</tr>
<tr>
	<td colspan="2">{% if not show %}<div class="tooltip1"><img src="./styles/resource/images/icons/lock.webp" height="10" width="10"><span class="tooltiptext">{{ LNG.spytech_playercard.level6 }}</span></div> {% endif %}{{ LNG.pl_unitslose }}</td>
	<td class="num">{% if show %}{{ unitslose }}{% else %}-{% endif %}</td>
</tr>
<tr>
	<td colspan="2">{% if not show %}<div class="tooltip1"><img src="./styles/resource/images/icons/lock.webp" height="10" width="10"><span class="tooltiptext">{{ LNG.spytech_playercard.level6 }}</span></div> {% endif %}{{ LNG.pl_dermetal }}</td>
	<td class="num">{% if show %}{{ dermetal }}{% else %}-{% endif %}</td>
</tr>
<tr>
	<td colspan="2">{% if not show %}<div class="tooltip1"><img src="./styles/resource/images/icons/lock.webp" height="10" width="10"><span class="tooltiptext">{{ LNG.spytech_playercard.level6 }}</span></div> {% endif %}{{ LNG.pl_dercrystal }}</td>
	<td class="num">{% if show %}{{ dercrystal }}{% else %}-{% endif %}</td>
</tr>
{% endif %}
</table>
{% include 'game/shared.alliance.chart.html.twig' %}
{% endblock %}
