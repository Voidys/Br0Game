{% extends layout_template %}
{% block title %}{{ LNG.write_message }}{{ parent() }}{% endblock %}
{% block content %}
  <form name="message" id="message" action="">
    <table class="form-table">
      <tr>
        <th colspan="2">{{ LNG.mg_send_new }}</th>
      </tr>
      <tr>
        <td><label for="to">{{ LNG.mg_send_to }}</label></td>
        <td>
          <div class="search-receiver">
            <input type="text" id="to" name="to" value="" data-on-input="msg-load-user" data-on-blur="msg-hide-search" data-on-focus="msg-show-search" autocomplete="off" placeholder="{{ LNG.mg_search_player }}">
            <div class="select-box"></div>
          </div>
          <div id="receiver-list">
            {% for receiver in receiverList %}
              <div class="receiver" id="receiver-{{ receiver.id }}">{{ receiver.username }} <button type="button" class="receiver__remove" data-action="msg-remove-user" data-id="{{ receiver.id }}" title="{{ LNG.mg_remove_receiver }}" aria-label="{{ LNG.mg_remove_receiver }}: {{ receiver.username }}">{{ icon('x') }}</button></div>
            {% endfor %}
          </div>
        </td>
      </tr>
      {% if action == 'write' %}
        <tr>
          <td><label for="subject">{{ LNG.mg_subject }}</label></td>
          <td><input type="text" name="subject" id="subject" maxlength="40" value="{% if subject %}{{ subject }}{% else %}{{ LNG.mg_no_subject }}{% endif %}"></td>
        </tr>
        <tr>
          <td colspan="2">
            <label for="text">
              {{ LNG.mg_message }} (<span id="cntChars">0</span>&nbsp;/&nbsp;5.000&nbsp;{{ LNG.mg_characters }})
            </label>
          </td>
        </tr>
        <tr>
          <td colspan="2">
            <textarea name="text" id="text" cols="40" rows="10" data-on-keyup="char-count" data-target="cntChars">{{ message }}</textarea>
          </td>
        </tr>
      {% endif %}
      <tr>
        <td colspan="2" class="form-actions">
          <input id="submit" type="button" data-action="{% if action == 'write' %}msg-send{% else %}msg-forward{% endif %}" name="button" value="{{ LNG.mg_send }}">
        </td>
      </tr>
    </table>
  </form>
{% endblock %}
{% block script %}{{ parent() }}
  {{ data_island('message-write-data', {
    action: action,
    sendUrl: path('game_messages_send'),
    forwardUrl: path('game_messages_send_forward'),
    usersUrl: path('game_messages_load_user'),
    searchNote: LNG.mg_min_3_chars,
    searchNoUser: LNG.mg_no_user,
    emptyText: LNG.mg_empty_text,
    noReceiver: LNG.mg_no_receiver,
    removeReceiver: LNG.mg_remove_receiver,
    messageGroup: messageGroup|default(''),
    messageID: messageID|default(0),
    receiverList: receiverList|default({})
  }) }}
{% endblock %}
