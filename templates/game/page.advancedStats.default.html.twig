{% extends layout_template %}
{% block title %}{{ LNG.advancedStats }}{{ parent() }}{% endblock %}
{% block content %}
{% set groups = [
  {key: 'expo', label: LNG.expedition, rows: expo},
  {key: 'build', label: LNG.build, rows: build},
  {key: 'lost', label: LNG.lost, rows: lost},
  {key: 'destroyed', label: LNG.destroyed, rows: destroyed},
  {key: 'repaired', label: LNG.repaired, rows: repaired},
  {key: 'first', label: LNG.first, rows: first},
  {key: 'other', label: LNG.other, rows: rest},
] %}
<div class="tabs advanced-stats" data-tabs="advanced-stats">
  <div class="tabs__list" role="tablist" aria-label="{{ LNG.advancedStats }}">
    {% for group in groups %}
      <button type="button" class="tabs__tab" role="tab" id="as-tab-{{ group.key }}" data-tab="{{ group.key }}" aria-controls="as-panel-{{ group.key }}" aria-selected="{{ loop.first ? 'true' : 'false' }}" tabindex="{{ loop.first ? '0' : '-1' }}">{{ group.label }}</button>
    {% endfor %}
  </div>
  {% for group in groups %}
    <section class="tabs__panel" role="tabpanel" id="as-panel-{{ group.key }}" aria-labelledby="as-tab-{{ group.key }}" data-tab="{{ group.key }}" tabindex="0"{% if not loop.first %} hidden{% endif %}>
      <table class="advanced-stats__table">
        <tbody>
          {% for elementID, elementRow in group.rows %}
            <tr id="{{ elementID }}">
              <td>{{ elementRow.text }}</td>
              <td class="num">{{ elementRow.value }}</td>
            </tr>
          {% else %}
            <tr><td colspan="2" class="empty">-</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </section>
  {% endfor %}
</div>
<script type="module" src="./scripts/app/tabs.js?v={{ asset_version }}"></script>
{% endblock %}
