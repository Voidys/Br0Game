{# Document shell of the game area: head (styles, globals, modules) and the body block the layouts fill. #}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <title>{% block title %} - {{ uni_name }} - {{ game_name }}{% endblock %}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {# versions all ES modules by mtime (imported modules carry no ?v=): App\\Twig\\GameExtension::importMap #}
  {{ import_map() }}
  <meta name="theme-color" content="#05080d">
  {% if not empty(goto) %}
    <meta http-equiv="refresh" content="{{ gotoinsec }};URL={{ goto }}">
  {% endif %}
  <link rel="shortcut icon" href="./favicon.ico" type="image/x-icon">

  {# cascade layers: reset, base, legacy (theme + content), components; game.css (shell) stays unlayered #}
  <link rel="stylesheet" href="./styles/resource/css/app/base.css?v={{ asset_version }}">
  <link rel="stylesheet" href="./styles/resource/css/app/rte.css?v={{ asset_version }}">
  {# tables and forms of the content area: layout for every theme (layer "components", see the file header) #}
  <link rel="stylesheet" href="./styles/resource/css/app/tables-forms.css?v={{ asset_version }}">
  {# the content components and the player's classic theme share the "legacy" cascade layer, theme
     last as in the original header (it wins ties); base < legacy < components < game.css #}
  <style>
    @import url("./styles/resource/css/app/content.css?v={{ asset_version }}") layer(legacy);
    @import url("{{ themeCssPath }}?v={{ asset_version }}") layer(legacy);
  </style>
  <link rel="stylesheet" href="./styles/resource/css/app/game.css?v={{ asset_version }}">
  {# the player's signal colours (settings) win over theme and base styles #}
  <style>
    .colorPositive { color: {{ signalColors.colorPositive|default('#3fbf6f') }}; }
    .colorNegative { color: {{ signalColors.colorNegative|default('#f05252') }} !important; }
    .colorNeutral { color: {{ signalColors.colorNeutral|default('#f0b429') }}; }
  </style>

  <script>
    var ServerTimezoneOffset = {{ Offset|default(0) }};
    var serverTimeDelta = new Date({{ date[0] }}, {{ date[1] - 1 }}, {{ date[2] }}, {{ date[3] }}, {{ date[4] }}, {{ date[5] }}).getTime() - Date.now();
    Object.defineProperty(window, 'serverTime', { get: function () { return new Date(Date.now() + serverTimeDelta); } });
    var startTime = serverTime.getTime();
    var Gamename = document.title;
    var Ready = "{{ LNG.ready }}";
    var Skin = "{{ dpath }}";
    var Lang = "{{ lang }}";
    var head_info = "{{ LNG.fcm_info }}";
    var auth = {{ authlevel|default('0') }};
    var days = {{ LNG.week_day|json_encode|default('[]')|raw }};
    var months = {{ LNG.months|json_encode|default('[]')|raw }};
    var localtimezonestring = "{{ TIMEZONESTRING }}";
    var tdformat = "{{ LNG.js_tdformat }}";
    var queryString = "{{ queryString|e('js') }}";
    var isPlayerCardActive = {{ isPlayerCardActive|json_encode|raw }};
    var decimalSeparator = {{ decimalSeparator|json_encode|raw }};
    var userLang = {{ lang|json_encode|raw }};
    var numberSuffixes = {{ numberSuffixes|json_encode|raw }};
    {# page init queue until the modules are loaded (see scripts/app/main.js) #}
    window.__pageInit = [];
    window.onPageInit = function (fn) { window.__pageInit.push(fn); };
  </script>

  <script type="module" src="./scripts/app/main.js?v={{ asset_version }}"></script>
  {# page scripts are ES modules; vendor libraries (../base/...) stay classic, deferred keeps the order #}
  {% for scriptname in (scripts)|php_iter %}
    {% if scriptname starts with '../' %}
      <script defer src="./scripts/game/{{ scriptname }}?v={{ asset_version }}"></script>
    {% else %}
      <script type="module" src="./scripts/game/{{ scriptname }}?v={{ asset_version }}"></script>
    {% endif %}
  {% endfor %}

  {% if captchakey != "" %}
    <script>
      {# reCAPTCHA loads on the first form submit, so idle pages don't pay for it #}
      document.addEventListener('submit', function (event) {
        var form = event.target;
        if (form.dataset.captchaDone) return;
        event.preventDefault();
        var key = "{{ captchakey }}";
        var load = window.__recaptcha || (window.__recaptcha = new Promise(function (resolve, reject) {
          var s = document.createElement('script');
          s.src = 'https://www.google.com/recaptcha/api.js?render=' + key;
          s.onload = function () { grecaptcha.ready(resolve); };
          s.onerror = reject;
          document.head.appendChild(s);
        }));
        load.then(function () { return grecaptcha.execute(key); }).then(function (token) {
          var input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'rcaptcha';
          input.value = token;
          form.prepend(input);
          form.dataset.captchaDone = '1';
          form.submit();
        }).catch(function () { alert('Captcha could not be loaded. Please try again.'); });
      });
    </script>
    <style>.grecaptcha-badge { visibility: hidden; }</style>
  {% endif %}

  {% block script %}{% endblock %}

  {% if execscript %}
    <script>onPageInit(function () { {{ execscript|raw }} });</script>
  {% endif %}
</head>

<body id="{{ app.request.query.get('page')|default('overview') }}" class="{% block bodyclass %}{% endblock %}">
{% block body %}{% endblock %}
</body>
</html>
