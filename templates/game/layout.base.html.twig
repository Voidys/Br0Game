{# Document shell of the game area: head (styles, globals, modules) and the body block the layouts fill. #}
<!DOCTYPE html>
<html lang="{{ lang }}" data-dialog-ok="{{ LNG.dialog_ok }}" data-dialog-cancel="{{ LNG.dialog_cancel }}">
<head>
  <meta charset="utf-8">
  {# pages live at /game/<page>: relative URLs (assets, ./, game/...) keep resolving against the universe directory #}
  <base href="{{ basepath }}{{ app.request.attributes.get('uni') }}">
  {{ csrf_meta() }}
  <title>{% block title %} - {{ uni_name }} - {{ game_name }}{% endblock %}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {# versions all ES modules by mtime (imported modules carry no ?v=): App\\Twig\\GameExtension::importMap #}
  {{ import_map() }}
  <meta name="theme-color" content="#05080d">
  {% if goto %}
    <meta http-equiv="refresh" content="{{ gotoinsec }};URL={{ goto }}">
  {% endif %}
  <link rel="shortcut icon" href="./favicon.ico" type="image/x-icon">
  {# the wordmark font is used by every page (top bar): fetch it with the CSS instead of after the first layout #}
  <link rel="preload" href="./styles/resource/fonts/michroma/michroma-eu.woff2" as="font" type="font/woff2" crossorigin>

  {# cascade layers: reset, base, legacy.content, legacy.theme, components; game.css (shell) stays unlayered #}
  <link rel="stylesheet" href="./styles/resource/css/app/base.css?v={{ asset_version }}">
  <link rel="stylesheet" href="./styles/resource/css/app/rte.css?v={{ asset_version }}">
  {# tables and forms of the content area: layout for every theme (layer "components", see the file header) #}
  <link rel="stylesheet" href="./styles/resource/css/app/tables-forms.css?v={{ asset_version }}">
  {# app-owned content components (forms, tables, controls) that no theme styles: also layer "components", after tables-forms #}
  <link rel="stylesheet" href="./styles/resource/css/app/components.css?v={{ asset_version }}">
  {# content components and the player's classic theme: sub-layers of "legacy", theme last (it overrides
     content.css); base < legacy.content < legacy.theme < components < game.css #}
  <style>
    @import url("./styles/resource/css/app/content.css?v={{ asset_version }}") layer(legacy.content);
    @import url("{{ themeCssPath }}?v={{ asset_version }}") layer(legacy.theme);
  </style>
  <link rel="stylesheet" href="./styles/resource/css/app/game.css?v={{ asset_version }}">
  {# the player's signal colours win over theme and base styles. A colour still at its factory default is not
     emitted as a custom property: the theme may set --signal-* itself (fallbacks = the factory values) #}
  {% set sigPos = signalColors.colorPositive|default('') %}
  {% set sigNeg = signalColors.colorNegative|default('') %}
  {% set sigNeu = signalColors.colorNeutral|default('') %}
  <style>
    {% if sigPos and sigPos|lower != '#00ff00' or sigNeg and sigNeg|lower != '#ff0000' or sigNeu and sigNeu|lower != '#ffd600' %}:root {
      {% if sigPos and sigPos|lower != '#00ff00' %}--signal-positive: {{ sigPos }};{% endif %}
      {% if sigNeg and sigNeg|lower != '#ff0000' %}--signal-negative: {{ sigNeg }};{% endif %}
      {% if sigNeu and sigNeu|lower != '#ffd600' %}--signal-neutral: {{ sigNeu }};{% endif %}
    }{% endif %}
    .colorPositive { color: var(--signal-positive-local, var(--signal-positive, {{ sigPos|default('#3fbf6f') }})); }
    .colorNegative { color: var(--signal-negative-local, var(--signal-negative, {{ sigNeg|default('#f05252') }})) !important; }
    .colorNeutral { color: var(--signal-neutral-local, var(--signal-neutral, {{ sigNeu|default('#f0b429') }})); }
  </style>

  {# server clock, language strings and flags for scripts/app/env.js (JSON, not executed: no inline script) #}
  {{ data_island('game-env', {
    offset: Offset|default(0),
    date: date,
    ready: LNG.ready,
    skin: dpath,
    lang: lang,
    headInfo: LNG.fcm_info,
    auth: authlevel|default(0),
    days: LNG.week_day|default([]),
    months: LNG.months|default([]),
    timezone: TIMEZONESTRING,
    serverTimezone: game_config('timezone'),
    tdformat: LNG.js_tdformat,
    urls: {
      information: path('game_information_show', {id: 0}),
      planetActions: path('game_overview_actions'),
    },
    isPlayerCardActive: isPlayerCardActive,
    decimalSeparator: decimalSeparator,
    numberSuffixes: numberSuffixes,
    viewShortlyNumber: shortlyNumber,
    vacation: vmode,
    debug: debug == 1
  }) }}

  {# URLs the shared scripts (app/dialog.js, app/ui.js) open or post to: routes rendered here instead of built in JS #}
  {{ data_island('game-routes', {
    messageWrite: path('game_messages_write'),
    messageForward: path('game_messages_forward'),
    playerCard: path('game_player_card_show'),
    buddyRequest: path('game_buddy_list_request'),
    clientReport: path('game_report_show')
  }) }}

  <script type="module" src="./scripts/app/main.js?v={{ asset_version }}"></script>
  {# page scripts are ES modules; vendor libraries (../base/...) stay classic, deferred keeps the order #}
  {% for scriptname in scripts %}
    {% if scriptname starts with '../' %}
      <script defer src="./scripts/game/{{ scriptname }}?v={{ asset_version }}"></script>
    {% else %}
      <script type="module" src="./scripts/game/{{ scriptname }}?v={{ asset_version }}"></script>
    {% endif %}
  {% endfor %}

  {% block script %}{% endblock %}
</head>

<body id="{{ app.request.attributes.get('_page')|default(app.request.query.get('page'))|default('overview') }}" class="{% block bodyclass %}{% endblock %}">
{% block body %}{% endblock %}
</body>
</html>
