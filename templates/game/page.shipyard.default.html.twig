{% extends layout_template %}
{% block title %}{% if mode == "defense" %}{{ LNG.lm_defenses }}{% else %}{{ LNG.lm_shipshard }}{% endif %}{{ parent() }}{% endblock %}
{% block content %}

	{% if not NotBuilding %}
		<table id="infobox" class="repair-infobox">
			<tr><td>{{ LNG.bd_building_shipyard }}</td></tr>
		</table><br><br>
	{% endif %}

	{% if not empty(BuildList) %}
		{% if umode == 0 %}
			<div class="text-center">
				<div id="bx" class="z"></div>
				<div class="ship">
					<form action="game?page=shipyard&amp;mode={{ mode }}" method="post" >
						<input type="hidden" name="action" value="delete">
						<div >
							<select name="auftr[]" id="auftr" onchange="this.form.myText.setAttribute('size', this.value);" multiple class="shipl"><option>&nbsp;</option></select><br><br>{{ LNG.bd_cancel_warning }}<br><input class="z" type="submit" value="{{ LNG.bd_cancel_send }}" />
						</div>
					</form>
					<br><span id="timeleft" data-umode="{{ umode }}"></span><br><br>
				</div>
			</div><br>
		{% else %}
			<div class="text-center">
				<div id="bxumode" class="zumode"></div>
				<div class="shipumode">
					<form action="game?page=shipyard&amp;mode={{ mode }}" method="post" >
						<input type="hidden" name="action" value="delete">
						<div >
							<select name="auftrumode[]" id="auftrumode" onchange="this.form.myText.setAttribute('size', this.value);" multiple class="shipl"><option>&nbsp;</option></select><br><br><br><input class="z" value="{{ LNG['bd_paused'] }}" />
						</div>
					</form>
					<br><span id="timeleft" data-umode="{{ umode }}"></span><br><br>
				</div>
			</div><br>
		{% endif %}
	{% endif %}

	{% if mode == "fleet" %}
		{% if hangarFiltersEnabled %}
		<div class="planeto" id="hangar-filters">
			{% set hangarHasButton = false %}
			{% if hangarGroupCivil %}{% if hangarHasButton %}<span class="hangar-filter-sep"> | </span>{% endif %}<button type="button" class="hangar-group-filter" id="ship1" data-filter-selector="{{ civil }}">{{ LNG.fm_civil }}</button>{% set hangarHasButton = true %}{% endif %}
			{% if hangarGroupMilitary %}{% if hangarHasButton %}<span class="hangar-filter-sep"> | </span>{% endif %}<button type="button" class="hangar-group-filter" id="ship2" data-filter-selector="{{ military }}">{{ LNG.fm_military }}</button>{% set hangarHasButton = true %}{% endif %}
			{% if hangarGroupRecycler %}{% if hangarHasButton %}<span class="hangar-filter-sep"> | </span>{% endif %}<button type="button" class="hangar-group-filter" id="ship4" data-filter-selector="{{ recycler }}">{{ LNG.fm_recycler }}</button>{% set hangarHasButton = true %}{% endif %}
			{% if hangarGroupAll %}{% if hangarHasButton %}<span class="hangar-filter-sep"> | </span>{% endif %}<button type="button" class="hangar-group-filter selected" id="ship3">{{ LNG.fm_all }}</button>{% set hangarHasButton = true %}{% endif %}
			{% for shipId in (hangarShipIds)|php_iter %}
				{% if hangarHasButton %}<span class="hangar-filter-sep"> | </span>{% endif %}
				<button type="button" class="hangar-ship-filter" id="ship-{{ shipId }}" data-ship-id="{{ shipId }}">{{ LNG.shortNames[shipId] }} <span class="hangar-filter-remove" data-ship-id="{{ shipId }}">×</span></button>
				{% set hangarHasButton = true %}
			{% endfor %}
			{% if hangarHasButton %}<span class="hangar-filter-sep"> | </span>{% endif %}
			<span class="hangar-filter-add-wrap">
				<button type="button" id="hangar-filter-add" title="{{ LNG.fm_add_filter }}">+</button>
				<div id="hangar-filter-menu" class="hangar-filter-menu" hidden data-ship-order="{{ hangarShipOrder|json_encode }}">
					{% for shipId, shipName in (hangarShipOptions)|php_iter %}
						<button type="button" class="hangar-filter-option" data-ship-id="{{ shipId }}">{{ shipName }}</button>
					{% endfor %}
				</div>
			</span>
		</div>
		{% else %}
		<div class="planeto">
			<span class="segmented" role="group"><button id="ship1">{{ LNG.fm_civil }}</button><button id="ship2">{{ LNG.fm_military }}</button><button id="ship3" class="selected">{{ LNG.fm_all }}</button></span>
		</div>
		{% endif %}
	{% endif %}

	{% for ID, Element in (elementList)|php_iter %}
		<div class="infos {% if Element.fade %}unavailable{% endif %}" id="s{{ ID }}">
			<div class="buildn"><a href="#" onclick="return Dialog.info({{ ID }})">{{ LNG.tech[ID] }}</a>
				<span id="val_{{ ID }}">{% if Element.available != 0 %} ({{ LNG.bd_available }} {{ pretty_number(Element.available) }}){% endif %}</span>
			</div>
			<div class="buildl">
				<a href="#" onclick="return Dialog.info({{ ID }})">
					<img class="float-left" src="{{ theme_asset('gebaeude/' ~ ID ~ '.gif') }}" alt="{{ LNG.tech[ID] }}" width="120" height="120">
				</a>
				{% if not empty(Element.requirements) %}
					{{ LNG.tt_requirements }}: </br>
					{% for requireID, NeedLevel in (Element.requirements)|php_iter %}
						<a href="#" onclick="return Dialog.info({{ requireID }})">
						<span class="{% if NeedLevel.own < NeedLevel.count %}colorNeutral{% else %}colorPositive{% endif %}">
							{{ LNG.tech[requireID] }} ({{ LNG.tt_lvl }} {{ NeedLevel.own }}/{{ NeedLevel.count }})
						</span>
						</a>{% if not loop.last %}<br>{% endif %}
					{% endfor %}
				{% else %}
					{{ LNG.bd_remaining }}:<br>
					{% for ResType, ResCount in (Element.costOverflow)|php_iter %}
						<a href='#' onclick='return Dialog.info({{ ResType }})' class='tooltip' data-tooltip-content="
							<table>
								<tr><th>{{ LNG.tech[ResType] }}</th></tr>
								<tr>
									<table class='hoverinfo'>
									<tr>
										<td><img class='inline max-w-none' src='{{ theme_asset('gebaeude/' ~ ResType ~ '.' ~ ((ResType >=600 and ResType <= 699) ? 'jpg' : 'gif')) }}'></td>
										<td>{{ LNG.shortDescription[ResType] }}</td>
									</tr>
									</table>
								</tr>
							</table>">{{ LNG.tech[ResType] }}</a>: <span class="bold">{{ pretty_number(ResCount) }}</span><br>
					{% endfor %}
					<p>{{ LNG.bd_max_ships_long }}:<span class="bold"><br>{{ pretty_number(Element.maxBuildable) }}</p>
				{% endif %}
			</div>
			<div class="buildl">
				<span>
					{% for RessID, RessAmount in (Element.costResources)|php_iter %}
						<a href='#' onclick='return Dialog.info({{ RessID }})' class='tooltip' data-tooltip-content="
						<table>
							<tr><th>{{ LNG.tech[RessID] }}</th></tr>
							<tr>
								<table class='hoverinfo'>
								<tr>
									<td><img class='inline max-w-none' src='{{ theme_asset('gebaeude/' ~ RessID ~ '.' ~ ((RessID >=600 and RessID <= 699) ? 'jpg' : 'gif')) }}'></td>
									<td>{{ LNG.shortDescription[RessID] }}</td>
								</tr>
								</table>
							</tr>
						</table>">{{ LNG.tech[RessID] }}</a>: <b><span class="{% if Element.costOverflow[RessID] == 0 %}colorPositive{% else %}colorNegative{% endif %}">{{ pretty_number(RessAmount) }}</span></b>
					{% endfor %}
				</span>
				<br><br>
				{% if ID==212 %} +{{ SolarEnergy }} {{ LNG.tech[911] }}<br>{% endif %}
				<span>
					{% if vacation %}
						<span class="colorNeutral">{{ LNG.op_options_vacation_activated }}</span>
					{% elseif not empty(Element.requirements) %}
						<span class="colorNeutral">{{ LNG.bd_requirements }}</span>
					{% elseif Element.AlreadyBuild %}
						<span class="colorNegative">{{ LNG.bd_protection_shield_only_one }}</span>
					{% elseif not NotBuilding %}
						<span class="colorNeutral">{{ LNG.sys_buildlist_fail }}</span>
					{% elseif not Element.buyable %}
						<span class="colorNeutral">{{ LNG.bd_remaining }}</span>
					{% else %}
						<form action="game?page=shipyard&amp;mode={{ mode }}" method="post" id="s{{ ID }}">
							<span class="control-group">
								<input type="number" name="fmenge[{{ ID }}]" id="input_{{ ID }}" maxlength="{{ maxlength }}" value="0" tabindex="{{ null }}" >
								<input type="button" value="{{ LNG.bd_max_ships }}" onclick="document.getElementById('input_{{ ID }}').value='{{ Element.maxBuildable }}'">
							</span>
							<input class="b colorPositive" type="submit" value="{{ LNG.bd_build_ships }}">
						</form>
					{% endif %}
					<p>{{ LNG.fgf_time }} <span class="statictime" timestamp="{{ Element.elementTime }}"></span></p>
				</span>
			</div>
		</div>
	{% endfor %}
{% endblock %}
{% block script %}{{ parent() }}
	<script type="text/javascript">
		data			= {{ BuildList|json_encode|raw }};
		bd_operating	= '{{ LNG.bd_operating }}';
		bd_available	= '{{ LNG.bd_available }}';
	</script>

	{% if not empty(BuildList) %}
	<script src="scripts/base/bcmath.js"></script>
	<script type="module" src="./scripts/game/shipyard.js"></script>
	<script type="text/javascript">
		onPageInit(function() {
			ShipyardInit();
		});
	</script>
	{% endif %}
	{% if mode == "fleet" %}
		{% if hangarFiltersEnabled %}
	<script type="module" src="./scripts/game/hangarFilter.js"></script>
		{% else %}
	<script>
		onPageInit(function() {
			var filters = {
				ship1: "{{ civil }}",
				ship2: "{{ military }}",
				ship3: null
			};
			Object.keys(filters).forEach(function(id) {
				document.getElementById(id)?.addEventListener('click', function() {
					document.querySelectorAll('.infos').forEach(function(el) {
						el.style.display = filters[id] !== null ? 'none' : '';
					});
					if (filters[id]) {
						document.querySelectorAll(filters[id]).forEach(function(el) { el.style.display = ''; });
					}
					Object.keys(filters).forEach(function(other) {
						document.getElementById(other)?.classList.toggle('selected', other === id);
					});
				});
			});
		});
	</script>
		{% endif %}
	{% endif %}
{% endblock %}
