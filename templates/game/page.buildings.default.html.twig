{% extends layout_template %}
{% import 'game/macros.buildcard.html.twig' as b %}
{% block title %}{{ LNG.lm_buildings }}{{ parent() }}{% endblock %}
{% block pagehead %}{{ b.pagehead(LNG.lm_buildings, 'building-2', Queue|default([])) }}{% endblock %}
{% block content %}
  {% include 'game/shared.buildqueue.html.twig' with {queuePage: 'buildings'} %}

  <div>
    <div class="planeto">
      <span class="segmented" role="group"><button id="btn1" data-action="filter-rows" data-filter-group="build" data-hide=".prod, .storage, .other" data-show=".prod">{{ LNG.fm_mining }}</button><button id="btn2" data-action="filter-rows" data-filter-group="build" data-hide=".prod, .storage, .other" data-show=".storage">{{ LNG.fm_storage }}</button><button id="btn3" data-action="filter-rows" data-filter-group="build" data-hide=".prod, .storage, .other" data-show=".other">{{ LNG.fm_other }}</button><button id="btn4" class="selected" data-action="filter-rows" data-filter-group="build" data-hide=".prod, .storage, .other">{{ LNG.fm_all }}</button></span>
      <span class="planeto__meta"><a title="{{ LNG.ov_developed_fields }}">{{ planet_field_current }}</a> / <a title="{{ LNG.ov_max_developed_fields }}">{{ planet_field_max }}</a> {{ LNG.ov_fields }}
      {% if isCatchUp %}
          &middot; {{ catchUp }} %
      {% endif %}</span>
    </div>
    {% for ID, Element in BuildInfoList %}
      <div class="infos {{ Element.filterClass }} {% if Element.fade %}unavailable{% endif %}" >
        <div class="buildn relative">
          <a href="#" class="info-link" data-action="dialog-info" data-id="{{ ID }}" title="{{ LNG.tt_requirements }} / {{ LNG.fcm_info }}">{{ LNG.tech[ID] }} <span class="info-ico">{{ icon('info') }}</span></a>{% if Element.level > 0 %} ({{ LNG.bd_lvl }} {{ Element.level }}{% if Element.maxLevel != 255 %}/{{ Element.maxLevel }}{% endif %}){% endif %}
            {% if ID == watch %}
              <a href="{{ path('game_buildings_show', {watch: 0}) }}">
                <img class="watchlist-fav-button"  src="./styles/theme/nova/img/fav.webp" alt="Unwatch">
              </a>
            {% else %}
              <a href="{{ path('game_buildings_show', {watch: ID}) }}">
                <img class="watchlist-fav-button"  src="./styles/theme/nova/img/nofav.webp" alt="Watch">
              </a>
            {% endif %}
        </div>
        <div class="buildl">
          <a href="#" data-action="dialog-info" data-id="{{ ID }}">
            <img class="float-left" src="{{ theme_asset('gebaeude/' ~ ID ~ '.gif') }}" alt="{{ LNG.tech[ID] }}" width="120" height="120" loading="lazy" decoding="async">
          </a>
          {% if Element.requirements %}
            {{ LNG.tt_requirements }}: </br>
            {% for requireID, NeedLevel in Element.requirements %}
              <a href="#" data-action="dialog-info" data-id="{{ requireID }}">
                <span class="{% if NeedLevel.own < NeedLevel.count %}colorNegative{% else %}colorPositive{% endif %}">
                  {{ LNG.tech[requireID] }} ({{ LNG.tt_lvl }} {{ NeedLevel.own }}/{{ NeedLevel.count }})
                </span>
              </a>{% if not loop.last %}<br>{% endif %}
            {% endfor %}
          {% elseif Element.infoEnergy %}
            {{ LNG.bd_next_level }}<br>
            {{ LNG.format(Element.infoEnergy.consumes ? 'bd_need_engine' : 'bd_more_engine', Element.infoEnergy.amount, LNG.tech[911]) }}
          {% endif %}
        </div>

        <div class="buildl">
          {% set atMax = Element.maxLevel == Element.levelToBuild %}
          {% if not atMax %}{{ b.costs(Element) }}{% endif %}
          {% if Element.factor != null and not Element.requirements and Element.buyable %}
            <span class="colorNeutral tooltip" data-tooltip-content="{{ LNG.sys_catchup_tooltip }}">{{ LNG.format('sys_catchup_short', Element.factor) }} %</span>
          {% endif %}
          {% set canBuild = false %}
          {% if vacation %}
            <span class="reason">{{ LNG.op_options_vacation_activated }}</span>
          {% elseif Element.requirements %}
            {{ b.needs(Element.requirements) }}
          {% elseif atMax %}
            <span class="reason">{{ LNG.bd_maxlevel }}</span>
          {% elseif not CanBuildElement %}
            <span class="reason">{{ LNG.bd_buildlist_full }}</span>
          {% elseif not RoomIsOk %}
            <span class="reason">{{ LNG.bd_no_more_fields }}</span>
          {% elseif not Element.buyable %}
            {{ b.missing(Element) }}
          {% elseif (isBusy.research and (ID == 6 or ID == 31)) or (isBusy.shipyard and (ID == 15 or ID == 21)) or (isBusy.repairdock and (ID == 35)) %}
            <span class="reason">{{ LNG.bd_working }}</span>
          {% else %}
            {% set canBuild = true %}
            <form action="{{ path('game_buildings_command') }}" method="post" class="build_form">
              <input type="hidden" name="cmd" value="insert">
              <input type="hidden" name="building" value="{{ ID }}">
              <button type="submit" class="colorPositive build_submit">{% if Element.level == 0 and Element.levelToBuild == 0 %}{{ LNG.bd_build }}{% else %}{{ LNG.bd_build_next_level }}{{ Element.levelToBuild + 1 }}{% endif %}</button>
            </form>
          {% endif %}
          {% if not canBuild and not atMax %}{{ b.locked(Element.level == 0 and Element.levelToBuild == 0 ? LNG.bd_build : LNG.bd_build_next_level ~ (Element.levelToBuild + 1)) }}{% endif %}

          <div class="build-meta">
          {% if not atMax %}{{ b.time(Element.elementTime) }}{% endif %}
          {% if Element.level > 0 %}
            {% if ID == 43 %}<a href="#" data-action="dialog-info" data-id="{{ ID }}">{{ LNG.bd_jump_gate_action }}</a>{% endif %}
            {% if ID == 34 %}<a href="{{ path('game_alliance_depot_show') }}">{{ LNG.bd_depot_action }}</a>{% endif %}
            {% if Element.destroyable %}{% set tt_destroy %}
            {# Start Destruction Popup #}
            <table class='tt-destroy'>
              <tr>
                <th colspan='2'>{{ LNG.bd_price_for_destroy }} {{ LNG.tech[ID] }} {{ Element.levelToDestroy }}</th>
              </tr>
              {% for ResType, ResCount in Element.destroyResources %}
              <tr>
                <td>{{ LNG.tech[ResType] }}</td>
                <td><span class='{% if not Element.destroyOverflow[ResType] %}colorPositive{% else %}colorNeutral{% endif %}'>{{ pretty_number(ResCount) }}</span></td>
              </tr>
              {% endfor %}
              <tr>
                <td>{{ LNG.bd_destroy_time }}</td>
                <td><span class='statictime' timestamp='{{ Element.destroyTime }}'></span></td>
              </tr>
              <tr>
                <td colspan='2'>
                  <form action='{{ path('game_buildings_command') }}' method='post' class='build_form'>
                    <input type='hidden' name='cmd' value='destroy'>
                    <input type='hidden' name='building' value='{{ ID }}'>
                    <button type='submit' class='build_submit onlist'>{{ LNG.bd_dismantle }}</button>
                  </form>
                </td>
              </tr>
            </table>
            {% endset %}<a class="tooltip_sticky build-meta__destroy" data-tooltip-forms {{ tooltip(tt_destroy) }}>{{ LNG.bd_dismantle }}</a>{% endif %}
          {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
  {{ tooltip_templates() }}
{% endblock %}

