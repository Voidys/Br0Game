{% extends layout_template %}
{% block title %}{{ LNG.lm_buildings }}{{ parent() }}{% endblock %}
{% block content %}
  {% include 'game/shared.buildqueue.html.twig' with {queuePage: 'buildings'} %}

  <div>
    <div class="planeto">
      <span class="segmented" role="group"><button id="btn1" data-action="filter-rows" data-filter-group="build" data-hide=".prod, .storage, .other" data-show=".prod">{{ LNG.fm_mining }}</button><button id="btn2" data-action="filter-rows" data-filter-group="build" data-hide=".prod, .storage, .other" data-show=".storage">{{ LNG.fm_storage }}</button><button id="btn3" data-action="filter-rows" data-filter-group="build" data-hide=".prod, .storage, .other" data-show=".other">{{ LNG.fm_other }}</button><button id="btn4" class="selected" data-action="filter-rows" data-filter-group="build" data-hide=".prod, .storage, .other">{{ LNG.fm_all }}</button></span>
      <span class="planeto__meta"><a title="{{ LNG.ov_developed_fields }}">{{ planet_field_current }}</a> / <a title="{{ LNG.ov_max_developed_fields }}">{{ planet_field_max }}</a> {{ LNG.ov_fields }}
      {% if isCatchUp %}
          &middot; {{ catchUp }} %
      {% endif %}</span>
    </div>
    {% for ID, Element in (BuildInfoList)|php_iter %}
      <div class="infos {{ Element.filterClass }} {% if Element.fade %}unavailable{% endif %}" >
        <div class="buildn relative">
          <a href="#" data-action="dialog-info" data-id="{{ ID }}">{{ LNG.tech[ID] }}</a>{% if Element.level > 0 %} ({{ LNG.bd_lvl }} {{ Element.level }}{% if Element.maxLevel != 255 %}/{{ Element.maxLevel }}{% endif %}){% endif %}
            {% if ID == watch %}
              <a href="?page=buildings&watch=0">
                <img class="watchlist-fav-button"  src="./styles/theme/nova/img/fav.webp" alt="Unwatch">
              </a>
            {% else %}
              <a href="?page=buildings&watch={{ ID }}">
                <img class="watchlist-fav-button"  src="./styles/theme/nova/img/nofav.webp" alt="Watch">
              </a>
            {% endif %}
        </div>
        <div class="buildl">
          <a href="#" data-action="dialog-info" data-id="{{ ID }}">
            <img class="float-left" src="{{ theme_asset('gebaeude/' ~ ID ~ '.gif') }}" alt="{{ LNG.tech[ID] }}" width="120" height="120">
          </a>
          {% if not empty(Element.requirements) %}
            {{ LNG.tt_requirements }}: </br>
            {% for requireID, NeedLevel in (Element.requirements)|php_iter %}
              <a href="#" data-action="dialog-info" data-id="{{ requireID }}">
                <span class="{% if NeedLevel.own < NeedLevel.count %}colorNeutral{% else %}colorPositive{% endif %}">
                  {{ LNG.tech[requireID] }} ({{ LNG.tt_lvl }} {{ NeedLevel.own }}/{{ NeedLevel.count }})
                </span>
              </a>{% if not loop.last %}<br>{% endif %}
            {% endfor %}
          {% else %}
            {{ LNG.bd_remaining }}:<br>
            {% for ResType, ResCount in (Element.costOverflow)|php_iter %}
              <a href='#' data-action="dialog-info" data-id="{{ ResType }}" class='tooltip' data-tooltip-content="<table><tr><th>{{ LNG.tech[ResType] }}</th></tr><tr><table class='hoverinfo'><tr><td>{{ LNG.shortDescription[ResType] }}</td></tr></table></tr></table>">{{ LNG.tech[ResType] }}</a>: <span class="bold">{{ pretty_number(ResCount) }}</span><br>
            {% endfor %}
            {% if Element.timetobuild!= 0 %}<div>{{ LNG['whenbuildable'] }}: <span class="buildcountdown bold" timestamp="{{ Element.timetobuild }}"></span></div>{% endif %}
            <br>
            {% if Element.infoEnergy %}
              {{ LNG.bd_next_level }}<br>
              {{ LNG.format(Element.infoEnergy.consumes ? 'bd_need_engine' : 'bd_more_engine', Element.infoEnergy.amount, LNG.tech[911]) }}<br>
            {% endif %}
          {% endif %}
        </div>

        <div class="buildl">
          <span>
            {% for RessID, RessAmount in (Element.costResources)|php_iter %}
              <a href='#' data-action="dialog-info" data-id="{{ RessID }}" class='tooltip' data-tooltip-content="<table><tr><th>{{ LNG.tech[RessID] }}</th></tr><tr><table class='hoverinfo'><tr><td><img class='inline max-w-none' src='{{ theme_asset('gebaeude/' ~ RessID ~ '.' ~ ((RessID >=600 and RessID <= 699) ? 'jpg' : 'gif')) }}'></td><td>{{ LNG.shortDescription[RessID] }}</td></tr></table></tr></table>">{{ LNG.tech[RessID] }}</a>: <b><span class="{% if Element.costOverflow[RessID] == 0 %}colorPositive{% else %}colorNeutral{% endif %}">{{ pretty_number(RessAmount) }}</span></b>
            {% endfor %}
            
            {% if Element.factor != null and empty(Element.requirements) and Element.buyable %}
              <span class="colorNeutral tooltip" data-tooltip-content="{{ LNG.sys_catchup_tooltip }}"><br>{{ LNG.format('sys_catchup_short', Element.factor) }} %</span>
            {% endif %}
          </span>
          <br><br>
          {% if vacation %}
            <span class="colorNeutral">{{ LNG.op_options_vacation_activated }}</span>
          {% elseif not empty(Element.requirements) %}
            <span class="colorNeutral">{{ LNG.bd_requirements }}</span>
          {% elseif Element.maxLevel == Element.levelToBuild %}
            <span class="colorNeutral">{{ LNG.bd_maxlevel }}</span>
          {% elseif not CanBuildElement %}
            <span class="colorNeutral">{{ LNG.bd_buildlist_full }}</span>
          {% elseif not RoomIsOk %}
            <span class="colorNeutral">{{ LNG.bd_no_more_fields }}</span>
          {% elseif not Element.buyable %}
            <span class="colorNeutral">{{ LNG.bd_remaining }}</span>
          {% elseif (isBusy.research and (ID == 6 or ID == 31)) or (isBusy.shipyard and (ID == 15 or ID == 21)) or (isBusy.repairdock and (ID == 35)) %}
            <span class="colorNeutral">{{ LNG.bd_working }}</span>
          {% else %}
            <form action="game?page=buildings" method="post" class="build_form">
              <input type="hidden" name="cmd" value="insert">
              <input type="hidden" name="building" value="{{ ID }}">
              {% if userLang=="de" or userLang=="of" or userLang=="pi" %}
                <button type="submit" class="colorPositive build_submit" {% if ID==34 %}data-action="open-url" data-url="https://www.youtube.com/watch?v=u3dahwW0njk" {% endif %}>
              {% else %}
                <button type="submit" class="colorPositive build_submit" {% if ID==34 %}data-action="open-url" data-url="https://www.youtube.com/watch?v=tldGgGFe194" {% endif %}>
              {% endif %}
              {% if Element.level == 0 and Element.levelToBuild == 0 %}{{ LNG.bd_build }}{% else %}{{ LNG.bd_build_next_level }}{{ Element.levelToBuild + 1 }}{% endif %}</button>
            </form>
          {% endif %}

          <br>
          {{ LNG.fgf_time }}:<span class="statictime" timestamp="{{ Element.elementTime }}"></span>
          {% if Element.level > 0 %}
            {% if ID == 43 %}<a href="#" data-action="dialog-info" data-id="{{ ID }}">{{ LNG.bd_jump_gate_action }}</a>{% endif %}
            {% if ID == 34 %}<a href="game?page=allianceDepot">{{ LNG.bd_depot_action }}</a>{% endif %}
            {% if Element.destroyable %}<br><a class="tooltip_sticky" data-tooltip-content="
            {# Start Destruction Popup #}
            <table class='tt-destroy'>
              <tr>
                <th colspan='2'>{{ LNG.bd_price_for_destroy }} {{ LNG.tech[ID] }} {{ Element.levelToDestroy }}</th>
              </tr>
              {% for ResType, ResCount in (Element.destroyResources)|php_iter %}
              <tr>
                <td>{{ LNG.tech[ResType] }}</td>
                <td><span class='{% if empty(Element.destroyOverflow[ResType]) %}colorPositive{% else %}colorNeutral{% endif %}'>{{ pretty_number(ResCount) }}</span></td>
              </tr>
              {% endfor %}
              <tr>
                <td>{{ LNG.bd_destroy_time }}</td>
                <td><span class='statictime' timestamp='{{ Element.destroyTime }}'></span></td>
              </tr>
              <tr>
                <td colspan='2'>
                  <form action='game?page=buildings' method='post' class='build_form'>
                    <input type='hidden' name='cmd' value='destroy'>
                    <input type='hidden' name='building' value='{{ ID }}'>
                    <button type='submit' class='build_submit onlist'>{{ LNG.bd_dismantle }}</button>
                  </form>
                </td>
              </tr>
            </table>
            {# End Destruction Popup #}
            ">{{ LNG.bd_dismantle }}</a>{% endif %}
          {% else %}
            &nbsp;
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
{% endblock %}

