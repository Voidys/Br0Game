{% extends layout_template %}
{% block title %}{{ LNG.lm_rules }}{{ parent() }}{% endblock %}
{% block content %}
  <section class="rules">
    <h1>{{ LNG.lm_rules }}</h1>
    {% if rulesEmpty %}
      <div class="notice notice--info" role="status">{{ icon('info') }}<div>{{ LNG.rulesEmpty }}</div></div>
    {% else %}
      <div class="rich-text" data-toc-label="{{ LNG.toc_contents|e('html_attr') }}">{{ rules }}</div>
    {% endif %}
  </section>
{% endblock %}
{% block script %}{{ parent() }}
<script type="module" src="./scripts/game/toc.js?v={{ asset_version }}"></script>
{% endblock %}
