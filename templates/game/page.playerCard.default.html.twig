{% if id != yourid %}
	<tr>
		<th colspan="5">{{ LNG.pl_etc }}</th>
	</tr>
	<tr>
		<td></td>
		<td colspan="1"><a href="#" onclick="return Dialog.Buddy({{ id }})">{{ LNG.pl_buddy }}</a></td>
		<td colspan="3"><a href="#" onclick="return Dialog.PM({{ id }});" title="{{ LNG.pl_message }}">{{ LNG.pl_message }}</a></td>
	</tr>
	{% if targetRights == 0 %}
		<form action="game?page=playerCard&id={{ id }}" method="post">
			<tr>
				<td></td>
				<td colspan="1"><label for="blockTrade">{{ LNG.blockTrade }}</label> <input onclick="block({{ id }});" name="blockTrade" id="blockTrade" type="checkbox" value="1" {% if blockTrade == 1 %}checked="checked" {% endif %}></td>
				<td colspan="3"><label for="blockDm">{{ LNG.blockDm }}</label> <input onclick="block({{ id }});" name="blockDm" id="blockDm" type="checkbox" value="1" {% if blockDm == 1 %}checked="checked" {% endif %}></td>
			</tr>
		</form>
	{% endif %}
{% endif %}
	<tr>
		<th colspan="5">{{ LNG.Achievements }}:</th>
	</tr>
	<tr>
		<td colspan="5">
			{% if achievements %}
				{% set i = 0 %}
				{% for achievement in (achievements)|php_iter %}
					{#if $i % 5 == 0}
						</td></tr><tr><td colspan="4">
					{/if#}
					<img class="inline-block achievement-icon" src="{{ dpath }}achievements/{{ achievement.image }}.jpg" onclick="return Dialog.ach({{ achievement.id }})" title="{{ LNG.Achievement_names[achievement.id] }}" alt="{{ achievement.name }}" />
					{% include 'game/shared.achievementInfo.html.twig' with {id: achievement.id, image: dpath ~ 'achievements/' ~ achievement.image ~ '.jpg'} only %}
					{% set i = i + 1 %}
				{% endfor %}
			{% endif %}
		</td>
	</tr>
