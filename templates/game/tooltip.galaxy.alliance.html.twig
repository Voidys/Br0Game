<table class='tt-galaxy'>
    <tr>
        <th>{{ LNG.gl_alliance }} {{ currentPlanet.alliance.name }}</th>
    </tr>
    <tr>
        <td>{{ currentPlanet.alliance.member }}</td>
    </tr>
    <tr>
        <td>
            <table>
                <tr>
                    <td><a href='{{ path('game_alliance_info', {id: currentPlanet.alliance.id}) }}'>{{ LNG.gl_alliance_page }}</a></td>
                </tr>
                <tr>
                    <td><a href='{{ path('game_statistics_show', {start: currentPlanet.alliance.rank, who: 2}) }}'>{{ LNG.gl_see_on_stats }}</a></td>
                </tr>
                {% if currentPlanet.alliance.web %}
                    <tr>
                        <td><a href='{{ currentPlanet.alliance.web }}' target='_blank' rel='noopener noreferrer'>{{ LNG.gl_alliance_web_page }}</a></td>
                    </tr>
                {% endif %}
            </table>
        </td>
    </tr>
</table>