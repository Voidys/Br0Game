{% extends layout_template %}
{% block content %}
<table id="resulttable">
	<tr>
		<th>{{ LNG.sh_name }}</th>
		<th class="ctr">&nbsp;</th>
		<th>{{ LNG.sh_alliance }}</th>
		<th>{{ LNG.sh_planet }}</th>
		<th class="ctr">{{ LNG.sh_coords }}</th>
		<th class="num">{{ LNG.sh_position }}</th>
	</tr>
	{% for searchRow in (searchList)|php_iter %}
	<tr>
		<td><a href="#" onclick="return Dialog.Playercard({{ searchRow.userid }});">{{ searchRow.username }}</a></td>
		<td class="ctr"><a href="#" onclick="return Dialog.PM({{ searchRow.userid }});" title="{{ LNG.sh_write_message }}"><img class="inline" src="{{ theme_asset('img/m.gif') }}"/></a>&nbsp;<a href="#" onclick="return Dialog.Buddy({{ searchRow.userid }});" title="{{ LNG.sh_buddy_request }}"><img class="inline" src="{{ theme_asset('img/b.gif') }}" border="0"></a></td>
		<td>{% if searchRow.allyname %}<a href="game?page=alliance&amp;mode=info&amp;id={{ searchRow.allyid }}">{{ searchRow.allyname }}</a>{% else %}-{% endif %}</td>
		<td>{{ searchRow.planetname }}</td>
		<td class="ctr"><a href="game?page=galaxy&amp;galaxy={{ searchRow.galaxy }}&amp;system={{ searchRow.system }}">[{{ searchRow.galaxy }}:{{ searchRow.system }}:{{ searchRow.planet }}]</a></td>
		<td class="num">{{ searchRow.rank }}</td>
	</tr>
	{% endfor %}
</table>
{% endblock %}