{% import '_macros/forms.html.twig' as forms -%}
{% extends layout_template %}
{% block title %}{{ LNG.lm_notes }}{{ parent() }}{% endblock %}
{% block content %}
<form action="{{ path('game_notes_insert') }}" method="post">
	<input type="hidden" name="id" value="{{ noteDetail.id }}">
	<table class="form-table">
		<tr>
			<th colspan="2">{% if noteDetail.id == 0 %}{{ LNG.nt_create_note }}{% else %}{{ LNG.nt_edit_note }}{% endif %}</th>
		</tr>
		<tr>
			<td><label for="priority">{{ LNG.nt_priority }}</label></td>
			<td>
				{{ forms.html_options({'id': 'priority', 'name': 'priority', 'options': PriorityList, 'selected': noteDetail.priority}) }}
			</td>
		</tr>
		<tr>
			<td><label for="title">{{ LNG.nt_subject_note }}</label></td>
			<td>
				<input type="text" id="title" name="title" maxlength="30" value="{{ noteDetail.title }}">
			</td>
		</tr>
		<tr>
			<td><label for="text">{{ LNG.nt_note }}</label> (<span id="cntChars">0</span>&nbsp;/&nbsp;10.000&nbsp;{{ LNG.nt_characters }})</td>
			<td>
				<textarea name="text" id="text" rows="10" maxlength="10000" data-on-keyup="char-count" data-target="cntChars">{{ noteDetail.text }}</textarea>
			</td>
		</tr>
		<tr>
			<td><a href="{{ path('game_notes_show') }}">{{ LNG.nt_back }}</a></td>
			<td class="form-actions">
				<input type="reset" value="{{ LNG.nt_reset }}">
				<input type="submit" value="{{ LNG.nt_save }}">
			</td>
		</tr>
	</table>
</form>
{% endblock %}