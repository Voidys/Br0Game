{% extends layout_template %}
{% block title %}{{ LNG.tech[elementID] }}{{ parent() }}{% endblock %}
{% block content %}
{% if head %}
<div class="info-head">
	<img class="info-head__img" src="{{ theme_asset('gebaeude/' ~ elementID ~ '.gif') }}" alt="{{ LNG.tech[elementID] }}" width="96" height="96">
	<div class="info-head__body">
		<h2 class="info-head__title">{{ LNG.tech[elementID] }}{% if head.level is not null %} <span class="info-head__level">({{ LNG.bd_lvl }} {{ head.level }})</span>{% endif %}</h2>
		{% if head.costs %}
			<div class="cost-list">{% for resID, amount in head.costs %}<span class="cost">{{ LNG.tech[resID] }}: <b>{{ pretty_number(amount) }}</b></span>{% endfor %}</div>
		{% endif %}
		{% if head.requirements %}
			<ul class="info-head__req">
				{% for requireID, need in head.requirements %}
					<li class="{% if need.own < need.count %}colorNegative{% else %}colorPositive{% endif %}">{% if need.own < need.count %}&#10007;{% else %}&#10003;{% endif %} {{ LNG.tech[requireID] }} {{ need.count }} ({{ need.own }}/{{ need.count }})</li>
				{% endfor %}
			</ul>
		{% endif %}
		{% if head.page == 'buildings' %}<a class="info-head__link" href="{{ path('game_buildings_show') }}">{{ LNG.lm_buildings }} &rarr;</a>
		{% elseif head.page == 'research' %}<a class="info-head__link" href="{{ path('game_research_show') }}">{{ LNG.lm_research }} &rarr;</a>
		{% elseif head.page == 'shipyard' %}<a class="info-head__link" href="{{ path('game_shipyard_show', {kind: 'shipyard'}) }}">{{ LNG.lm_shipshard }} &rarr;</a>
		{% else %}<a class="info-head__link" href="{{ path('game_shipyard_show', {kind: 'defense'}) }}">{{ LNG.lm_defenses }} &rarr;</a>{% endif %}
	</div>
</div>
{% endif %}
<table>
	<tbody>
	{% if not head %}
	<tr>
		<th>{{ LNG.tech[elementID] }}</th>
	</tr>
	{% endif %}
	<tr>
		<td>
			<div class="transparent">
						<p>{{ LNG.longDescription[elementID] }}</p>
          				{% if elementID == 106 and spytechStatsEnabled == true %}<p>{{ LNG.spytechStatsDescription }}</p>{% endif %}
          				{% if elementID >= 22 and elementID <= 24 and isModuleAvailable(constant('MODULE_RESOURCE_STASH')) %}<p>{{ LNG.secureResources }}</p>{% endif %}
						{% if FleetInfo %}
							{% if FleetInfo.rapidfire.to or FleetInfo.rapidfire.from %}
								<p class="hint">{{ LNG.in_rf_explanation }}</p>
								<table class="rapidfire-table">
									{% for rapidfireID, shoots in FleetInfo.rapidfire.to %}
										<tr><td>{{ LNG.in_rf_again }} {{ LNG.tech[rapidfireID] }}</td><td class="num colorPositive">{{ shoots }}%</td></tr>
									{% endfor %}
									{% for rapidfireID, shoots in FleetInfo.rapidfire.from %}
										<tr><td>{{ LNG.in_rf_from }} {{ LNG.tech[rapidfireID] }}</td><td class="num colorNegative">{{ shoots }}%</td></tr>
									{% endfor %}
								</table>
							{% endif %}
						{% endif %}
			</div>
		</td>
	</tr>
	</tbody>
</table>
{% if FleetInfo %}
{% include 'game/shared.information.shipInfo.html.twig' %}
{% endif %}
{% if gateData %}
{% include 'game/shared.information.gate.html.twig' %}
{% endif %}
{% if MissileList %}
{% include 'game/shared.information.missiles.html.twig' %}
{% endif %}
{% if productionTable.production %}
{% include 'game/shared.information.production.html.twig' %}
{% endif %}
{% if productionTable.storage %}
{% include 'game/shared.information.storage.html.twig' %}
{% endif %}
{% endblock %}
