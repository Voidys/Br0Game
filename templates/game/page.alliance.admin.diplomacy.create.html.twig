{% import '_macros/forms.html.twig' as forms -%}
{% extends layout_template %}
{% block title %}{{ LNG.lm_alliance }}{{ parent() }}{% endblock %}
{% block content %}
<form name="message" id="message">
	<table class="form-table">
	<tr>
		<th colspan="2">{{ LNG.al_diplo_create }}</th>
	</tr>
	<tr>
		<td>{{ LNG.al_diplo_ally }}</td>
		<td>{{ forms.html_options({'name': "ally_id", 'values': IdList, 'output': AllyList}) }}</td>
	</tr>
	<tr>
		<td>{{ LNG.al_diplo_level_des }}</td>
		{% if diploMode == php_const('DIPLO_PEACE') %}
			<td>{{ forms.html_options({'name': "level", 'values': range(7, 7), 'output': diploLevel, 'selected': diploMode}) }}</td>
		{% else %}
			<td>{{ forms.html_options({'name': "level", 'values': range(1, 6), 'output': diploLevel, 'selected': diploMode}) }}</td>
		{% endif %}
	</tr>
	<tr>
		<td>{{ LNG.al_diplo_text }}<br>(<span id="cntChars">0</span> / 5000 {{ LNG.al_characters }})</td>
		<td>
			<textarea name="text" rows="10" data-on-keyup="char-count" data-target="cntChars" maxlength="5000"></textarea>
		</td>
	</tr>
	<tr>
		<th class="form-actions" colspan="2">
		<input type="reset" value="{{ LNG.al_circular_reset }}">
		<input type="button" data-action="alliance-message-send" data-url="game?page=alliance&amp;mode=admin&amp;action=diplomacyCreateProcessor&amp;ajax=1" data-after="reload" data-empty="{{ LNG.mg_empty_text|e('html_attr') }}" value="{{ LNG.al_circular_send_submit }}">
		</th>
	</tr>
	</table>
</form>
{% endblock %}
{% block script %}{{ parent() }}
<script type="module" src="./scripts/game/alliance.js?v={{ asset_version }}"></script>
{% endblock %}
