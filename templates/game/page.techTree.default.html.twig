{% extends layout_template %}

{% block title %}
{{ LNG.lm_technology }}{{ parent() }}{% endblock %}

{% block content %}
<div class="infos"> 
{% for elementID, requireList in (TechTreeList)|php_iter %}
{% if not is_array(requireList) %}

<div class="techb" id="{{ requireList }}"> <button> <span class="plus" id="{{ requireList }}s">{{ icon('plus') }}</span>
  <span class="minus" id="{{ requireList }}h">{{ icon('minus') }}</span></button> {{ LNG.tech[requireList] }}</div>
	
{% else %}{% if requireList %}
<div class="techi" id="h{{ elementID }}">
<span class="achievement-name"><a href="#" data-action="dialog-info" data-id="{{ elementID }}">{{ LNG.tech[elementID] }}</a></span>
<a href="#" data-action="dialog-info" data-id="{{ elementID }}"><img class="inline" src="{{ theme_asset('gebaeude/' ~ elementID ~ '.' ~ ((elementID >=600 and elementID <= 699) ? 'jpg' : 'gif')) }}" width="89"></a>
</br>
{{ LNG.tt_requirements }}: </br>
{% for requireID, NeedLevel in (requireList)|php_iter %}
<a href="#" data-action="dialog-info" data-id="{{ requireID }}"><span class="{% if NeedLevel.own < NeedLevel.count %}colorNeutral{% else %}colorPositive{% endif %}">{{ LNG.tech[requireID] }} ({{ LNG.tt_lvl }} {{ NeedLevel.own }}/{{ NeedLevel.count }})</span></a>{% if not loop.last %}<br>{% endif %}

{% endfor %}
</div>

{% endif %}

{% endif %}
{% endfor %}</div>
{% endblock %}
{% block script %}{{ parent() }}
<script type="module" src="./scripts/game/techtree.js?v={{ asset_version }}"></script>
{% endblock %}
