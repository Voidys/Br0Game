{% extends layout_template %}
{% block title %}{{ LNG.depot_title }}{{ parent() }}{% endblock %}
{% block content %}
  <div class="table-scroll">
    <table class="depot-table">
      <thead>
        <tr>
          <th colspan="5">{{ LNG.depot_title }}</th>
        </tr>
        <tr>
          <td colspan="5">{{ LNG.format('depot_intro', depotLevel, maxStay) }}<br>{{ LNG.depot_deuterium_stock }}: <span class="num">{{ pretty_number(deuterium) }}</span></td>
        </tr>
      </thead>
      {% if fleets is empty %}
        <tbody>
          <tr>
            <td colspan="5" class="ctr">{{ LNG.depot_empty }}</td>
          </tr>
        </tbody>
      {% else %}
        <thead>
          <tr>
            <th>{{ LNG.depot_col_owner }}</th>
            <th>{{ LNG.depot_col_ships }}</th>
            <th>{{ LNG.depot_col_stay_end }}</th>
            <th class="num">{{ LNG.depot_col_hourly }}</th>
            <th>{{ LNG.depot_col_supply }}</th>
          </tr>
        </thead>
        <tbody>
          {% for fleet in fleets %}
            <tr>
              <td>{{ fleet.username }}</td>
              <td>
                {% for ship in fleet.ships %}
                  <a href="#" data-action="dialog-info" data-id="{{ ship.id }}">{{ LNG.tech[ship.id] }}</a>: {{ pretty_number(ship.count) }}{% if not loop.last %}<br>{% endif %}
                {% endfor %}
              </td>
              <td>{{ fleet.stayEnd }}</td>
              <td class="num">{{ pretty_number(fleet.hourlyCost) }}</td>
              <td>
                {% if fleet.maxHours < 1 %}
                  <span class="colorNeutral">{{ LNG.depot_full }}</span>
                {% else %}
                  <form action="game?page=allianceDepot" method="post" class="depot-form" data-hourly="{{ fleet.hourlyCost }}">
                    <input type="hidden" name="action" value="supply">
                    <input type="hidden" name="fleet" value="{{ fleet.id }}">
                    <select name="hours" data-depot-hours>
                      {% for hour in 1..fleet.maxHours %}
                        <option value="{{ hour }}">{{ LNG.format('depot_hours', hour) }}</option>
                      {% endfor %}
                    </select>
                    <span class="depot-cost">{{ LNG.depot_cost }}: <span class="num" data-depot-cost>{{ pretty_number(fleet.hourlyCost) }}</span> {{ LNG.tech[903] }}</span>
                    <button type="submit" class="colorPositive">{{ LNG.depot_supply }}</button>
                  </form>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      {% endif %}
    </table>
  </div>
{% endblock %}
