{% extends layout_template %}
{% block title %}{{ LNG.lm_options }}{{ parent() }}{% endblock %}
{% block content %}
<table>
	<tr>
		<th colspan="2">{{ LNG.op_vacation_mode_active_message }} {{ vacationUntil }}</th>
	</tr>
	<tr>
		<td class="ctr">
			<form action="game?page=settings" method="post">
				<input type="hidden" name="mode" value="toggleVacation">
				<input name="vacation" type="submit" value="{{ LNG.op_end_vacation_mode }}" {% if not canVacationDisbaled %}disabled{% endif %}> <img src="./styles/resource/images/admin/i.gif" width="16" height="16" alt="" class="tooltip" data-tooltip-content="{{ LNG.op_activate_vacation_mode_descrip }}">
			</form>
		</td>
		<td class="ctr">
			<form action="game?page=settings" method="post">
				<input type="hidden" name="mode" value="toggleDelete">
				<input name="delete" type="submit" value="{% if delete %}{{ LNG.op_stop_dlte_account }}{% else %}{{ LNG.op_dlte_account }}{% endif %}"> <img src="./styles/resource/images/admin/i.gif" width="16" height="16" alt="" class="tooltip" data-tooltip-content="{{ LNG.op_dlte_account_descrip }}">
			</form>
		</td>
	</tr>
</table>
{% endblock %}