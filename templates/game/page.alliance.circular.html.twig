{% import '_macros/forms.html.twig' as forms -%}
{% extends layout_template %}
{% block title %}{{ LNG.lm_alliance }}{{ parent() }}{% endblock %}
{% block content %}
<form name="message" id="message">
	<table class="form-table">
	<tr>
		<th colspan="2">{{ LNG.al_circular_send_ciruclar }}</th>
	</tr>
	<tr>
		<td>{{ LNG.al_receiver }}</td>
		<td>
		{{ forms.html_options({'name': 'rankID', 'options': RangeList}) }}
		</td>
	</tr><tr>
	<td>{{ LNG.mg_subject }}</td>
	<td><input type="text" name="subject" id="subject" maxlength="40" value="{{ LNG.mg_no_subject }}"></td>
	</tr>
	<tr>
		<td>{{ LNG.al_message }} (<span id="cntChars">0</span> / 5000 {{ LNG.al_characters }})</td>
		<td>
			<textarea name="text" rows="10" data-on-keyup="char-count" data-target="cntChars"></textarea>
		</td>
	</tr>
	<tr>
		<th class="form-actions" colspan="2">
		<input type="reset" value="{{ LNG.al_circular_reset }}">
		<input type="button" data-action="alliance-message-send" data-url="game?page=alliance&amp;mode=circular&amp;action=send&amp;ajax=1" data-after="close" data-empty="{{ LNG.mg_empty_text|e('html_attr') }}" name="button" value="{{ LNG.al_circular_send_submit }}">
		</th>
	</tr>
	</table>
</form>
{% endblock %}
{% block script %}{{ parent() }}
<script type="module" src="./scripts/game/alliance.js?v={{ asset_version }}"></script>
{% endblock %}
