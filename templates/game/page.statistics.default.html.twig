{% import '_macros/forms.html.twig' as forms -%}
{% extends layout_template %}
{% block title %}{{ LNG.lm_statistics }}{{ parent() }}{% endblock %}
{% block content %}
<form name="stats" id="stats" method="get" action="{{ path('game_statistics_show') }}">
	<table>
		<tr>
			<th>{{ LNG.st_statistics }} ({{ LNG.st_updated }}: {{ stat_date }})</th>
		</tr>
		<tr>
			<td>
				<div class="stats-filter">
				<span class="control-group"><label for="who">{{ LNG.st_show }}</label><select name="who" id="who" data-on-change="submit-form">{{ forms.html_options({'options': Selectors.who, 'selected': who}) }}</select></span>
				<span class="control-group"><label for="type">{{ LNG.st_per }}</label><select name="type" id="type" data-on-change="submit-form">{{ forms.html_options({'options': Selectors.type, 'selected': type}) }}</select></span>
				<span class="control-group"><label for="range">{{ LNG.st_in_the_positions }}</label><select name="range" id="range" data-on-change="submit-form">{{ forms.html_options({'options': Selectors.range, 'selected': range}) }}</select>
					{% if rangePrev %}<a class="button btn--small" href="{{ path('game_statistics_show', {who: who, type: type, range: rangePrev}) }}" title="{{ LNG.st_prev_range|e('html_attr') }}" aria-label="{{ LNG.st_prev_range|e('html_attr') }}">{{ icon('chevron-left') }}</a>{% endif %}
					{% if rangeNext %}<a class="button btn--small" href="{{ path('game_statistics_show', {who: who, type: type, range: rangeNext}) }}" title="{{ LNG.st_next_range|e('html_attr') }}" aria-label="{{ LNG.st_next_range|e('html_attr') }}">{{ icon('chevron-right') }}</a>{% endif %}</span>
				</div>
			</td>
		</tr>
	</table>
</form>
{% if who == 1 and RangeList|filter(r => r.id == CUser_id)|length %}<p class="stats-jump"><a class="button btn--small" href="#my-rank">{{ icon('user') }}{{ LNG.st_my_rank }}</a></p>{% endif %}
<table>
{% if who == 1 %}
	{% include 'game/shared.statistics.playerTable.html.twig' %}
{% elseif who == 2 %}
	{% include 'game/shared.statistics.allianceTable.html.twig' %}
{% endif %}
</table>
<p class="legend stats-legend"><span><b>{{ LNG.gl_short_newbie }}</b> {{ LNG.st_legend_noob }}</span><span><b>{{ LNG.gl_short_vacation }}</b> {{ LNG.gl_vacation }}</span><span><b>{{ LNG.gl_short_inactive }}</b> {{ LNG.gl_inactive_seven }}</span><span><b>{{ LNG.gl_short_long_inactive }}</b> {{ LNG.gl_inactive_twentyeight }}</span><span><b>{{ LNG.gl_short_ban }}</b> {{ LNG.gl_banned }}</span></p>
{% endblock %}

{% block script %}{{ parent() }}
<script type="module" src="./scripts/game/statistics.js?v={{ asset_version }}"></script>
{% endblock %}
