{% extends layout_template %}
{% block title %}{{ LNG.lm_galaxy }}{{ parent() }}{% endblock %}
{% block content %}
  <form action="?page=galaxy" method="post" id="galaxy_form">
    <input type="hidden" id="auto" value="dr">
    <div class="galaxy-nav">
      <div class="galaxy-nav__time">{{ LNG.ov_server_time }}: <span class="servertime">{{ servertime }}</span></div>
      <div class="galaxy-nav__bar">
        <div class="galaxy-nav__group">
          <span class="galaxy-nav__label">{{ LNG.gl_galaxy }}</span>
          <button type="button" name="galaxyLeft" aria-label="{{ LNG.gl_galaxy }} -1" title="{{ LNG.gl_galaxy }} -1" data-action="galaxy-submit" data-direction="galaxyLeft">{{ icon('chevron-left') }}</button>
          <input type="number" name="galaxy" value="{{ galaxy }}" maxlength="3" tabindex="1" class="coord" aria-label="{{ LNG.gl_galaxy }}">
          <button type="button" name="galaxyRight" aria-label="{{ LNG.gl_galaxy }} +1" title="{{ LNG.gl_galaxy }} +1" data-action="galaxy-submit" data-direction="galaxyRight">{{ icon('chevron-right') }}</button>
        </div>
        <div class="galaxy-nav__group">
          <span class="galaxy-nav__label">{{ LNG.gl_solar_system }}</span>
          <button type="button" name="systemLeft" aria-label="{{ LNG.gl_solar_system }} -1" title="{{ LNG.gl_solar_system }} -1" data-action="galaxy-submit" data-direction="systemLeft">{{ icon('chevron-left') }}</button>
          <input type="number" name="system" value="{{ system }}" maxlength="3" tabindex="2" class="coord" aria-label="{{ LNG.gl_solar_system }}">
          <button type="button" name="systemRight" aria-label="{{ LNG.gl_solar_system }} +1" title="{{ LNG.gl_solar_system }} +1" data-action="galaxy-submit" data-direction="systemRight">{{ icon('chevron-right') }}</button>
        </div>
        <div class="galaxy-nav__actions">
          <input type="submit" value="{{ LNG.gl_show }}">
          <input type="button" value="{{ LNG.gl_sync }}" id="gala_sync">
        </div>
      </div>
    </div>
  </form>
  <form action="?page=fleetMissile" method="post">
    <input type="hidden" name="galaxy" value="{{ galaxy }}">
    <input type="hidden" name="system" value="{{ system }}">
    <input type="hidden" name="planet" value="{{ planet }}">
    <input type="hidden" name="type" value="1">
    <input type="hidden" name="duration" value="{{ duration }}">

    <table id="missileForm" hidden>
      <tr>
        <th colspan="2">{{ LNG.gl_missil_launch }} [{{ galaxy }}:{{ system }}:{{ planet }}] {{ LNG.gl_missil_flytime }}: <span id="irakFlyTime">{{ duration }}</span></th>
      </tr>
      <tr>
        <td>{{ LNG.format('gl_missil_to_launch', currentmip) }} <span class="control-group"><input type="number" name="SendMI" maxlength="7"> <a href="#" data-action="missiles-max">{{ LNG.fl_max }}</a></span></td>
        <td>{{ LNG.gl_objective }}:
          {{ html_options({'name': 'Target', 'options': missileSelector}) }}
        </td>
      </tr>
      <tr>
        <th colspan="2" class="form-actions">
          <input type="submit" value="{{ LNG.gl_missil_launch_action }}">
        </th>
      </tr>
    </table>
  </form>

  <div class="galaxy-grid-container">
    <div class="galaxy-grid-row header">
      <div class="galaxy-grid-header position centered" data-small-text="{{ LNG.gl_pos }}">{{ LNG.gl_pos }}</div>
      <div class="galaxy-grid-header galaxy-planet" data-small-text="{{ LNG.gl_planet }}">{{ LNG.gl_planet }}</div>
      <div class="galaxy-grid-header galaxy-moon" data-small-text="{{ LNG.type_planet_short_3 }}">{{ LNG.gl_moon }}</div>
      <div class="galaxy-grid-header galaxy-debris" data-small-text="{{ LNG.type_planet_short_2 }}">{{ LNG.gl_debris_field }}</div>
      <div class="galaxy-grid-header galaxy-player" data-small-text="{{ LNG.gl_player }}">{{ LNG.gl_player_estate }} [{{ LNG.gl_alliance }}]</div>
      <div class="galaxy-grid-header galaxy-actions" data-small-text="{{ LNG.gl_actions }}">{{ LNG.gl_actions }}</div>
    </div>

    {% for planet in (planetDataNew)|php_iter %}
      {% set currentPlanet = GalaxyRows[planet.planet_position] %}
      {% if not isset(currentPlanet) %}
        <div class="galaxy-grid-row empty {{ cycle(['odd', 'even'], loop.index0) }}" data-info="p_{{ planet.planet_position }}">
          <div class="galaxy-grid-item position centered galaxy-pos--{{ colonizable[planet.planet_position] == 'colorPositive' ? 'free' : 'blocked' }} {{ colonizable[planet.planet_position] }} tooltip_sticky" data-tooltip-content="{% include 'game/tooltip.galaxy.colonizable.html.twig' %}">
            {{ planet.planet_position }}
          </div>
          <div class="galaxy-grid-item span5"></div>
        </div>
      {% elseif currentPlanet.destroyed == true %}
        <div class="galaxy-grid-row empty {{ cycle(['odd', 'even'], loop.index0) }}" data-info="p_{{ planet.planet_position }}">
          <div class="galaxy-grid-item position centered galaxy-pos--{{ colonizable[planet.planet_position] == 'colorPositive' ? 'free' : 'blocked' }} {{ colonizable[planet.planet_position] }} tooltip_sticky" data-tooltip-content="{% include 'game/tooltip.galaxy.colonizable.html.twig' %}">
            {{ planet.planet_position }}
          </div>
          <div class="galaxy-grid-item span2">{{ LNG.gl_planet_destroyed }}</div>
          <div class="galaxy-grid-item galaxy-debris span3">
            {% if currentPlanet.debris and (currentPlanet.debris.metal + currentPlanet.debris.crystal) > hiddenDebris %}
              <a class="tooltip_sticky" data-tooltip-content="{% include 'game/tooltip.galaxy.debris.html.twig' with {'id': currentPlanet.planet.id, 'missions': currentPlanet.missions, 'debris': currentPlanet.debris} %}">
                <img src="{{ theme_asset('planeten/debris.jpg') }}" height="22" width="22" alt="">
              </a>
              {{ shortly_number(currentPlanet.debris.metal) }} / {{ shortly_number(currentPlanet.debris.crystal) }}
            {% endif %}
          </div>
        </div>
      {% else %}
        <div class="galaxy-grid-row {{ cycle(['odd', 'even'], loop.index0) }}" data-info="p_{{ planet.planet_position }}">
          <div class="galaxy-grid-item position centered galaxy-pos--{{ currentPlanet.ownPlanet ? 'own' : 'taken' }} {{ colonizable[planet.planet_position] }} tooltip_sticky" data-tooltip-content="{% include 'game/tooltip.galaxy.colonizable.html.twig' %}">
            {{ planet.planet_position }}
          </div>
          <div class="galaxy-grid-item galaxy-planet">
            {% if isset(currentPlanet) %}
              <a class="tooltip_sticky" data-tooltip-content="{% include 'game/tooltip.galaxy.missions.html.twig' with {'details': currentPlanet.planet, 'missions': currentPlanet.missions} %}">
                <img src='{{ currentPlanet.planet.image }}' height='30' width='30'> {{ currentPlanet.planet.name }} {{ currentPlanet.lastActivity }}
              </a>
            {% endif %}
          </div>
          <div class="galaxy-grid-item galaxy-moon centered">
            {% if currentPlanet.moon %}
              <a class="tooltip_sticky" data-tooltip-content="{% include 'game/tooltip.galaxy.missions.html.twig' with {'moon': true, 'details': currentPlanet.moon, 'missions': currentPlanet.missions} %}">
                <img src='{{ currentPlanet.moon.image }}' height="22" width="22" alt="{{ currentPlanet.moon.name }}">
              </a>
            {% endif %}
          </div>
          <div class="galaxy-grid-item galaxy-debris centered">
            {% if currentPlanet.debris and (currentPlanet.debris.metal + currentPlanet.debris.crystal) > hiddenDebris %}
              <a class="tooltip_sticky" data-tooltip-content="{% include 'game/tooltip.galaxy.debris.html.twig' with {'id': currentPlanet.planet.id, 'missions': currentPlanet.missions, 'debris': currentPlanet.debris} %}">
                <img src="{{ theme_asset('planeten/debris.jpg') }}" height="22" width="22" alt="">
              </a>
              <div class="galaxy-debris-text">{{ shortly_number(currentPlanet.debris.metal) }} / {{ shortly_number(currentPlanet.debris.crystal) }}</div>
            {% endif %}
          </div>
          <div class="galaxy-grid-item galaxy-player">
            <a class="tooltip_sticky" data-tooltip-content="{% include 'game/tooltip.galaxy.player.html.twig' %}">
              <span playerid='{{ currentPlanet.user.id }}' class="{% for class in (currentPlanet.user.class)|php_iter %}{% if not loop.first %} {% endif %}galaxy-username-{{ class }}{% endfor %} galaxy-username{% if currentPlanet.user.isBuddy %} galaxy-friend{% endif %}">{{ currentPlanet.user.username }}</span>
            </a>
            {% if currentPlanet.user.is_leader %}<a class="tooltip galaxy-rank-leader" data-tooltip-content="<table width='100%'><tr><th colspan='2' class='text-center'>{{ currentPlanet.user.ally_owner_range|tooltip_text }}</th></tr><tr><td class='transparent'>{{ currentPlanet.alliance.name|tooltip_text }}</td></tr></table>">{{ icon('trophy') }}</a>{% endif %}
            {% if currentPlanet.user.is_diplo %}<a class="tooltip galaxy-rank-diplo" data-tooltip-content="<table width='100%'><tr><th colspan='2' class='text-center'>{{ LNG.al_rank_diplo }}</th></tr><tr><td class='transparent'>{{ currentPlanet.alliance.name|tooltip_text }}</td></tr></table>">{{ icon('handshake') }}</a>{% endif %}
            {% if not empty(currentPlanet.user.class) %}
              <div>{# Do not format next line. It will break layout. #}
                ({% for class in (currentPlanet.user.class)|php_iter %}{% if not loop.first %}&nbsp;{% endif %}<span class="galaxy-short-{{ class }} galaxy-short">{{ ShortStatus[class] }}</span>{% endfor %})
              </div>
            {% endif %}
            {% if currentPlanet.alliance %}
              <a allyid={{ currentPlanet.alliance.id }} class="tooltip_sticky" data-tooltip-content="{% include 'game/tooltip.galaxy.alliance.html.twig' %}">
                <span class="{% for class in (currentPlanet.alliance.class)|php_iter %}{% if not loop.first %} {% endif %}galaxy-alliance-{{ class }}{% endfor %} galaxy-alliance">[{{ currentPlanet.alliance.tag }}]</span>
              </a>
            {% endif %}
          </div>
          <div class="galaxy-grid-item galaxy-actions">
            {% if currentPlanet.action %}
              {% if currentPlanet.action.esp %}
                <a href="#" data-action="galaxy-mission" data-mission="6" data-planet="{{ currentPlanet.planet.id }}">
                  <img src="{{ theme_asset('img/e.gif') }}" title="{{ LNG.gl_spy }}" alt="">
                </a>
              {% endif %}
              {% if currentPlanet.action.spyReport %}
                <a href="#" class="spy-report-indicator spy-report-{{ currentPlanet.spyReport }}" data-action="popup" data-url="?page=spyReportPopup&amp;galaxy={{ galaxy }}&amp;system={{ system }}&amp;planet={{ planet.planet_position }}&amp;planettype=1&amp;_csrf={{ csrf_token() }}" data-width="900">
                  <img src="{{ theme_asset('img/spy_report.png') }}" title="{{ currentPlanet.spyReportTitle }}" alt="">
                </a>
              {% endif %}
              {% if currentPlanet.action.message %}
                <a href="#" data-action="dialog-pm" data-id="{{ currentPlanet.user.id }}">
                  <img src="{{ theme_asset('img/m.gif') }}" title="{{ LNG.write_message }}" alt="">
                </a>
              {% endif %}
              {% if currentPlanet.action.buddy and not currentPlanet.ownPlanet %}
                <a href="#" data-action="dialog-buddy" data-id="{{ currentPlanet.user.id }}">
                  <img src="{{ theme_asset('img/b.gif') }}" title="{{ LNG.gl_buddy_request }}" alt="">
                </a>
              {% endif %}
              {% if currentPlanet.action.missle %}
                <a href="#" data-action="missile-form" data-planet="{{ currentPlanet.planet.id }}" data-galaxy="{{ galaxy }}" data-system="{{ system }}" data-position="{{ planet.planet_position }}" data-duration="{{ duration }}" data-type="1">
                  <img src="{{ theme_asset('img/r.gif') }}" title="{{ LNG.gl_missile_attack }}" alt="">
                </a>
              {% endif %}
              {% if currentPlanet.action.phalanx %}
                <a href="#" data-action="popup" data-url="?page=phalanx&amp;galaxy={{ galaxy }}&amp;system={{ system }}&amp;planet={{ planet.planet_position }}&amp;planettype=1&amp;_csrf={{ csrf_token() }}" data-width="640">
                  <span>{{ LNG.gl_phalanx }}</span>
                </a>
              {% endif %}
            {% else %}
              -
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
    <div class="galaxy-grid-row empty even">
      <div class="galaxy-grid-item centered">
        {{ max_planets + 1 }}
      </div>
      <div class="galaxy-grid-item centered span5">
        <a href="?page=fleetTable&amp;galaxy={{ galaxy }}&amp;system={{ system }}&amp;planet={{ max_planets + 1 }}&amp;planettype=1&amp;target_mission=15">{{ LNG.gl_out_space }}</a>
      </div>
    </div>
    <div class="galaxy-grid-row empty odd">
      <div class="galaxy-grid-item centered">
        {{ max_planets + 2 }}
      </div>
      <div class="galaxy-grid-item centered span5">
        <a href="?page=fleetTable&amp;galaxy={{ galaxy }}&amp;system={{ system }}&amp;planet={{ max_planets + 2 }}&amp;planettype=1&amp;target_mission=16">{{ LNG.gl_trade_space }}</a>
      </div>
    </div>
    {% if pirateBase %}
      {% set planet = planet|merge({'planet_position': max_planets + 3}) %}
      <div class="galaxy-grid-row piratebase even">
        <div class="galaxy-grid-item position centered">
          {{ max_planets + 3 }}
        </div>
        <div class="galaxy-grid-item galaxy-planet span2">
          <a class="tooltip_sticky" data-tooltip-content="{% include 'game/tooltip.galaxy.missions.html.twig' with {'details': pirateBase, 'missions': pirateBase.missions, 'isPirateBase': true} %}">
            <img src="{{ pirateBase.image }}" height="30" width="30"> {{ LNG.type_planet_4 }}
          </a>
        </div>
        <div class="galaxy-grid-item galaxy-debris centered span2">
          {% if (pirateBase.metal + pirateBase.crystal) > 0 %}
            {% set currentPlanet = currentPlanet|merge({'planet': (currentPlanet.planet|default({}))|merge({'id': pirateBase.id})}) %}
            <a class="tooltip_sticky" data-tooltip-content="{% include 'game/tooltip.galaxy.debris.html.twig' with {'id': pirateBase.id, 'missions': pirateBase.missions, 'debris': pirateBase} %}">
              <img src="{{ theme_asset('planeten/debris.jpg') }}" height="22" width="22" alt="">
            </a>
            <div class="galaxy-debris-text">{{ shortly_number(pirateBase.metal) }} / {{ shortly_number(pirateBase.crystal) }}</div>
          {% endif %}
        </div>
        <div class="galaxy-grid-item galaxy-actions">
          {% if pirateBase.missions[21] %}
            <a href="#" data-action="galaxy-mission" data-mission="21" data-planet="{{ pirateBase.id }}">
              <img src="{{ theme_asset('img/e.gif') }}" title="{{ LNG.gl_spy }}" alt="">
            </a>
          {% endif %}
        </div>
      </div>
    {% endif %}
    <div class="galaxy-grid-row legende">
      <div class="galaxy-grid-header centered">({{ planetcount }})</div>
      <div class="galaxy-grid-header centered">
        <a class="tooltip" data-tooltip-content="
          <table class='tt-galaxy'>
            <tr><th colspan='2'>{{ LNG.gl_legend }}</th></tr>
            <tr><td class='tt-galaxy-label'>{{ LNG.gl_colonizable }}</td><td><span class='colorPositive'>{{ LNG.gl_pos }}</span></td></tr>
            <tr><td class='tt-galaxy-label'>{{ LNG.gl_not_colonizable }}</td><td><span class='colorNegative'>{{ LNG.gl_pos }}</span></td></tr>
            <tr><td class='tt-galaxy-label'>{{ LNG.gl_strong_player }}</td><td><span class='galaxy-short-strong'>{{ LNG.gl_short_strong }}</span></td></tr>
            <tr><td class='tt-galaxy-label'>{{ LNG.gl_week_player }}</td><td><span class='galaxy-short-noob'>{{ LNG.gl_short_newbie }}</span></td></tr>
            <tr><td class='tt-galaxy-label'>{{ LNG.gl_vacation }}</td><td><span class='galaxy-short-vacation'>{{ LNG.gl_short_vacation }}</span></td></tr>
            <tr><td class='tt-galaxy-label'>{{ LNG.gl_banned }}</td><td><span class='galaxy-short-banned'>{{ LNG.gl_short_ban }}</span></td></tr>
            <tr><td class='tt-galaxy-label'>{{ LNG.gl_inactive_seven }}</td><td><span class='galaxy-short-inactive'>{{ LNG.gl_short_inactive }}</span></td></tr>
            <tr><td class='tt-galaxy-label'>{{ LNG.gl_inactive_twentyeight }}</td><td><span class='galaxy-short-longinactive'>{{ LNG.gl_short_long_inactive }}</span></td></tr>
          </table>">{{ LNG.gl_legend }}</a>
      </div>
    </div>
    <div class="galaxy-grid-row stats">
      <div class="galaxy-grid-item centered">
        <span id="missiles">{{ pretty_number(currentmip) }}</span>&nbsp;{{ LNG.gl_avaible_missiles }}
      </div>
      <div class="galaxy-grid-item centered">
        <span id="slots">{{ maxfleetcount }}</span>/{{ fleetmax }} {{ LNG.gl_fleets }}
      </div>
      <div class="galaxy-grid-item centered">
        <span id="elementID210">{{ pretty_number(spyprobes) }}</span>&nbsp;{{ LNG.gl_avaible_spyprobes }}
      </div>
      <div class="galaxy-grid-item centered">
        <span id="elementID209">{{ pretty_number(recyclers) }}</span>&nbsp;{{ LNG.gl_avaible_recyclers }}
      </div>
    </div>
    <div class="galaxy-grid-row sync" data-info="galatool">
      <div class="galaxy-grid-item centered">
        <button id="gala_exportjson">{{ LNG.gl_sync_export_json }}</button>
      </div>
      <div class="galaxy-grid-item centered">
        <button id="gala_exportcsv">{{ LNG.gl_sync_export_csv }}</button>
      </div>
      <div class="galaxy-grid-item centered">
        <button id="gala_reset">{{ LNG.gl_sync_reset }}</button>
      </div>
      <div class="galaxy-grid-item centered upload">
        {{ LNG.gl_sync_import_json }}: <input id="gala_upload" type="file" accept=".json">
      </div>
    </div>
  </div>

  <div class="galaxy-grid-container" hidden id="fleetstatusrow">
  </div>

  {# system data for the galaxy sync (scripts/game/galaxy.js); the rows become the position-keyed map and get a timepoint there #}
  {% set systemRows = [] %}
  {% if max_planets >= 1 %}{% for planet in 1..max_planets %}
    {% set row = GalaxyRows[planet] ?? null %}
    {% if row is null or row.destroyed == true %}
      {% set systemRows = systemRows|merge([{position: planet, data: null}]) %}
    {% else %}
      {% set special %}{% if not empty(row.user.class) %}{% for class in (row.user.class)|php_iter %}{{ ShortStatus[class] }}{% endfor %}{% endif %}{% endset %}
      {% set systemRows = systemRows|merge([{position: planet, data: {
        planetname: row.planet.name,
        hasmoon: row.moon ? true : false,
        playerid: row.user.id,
        name: row.user.username,
        allianceid: row.alliance ? row.alliance.id : -1,
        alliancename: row.alliance ? row.alliance.name : '-',
        special: special|trim
      }}]) %}
    {% endif %}
  {% endfor %}{% endif %}
  {{ data_island('galaxy-data', {
    galakey: galaxy ~ ':' ~ system,
    systemRows: systemRows,
    maxFleetSetting: settings_fleetactions,
    planetLng: LNG['bonus']['Planets'],
    moonShortLng: LNG['type_planet_short_3'],
    confirmLng: LNG['delete_confirm_gala']
  }) }}
{% endblock %}
