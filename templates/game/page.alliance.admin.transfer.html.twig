{% import '_macros/forms.html.twig' as forms -%}
{% import '_macros/community.html.twig' as c -%}
{% extends layout_template %}
{% block title %}{{ LNG.lm_alliance }}{{ parent() }}{% endblock %}
{% block content %}
{{ c.breadcrumb([{label: LNG.lm_alliance, url: path('game_alliance_show')}, {label: LNG.al_manage_alliance, url: path('game_alliance_admin')}, {label: LNG.al_transfer_alliance}]) }}
<form action="{{ path('game_alliance_admin_transfer_send') }}" method="post">
<table class="form-table">
	<tr>
		<th colspan="2">{{ LNG.al_transfer_alliance }}</th>
	</tr>
	<tr>
		<td><label for="newleader">{{ LNG.al_transfer_to }}:</label></td>
		<td>{{ forms.html_options({'id': 'newleader', 'name': 'newleader', 'options': transferUserList}) }}</td>
	</tr>
	<tr>
		<td colspan="2" class="form-actions"><button type="submit" class="btn--danger" data-confirm-danger data-confirm="{{ LNG.al_transfer_confirm|e('html_attr') }}">{{ LNG.al_transfer_submit }}</button></td>
	</tr>
</table>
</form>
{{ c.back(path('game_alliance_admin'), LNG.al_back) }}
{% endblock %}