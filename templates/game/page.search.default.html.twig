{% import '_macros/forms.html.twig' as forms -%}
{% extends layout_template %}
{% block title %}{{ LNG.lm_search }}{{ parent() }}{% endblock %}
{% block content %}
<table>
	<tr>
		<th>{{ LNG.sh_search_in_the_universe }} <span id="loading" style="display:none;">{{ LNG.sh_loading }}</span></th>
	</tr>
	<tr>
		<td>
			<div class="search-bar" data-result-url="{{ path('game_search_result') }}">
			{{ forms.html_options({'options': modeSelector, 'name': "type", 'id': "type"}) }}
			<input type="text" name="searchtext" id="searchtext">
			<input type="button" value="{{ LNG.sh_search }}">
			</div>
		</td>
	</tr>
</table>
{% endblock %}