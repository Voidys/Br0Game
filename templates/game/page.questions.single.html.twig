{% extends layout_template %}
{% block title %}{{ entry.title }} - {{ LNG.lm_faq }}{{ parent() }}{% endblock %}
{% block content %}
<link rel="stylesheet" href="./styles/resource/css/app/faq.css?v={{ asset_version }}">
{{ data_island('faq-i18n', {copyLink: LNG.faq_copy_link, linkCopied: LNG.faq_link_copied}) }}

<div class="faq" id="faq-top" data-faq-article>
  <nav class="faq-crumbs" aria-label="{{ LNG.faq_overview }}">
    <ol>
      <li><a href="{{ path('game_questions_show') }}" data-faq-index-link>{{ LNG.faq_overview }}</a></li>
      <li><a href="{{ path('game_questions_show') }}#cat-{{ category.id }}">{{ category.name }}</a></li>
      <li aria-current="page"><span>{{ entry.title }}</span></li>
    </ol>
  </nav>

  <div class="faq-article">
    {% if toc|length >= 3 %}
    <nav class="faq-toc" data-faq-toc aria-labelledby="faq-toc-title">
      <p class="faq-toc__title" id="faq-toc-title">{{ LNG.faq_contents }}</p>
      <ul>
        {% for item in toc %}<li><a href="#{{ item.id }}">{{ item.title }}</a></li>{% endfor %}
      </ul>
    </nav>
    {% endif %}

    <article class="faq-article__main">
      <header class="faq-article__head">
        <p class="faq-article__cat">{{ icon(category.icon) }}{{ category.name }}</p>
        <h1 class="faq-article__title" data-faq-title>{{ entry.title }}</h1>
      </header>
      <div class="faq-body" data-faq-body>{{ entry.body }}</div>

      <nav class="faq-pager" aria-label="{{ LNG.faq_prev }} / {{ LNG.faq_next }}">
        {% if prev %}
        <a class="faq-pager__link faq-pager__link--prev" rel="prev" href="{{ path('game_questions_single', {categoryID: prev.categoryID, questionID: prev.questionID}) }}">
          <small>{{ icon('chevron-left') }}{{ LNG.faq_prev }}</small>
          <strong>{{ prev.title }}</strong>
        </a>
        {% endif %}
        {% if next %}
        <a class="faq-pager__link faq-pager__link--next" rel="next" href="{{ path('game_questions_single', {categoryID: next.categoryID, questionID: next.questionID}) }}">
          <small>{{ LNG.faq_next }}{{ icon('chevron-right') }}</small>
          <strong>{{ next.title }}</strong>
        </a>
        {% endif %}
      </nav>
      <div class="faq-foot">
        <a href="{{ path('game_questions_show') }}">{{ icon('arrow-left') }}{{ LNG.faq_back }}</a>
        <a href="#faq-top">{{ icon('chevron-up') }}{{ LNG.faq_to_top }}</a>
      </div>
      <p class="faq-sr" role="status" aria-live="polite" data-faq-status></p>
    </article>
  </div>
</div>
<script type="module" src="./scripts/app/faq.js?v={{ asset_version }}"></script>
{% endblock %}
