{% extends layout_template %}
{% block title %}{{ LNG.lm_faq }}{{ parent() }}{% endblock %}
{% block content %}
<table>
	<tr>
		<th>{{ LNG.faq_overview }}</th>
	</tr>
	<tr>
		<th>{{ questionRow.title }}</th>
	</tr>
	<tr>
		<td class="left faq-content">
		{{ questionRow.body|raw }}
		</td>
	</tr>
	<tr><th><a href="game?page=questions">{{ LNG.al_back }}</a></th>
	</tr>
</table>
{% endblock %}