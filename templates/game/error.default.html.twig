{% extends layout_template %}
{% block title %}{{ LNG.fcm_info }}{{ parent() }}{% endblock %}
{% block content %}
<table{% if autoCloseMs|default(0) %} data-auto-close="{{ autoCloseMs }}"{% endif %}>
	<tr>
		<th>{{ LNG.fcm_info }}</th>
	</tr>
	<tr>
		<td><p>{{ message }}</p>{% if not empty(redirectButtons) %}<p>{% for button in (redirectButtons)|php_iter %}<a href="{{ button.url }}"{% if button.action is defined %} data-action="{{ button.action }}"{% endif %}><button>{{ button.label }}</button></a>{% endfor %}</p>{% endif %}</td>
	</tr>
</table>
{% endblock %}