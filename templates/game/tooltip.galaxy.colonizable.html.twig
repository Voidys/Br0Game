<table class='tt-galaxy'>
    <tr>
        <th colspan='2'>
        {{ LNG.gl_features }}
        </th>
    </tr>
    <tr>
        <td>
        {{ LNG.ov_fields }}
        </td>
        <td>
        {{ planet.fields_min }} - {{ planet.fields_max }}                 
        </td>
    </tr>
    <tr>
        <td>
        {{ LNG.gl_temperature }}
        </td>
        <td>
        {{ planet.temp_min }} - {{ planet.temp_max }}  
        </td>
    </tr>
    <tr>
        {% if (planet.metalBonusPercent is defined and planet.metalBonusPercent is not null) and planet.metalBonusPercent > 0 %}
        <td>
            {{ LNG.tech[901] }}
        </td>
        <td>
            {{ planet.metalBonusPercent }} %
        </td>
        {% endif %}
    </tr>
    <tr>
        {% if (planet.crystalBonusPercent is defined and planet.crystalBonusPercent is not null) and planet.crystalBonusPercent > 0 %} 
        <td>
            {{ LNG.tech[902] }}
        </td>
        <td>
            {{ planet.crystalBonusPercent }} %
        </td>
        {% endif %} 
    </tr>
    <tr>
        {% if (planet.deuteriumBonusPercent is defined and planet.deuteriumBonusPercent is not null) and planet.deuteriumBonusPercent > 0 %}
        <td>
            {{ LNG.tech[903] }}
        </td>
        <td>
            {{ planet.deuteriumBonusPercent }} %
        </td>
        {% endif %}
    </tr>
    <tr>
        <td colspan='2' class='text-center'>
        {% if (currentPlanet is not defined or currentPlanet is null) and colonizable[planet.planet_position] != 'colorNegative' %}
            <a href='{{ path('game_fleet_table_show', {galaxy: galaxy, system: system, planet: planet.planet_position, planettype: 1, target_mission: 7}) }}'>{{ LNG.type_mission_7 }}</a>
        {% else %}
            {{ LNG.gl_not_colonizable }}
        {% endif %}
        </td>
    </tr>
</table>