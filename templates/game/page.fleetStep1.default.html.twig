{% import '_macros/forms.html.twig' as forms -%}
{% extends layout_template %}
{% block title %}{{ LNG.lm_fleet }}{{ parent() }}{% endblock %}
{% block content %}
<form action="game?page=fleetStep2" method="post" data-on-submit="check-target" id="form" class="form-page">
	<input type="hidden" name="token" value="{{ token }}">
	<input type="hidden" name="group" value="0">
	<input type="hidden" name="target_mission" value="{{ mission }}">
	<table class="form-table">
		<tr>
			<th colspan="2">{{ LNG.fl_send_fleet }}</th>
		</tr>
		<tr>
			<td>{{ LNG.fl_destiny }}</td>
			<td>
				<span class="control-group">
				<input type="number" id="galaxy" name="galaxy" maxlength="4" data-on-input="update-vars" value="{{ galaxy }}" class="coord">
				<input type="number" id="system" name="system" maxlength="6" data-on-input="update-vars" value="{{ system }}" class="coord">
				<input type="number" id="planet" name="planet" maxlength="4" data-on-input="update-vars" value="{{ planet }}" class="coord">
				<select id="type" name="type" data-on-change="update-vars">
					{{ forms.html_options({'options': typeSelect, 'selected': type}) }}
				</select>
				</span>
			</td>
		</tr>
		<tr>
			<td>{{ LNG.fl_fleet_speed }}</td>
			<td>
				<select id="speed" name="speed" data-on-change="update-vars-speed">
					{{ forms.html_options({'options': speedSelect}) }}
				</select> %
			</td>
		</tr>
		<tr>
			<td>{{ LNG.fl_distance }}</td>
			<td id="distance">-</td>
		</tr>
		<tr>
			<td>{{ LNG.fl_flying_time }}</td>
			<td id="duration">-</td>
		</tr>
		<tr>
			<td>{{ LNG.fl_flying_arrival }}</td>
			<td id="arrival">-</td>
		</tr>
		<tr>
			<td>{{ LNG.fl_flying_return }}</td>
			<td id="return">-</td>
		</tr>
		<tr>
			<td>{{ LNG.fl_fuel_consumption }}</td>
			<td id="consumption">-</td>
		</tr>
		<tr>
			<td>{{ LNG.fl_max_speed }}</td>
			<td id="maxspeed">-</td>
		</tr>
		<tr>
			<td>{{ LNG.fl_cargo_capacity }}</td>
			<td id="storage">-</td>
		</tr>
	</table>

<table class="table-fixed">
	<tr>
		<th colspan="2">{{ LNG.fl_system_places }}</th>
	</tr>
	<tr>
		<td>
			<a href="#" data-action="set-target" data-galaxy="{{ galaxy }}" data-system="{{ system }}" data-planet="{{ config.max_planets+1 }}" data-type="1">{{ LNG.type_mission_15 }} [{{ galaxy }}:{{ system }}:{{ config.max_planets+1 }}]</a>
		</td>
		<td>
			<a href="#" data-action="set-target" data-galaxy="{{ galaxy }}" data-system="{{ system }}" data-planet="{{ config.max_planets+2 }}" data-type="1">{{ LNG.type_mission_16 }} [{{ galaxy }}:{{ system }}:{{ config.max_planets+2 }}]</a>
		</td>
	</tr>
	{% if pirateBase %}
		<tr>
			<td>
				<a href="#" data-action="set-target" data-galaxy="{{ pirateBase.galaxy }}" data-system="{{ pirateBase.system }}" data-planet="{{ config.max_planets+3 }}" data-type="1">{{ LNG.type_planet_4 }} [{{ pirateBase.galaxy }}:{{ pirateBase.system }}:{{ config.max_planets+3 }}]</a>
			</td>
		</tr>
	{% endif %}
</table>

	{% if isModuleAvailable(php_const('MODULE_SHORTCUTS')) %}
	<table class="table-fixed shortcut">
		<tr>
			<th colspan="{{ themeSettings.SHORTCUT_ROWS_ON_FLEET1 }}">{{ LNG.fl_shortcut }} (<a href="#" data-action="edit-shortcuts" class="shortcut-link-edit shortcut-link">{{ LNG.fl_shortcut_edition }}</a><a href="#" data-action="save-shortcuts" class="shortcut-edit">{{ LNG.fl_shortcut_save }}</a>)</th>
		</tr>
    <tr class="shortcut-row">
      <td colspan="2">
        <div class="shortcut-container" >
          {% for shortcutID, shortcutRow in shortcutList %}
            <div class="shortcut-colum shortcut-isset">
              <div class="shortcut-link">
                <a href="#" data-action="set-target" data-galaxy="{{ shortcutRow.galaxy }}" data-system="{{ shortcutRow.system }}" data-planet="{{ shortcutRow.planet }}" data-type="{{ shortcutRow.type }}">{{ shortcutRow.name }}{% if shortcutRow.type == 1 %}{{ LNG.fl_planet_shortcut }}{% elseif shortcutRow.type == 2 %}{{ LNG.fl_debris_shortcut }}{% elseif shortcutRow.type == 3 %}{{ LNG.fl_moon_shortcut }}{% endif %} [{{ shortcutRow.galaxy }}:{{ shortcutRow.system }}:{{ shortcutRow.planet }}]</a>
              </div>
              <div class="shortcut-edit">
                <input type="text" class="shortcut-input" name="shortcut[{{ shortcutID }}][name]" maxlength="32" value="{{ shortcutRow.name }}">
                <div class="shortcut-delete" title="{{ LNG.fl_dlte_shortcut }}">x</div>
              </div>
              <div class="shortcut-edit">
                <input type="number" class="shortcut-input coord" name="shortcut[{{ shortcutID }}][galaxy]" value="{{ shortcutRow.galaxy }}" maxlength="4">:<input type="number" class="shortcut-input coord" name="shortcut[{{ shortcutID }}][system]" value="{{ shortcutRow.system }}" maxlength="6">:<input type="number" class="shortcut-input coord" name="shortcut[{{ shortcutID }}][planet]" value="{{ shortcutRow.planet }}" maxlength="6">
                <select class="shortcut-input" name="shortcut[{{ shortcutID }}][type]">
                  {{ forms.html_options({'selected': shortcutRow.type, 'options': typeSelect}) }}
                </select>
              </div>
            </div>
          {% endfor %}
        </div>
      </td>
    </tr>
    {% if shortcutList|count == 0 %}
      <tr class="shortcut-none">
        <td colspan="{{ themeSettings.SHORTCUT_ROWS_ON_FLEET1 }}">{{ LNG.fl_no_shortcuts }}</td>
      </tr>
    {% endif %}


		<tr class="shortcut-edit shortcut-new">
			<td>
				<div class="shortcut-link">

				</div>
				<div class="shortcut-edit">
					<input type="text" class="shortcut-input" name="shortcut[][name]" maxlength="32" placeholder="{{ LNG.fl_shortcut_name }}">
					<div class="shortcut-delete" title="{{ LNG.fl_dlte_shortcut }}">x</div>
				</div>
				<div class="shortcut-edit">
					<input type="number" class="shortcut-input coord" name="shortcut[][galaxy]" value="" maxlength="2" placeholder="G">:<input type="number" class="shortcut-input coord" name="shortcut[][system]" value="" maxlength="3" placeholder="S">:<input type="number" class="shortcut-input coord" name="shortcut[][planet]" value="" maxlength="2" placeholder="P">
					<select class="shortcut-input" name="shortcut[][type]">
						{{ forms.html_options({'options': typeSelect}) }}
					</select>
				</div>
			</td>
		</tr>
		<tr class="shortcut-edit">
			<td colspan="{{ themeSettings.SHORTCUT_ROWS_ON_FLEET1 }}">
				<a href="#" data-action="add-shortcut">{{ LNG.fl_shortcut_add }}</a>
			</td>
		</tr>
	</table>
	{% endif %}
	<table class="table-fixed">
		<tr>
			<th colspan="{{ themeSettings.COLONY_ROWS_ON_FLEET1 }}">{{ LNG.fl_my_planets }}</th>
		</tr>
		{% for ColonyRow in colonyList %}
			{% if (loop.index % themeSettings.COLONY_ROWS_ON_FLEET1) == 1 %}<tr>{% endif %}
			<td>
				<a href="#" data-action="set-target" data-galaxy="{{ ColonyRow.galaxy }}" data-system="{{ ColonyRow.system }}" data-planet="{{ ColonyRow.planet }}" data-type="{{ ColonyRow.type }}">{{ ColonyRow.name }}{% if ColonyRow.type == 3 %}{{ LNG.fl_moon_shortcut }}{% endif %} [{{ ColonyRow.galaxy }}:{{ ColonyRow.system }}:{{ ColonyRow.planet }}]</a>
			</td>
			{% if loop.last and (loop.index % themeSettings.COLONY_ROWS_ON_FLEET1) != 0 %}
				{% set to = themeSettings.COLONY_ROWS_ON_FLEET1 - (loop.index % themeSettings.COLONY_ROWS_ON_FLEET1) %}
				{% if (to) >= (1) %}{% for foo in 1..to %}<td>&nbsp;</td>{% endfor %}{% endif %}
			{% endif %}
			{% if (loop.index % themeSettings.COLONY_ROWS_ON_FLEET1) == 0 %}</tr>{% endif %}
		{% else %}
			<tr>
				<td colspan="{{ themeSettings.COLONY_ROWS_ON_FLEET1 }}">{{ LNG.fl_no_colony }}</td>
			</tr>
		{% endfor %}
	</table>
	{% if ACSList %}
	<table class="table-fixed">
		<tr>
			<th colspan="{{ themeSettings.COLONY_ROWS_ON_FLEET1 }}">{{ LNG.fl_acs_title }}</th>
		</tr>
		{% for ACSRow in ACSList %}
			<tr>
				<td colspan="{{ themeSettings.COLONY_ROWS_ON_FLEET1 }}"><a href="#" data-action="set-acs-target" data-galaxy="{{ ACSRow.galaxy }}" data-system="{{ ACSRow.system }}" data-planet="{{ ACSRow.planet }}" data-type="{{ ACSRow.planet_type }}" data-acs="{{ ACSRow.public_id }}">{{ ACSRow.name }} - [{{ ACSRow.galaxy }}:{{ ACSRow.system }}:{{ ACSRow.planet }}]</a></td>
			</tr>
		{% endfor %}
	</table>
	{% endif %}
	<div class="form-actions"><input type="submit" value="{{ LNG.fl_continue }}"></div>
</form>
{% endblock %}
{% block script %}{{ parent() }}
{{ data_island('fleet-data', {
	step: 1,
	data: fleetdata,
	honorboost: honorboost,
	config: config,
	token: token
}) }}
{% endblock %}
