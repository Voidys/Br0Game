{% extends layout_template %}
{% block title %}{{ LNG.lm_alliance }}{{ parent() }}{% endblock %}
{% block content %}
<form action="game?page=alliance&amp;mode=admin&amp;action=changeTag" method="post">
<table class="form-table">
	<tr>
		<th colspan="2">{{ LNG.al_tag }} {{ LNG.al_change_title }}</th>
	</tr>
	<tr>
		<td>{{ LNG.al_new_tag }}</td>
		<td><input type="text" name="newname" maxlength="8"></td>
	</tr>
	<tr>
		<td colspan="2" class="form-actions"><input type="submit" value="{{ LNG.al_change_submit }}"></td>
	</tr>
	<tr>
		<th colspan="2"><a href="game?page=alliance&amp;mode=admin">{{ LNG.al_back }}</a></th>
	</tr>
</table>
</form>
{% endblock %}