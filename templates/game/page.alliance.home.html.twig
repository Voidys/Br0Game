{% extends layout_template %}
{% block title %}{{ LNG.lm_alliance }}{{ parent() }}{% endblock %}
{% block content %}
<table class="form-table">
	<tr>
		<th colspan="3">{{ LNG.al_your_ally }}</th>
	</tr>
	{% if ally_image %}
	<tr>
		<td colspan="3"><img class="alliance-image inline" src="{{ ally_image }}"></td>
	</tr>
	{% endif %}
	<tr>
		<td colspan="2">{{ LNG.al_ally_info_tag }}</td>
		<td>{{ ally_tag }}</td>
	</tr>
	<tr>
		<td colspan="2">{{ LNG.al_ally_info_name }}</td>
		<td>{{ ally_name }}</td>
	</tr>
	<tr>
		<td colspan="2">{{ LNG.al_ally_info_members }}</td>
		<td>{{ ally_members }} / {{ ally_max_members }}{% if rights.MEMBERLIST %} (<a href="{{ path('game_alliance_member_list') }}">{{ LNG.al_user_list }}</a>){% endif %}</td>
	</tr>
	<tr>
		<td colspan="2">{{ LNG.al_rank }}</td>
		<td>{{ rankName }}{% if rights.ADMIN or rights.DIPLOMATIC or rights.RANKS or rights.MANAGEUSERS %} (<a href="{{ path('game_alliance_admin') }}">{{ LNG.al_manage_alliance }}</a>){% endif %}</td>
	</tr>
	{% if rights.SEEAPPLY and applyCount > 0 %}
	<tr>
		<td colspan="2">{{ LNG.al_requests }}</td>
		<td><a href="{{ path('game_alliance_admin_manage_apply') }}">{{ requests }}</a></td>
	</tr>
	{% endif %}
	{% if rights.DIPLOMATIC and (diploCountIn > 0 or diploCountOut > 0) %}
	<tr>
		<td colspan="2">{{ LNG.al_diplo }}</td>
		<td>
			{% if diploCountIn > 0 %}<a href="{{ path('game_alliance_admin_diplomacy') }}">{{ diploRequestsIn }}</a>{% endif %}
			{% if diploCountIn > 0 and diploCountOut > 0 %}<br>{% endif %}
			{% if diploCountOut > 0 %}<a href="{{ path('game_alliance_admin_diplomacy') }}">{{ diploRequestsOut }}</a>{% endif %}
		</td>
	</tr>
	{% endif %}
	{% if rights.ROUNDMAIL %}
	<tr>
		<td colspan="2">{{ LNG.al_circular_message }}</td>
		<td><a href="{{ path('game_alliance_circular') }}" data-dialog="" data-dialog-width="650">{{ LNG.al_send_circular_message }}</a></td>
	</tr>
	{% endif %}
	<tr>
		<td colspan="3" class="bbcode ally-description">{% if ally_description %}{{ ally_description }}{% else %}{{ LNG.al_description_message }}{% endif %}</td>
	</tr>
	{% if ally_web %}
	<tr>
		<td colspan="2">{{ LNG.al_web_text }}</td>
		<td><a href="{{ ally_web }}">{{ ally_web }}</a></td>
	</tr>
	{% endif %}
	<tr>
		<th colspan="3">{{ LNG.al_inside_section }}</th>
	</tr>
	<tr>
		<td colspan="3" class="bbcode">{{ ally_text }}</td>
	</tr>
	<tr>
		<th colspan="3">{{ LNG.al_diplo }}</th>
	</tr>
	<tr>
		<td colspan="3">
		{% if diplomats %}
			<b><u>{{ LNG.al_rank_diplo }}</u></b><br><br>
			{% for diplomat in diplomats %}{{ diplomat.username }} - {{ diplomat.rankName }} <a href="#" data-action="dialog-pm" data-id="{{ diplomat.id }}"><img class="inline" src="{{ theme_asset('img/m.gif') }}" title="{{ LNG.write_message }}" alt=""></a><br>{% endfor %}
			<br>
		{% endif %}
		{% if DiploInfo and (DiploInfo[0] or DiploInfo[1] or DiploInfo[2] or DiploInfo[3] or DiploInfo[4]) %}
			{% if DiploInfo[0] %}<b><u>{{ LNG.al_diplo_level[0] }}</u></b><br><br>{% for PaktInfo in DiploInfo[0] %}<a href="{{ path('game_alliance_info', {id: PaktInfo[1]}) }}">{{ PaktInfo[0] }}</a><br>{% endfor %}<br>{% endif %}
			{% if DiploInfo[1] %}<b><u>{{ LNG.al_diplo_level[1] }}</u></b><br><br>{% for PaktInfo in DiploInfo[1] %}<a href="{{ path('game_alliance_info', {id: PaktInfo[1]}) }}">{{ PaktInfo[0] }}</a><br>{% endfor %}<br>{% endif %}
			{% if DiploInfo[2] %}<b><u>{{ LNG.al_diplo_level[2] }}</u></b><br><br>{% for PaktInfo in DiploInfo[2] %}<a href="{{ path('game_alliance_info', {id: PaktInfo[1]}) }}">{{ PaktInfo[0] }}</a><br>{% endfor %}<br>{% endif %}
			{% if DiploInfo[3] %}<b><u>{{ LNG.al_diplo_level[3] }}</u></b><br><br>{% for PaktInfo in DiploInfo[3] %}<a href="{{ path('game_alliance_info', {id: PaktInfo[1]}) }}">{{ PaktInfo[0] }}</a><br>{% endfor %}<br>{% endif %}
			{% if DiploInfo[4] %}<b><u>{{ LNG.al_diplo_level[4] }}</u></b><br><br>{% for PaktInfo in DiploInfo[4] %}<a href="{{ path('game_alliance_info', {id: PaktInfo[1]}) }}">{{ PaktInfo[0] }}</a><br>{% endfor %}<br>{% endif %}
		{% else %}
			{{ LNG.al_no_diplo }}
		{% endif %}
		</td>
	</tr>
	<tr>
		<th colspan="3">{{ LNG.pl_fightstats }}</th>
	</tr>
	<tr>
		<td colspan="2">{% if not show %}<div class="tooltip1"><img class="inline" src="./styles/resource/images/icons/lock.webp" height="10" width="10"><span class="tooltiptext">{{ LNG.spytech_playercard.level6 }}</span></div> {% endif %}{{ LNG.pl_totalfight }}</td>
	<td class="num">{% if show %}{{ pretty_number(totalfight) }}{% else %}-{% endif %}</td>
	</tr>
	<tr>
		<td colspan="2">{% if not show %}<div class="tooltip1"><img class="inline" src="./styles/resource/images/icons/lock.webp" height="10" width="10"><span class="tooltiptext">{{ LNG.spytech_playercard.level6 }}</span></div> {% endif %}{{ LNG.pl_fightwon }}</td>
	<td class="num">{% if show %}{{ pretty_number(fightwon) }} {% if totalfight %}({{ (fightwon / totalfight * 100)|round(2) }}%){% endif %}{% else %}-{% endif %}</td>
	</tr>
	<tr>	
		<td colspan="2">{% if not show %}<div class="tooltip1"><img class="inline" src="./styles/resource/images/icons/lock.webp" height="10" width="10"><span class="tooltiptext">{{ LNG.spytech_playercard.level6 }}</span></div> {% endif %}{{ LNG.pl_fightlose }}</td>
	<td class="num">{% if show %}{{ pretty_number(fightlose) }} {% if totalfight %}({{ (fightlose / totalfight * 100)|round(2) }}%){% endif %}{% else %}-{% endif %}</td>
	</tr>
	<tr>
		<td colspan="2">{% if not show %}<div class="tooltip1"><img class="inline" src="./styles/resource/images/icons/lock.webp" height="10" width="10"><span class="tooltiptext">{{ LNG.spytech_playercard.level6 }}</span></div> {% endif %}{{ LNG.pl_fightdraw }}</td>
	<td class="num">{% if show %}{{ pretty_number(fightdraw) }} {% if totalfight %}({{ (fightdraw / totalfight * 100)|round(2) }}%){% endif %}{% else %}-{% endif %}</td>
	</tr>
	<tr>
		<td colspan="2">{% if not show %}<div class="tooltip1"><img class="inline" src="./styles/resource/images/icons/lock.webp" height="10" width="10"><span class="tooltiptext">{{ LNG.spytech_playercard.level6 }}</span></div> {% endif %}{{ LNG.pl_unitsshot }}</td>
	<td class="num">{% if show %}{{ unitsshot }}{% else %}-{% endif %}</td>
	</tr>
	<tr>
		<td colspan="2">{% if not show %}<div class="tooltip1"><img class="inline" src="./styles/resource/images/icons/lock.webp" height="10" width="10"><span class="tooltiptext">{{ LNG.spytech_playercard.level6 }}</span></div> {% endif %}{{ LNG.pl_unitslose }}</td>
	<td class="num">{% if show %}{{ unitslose }}{% else %}-{% endif %}</td>
	</tr>
	<tr>
		<td colspan="2">{% if not show %}<div class="tooltip1"><img class="inline" src="./styles/resource/images/icons/lock.webp" height="10" width="10"><span class="tooltiptext">{{ LNG.spytech_playercard.level6 }}</span></div> {% endif %}{{ LNG.pl_dermetal }}</td>
	<td class="num">{% if show %}{{ dermetal }}{% else %}-{% endif %}</td>
	</tr>
	<tr>
		<td colspan="2">{% if not show %}<div class="tooltip1"><img class="inline" src="./styles/resource/images/icons/lock.webp" height="10" width="10"><span class="tooltiptext">{{ LNG.spytech_playercard.level6 }}</span></div> {% endif %}{{ LNG.pl_dercrystal }}</td>
	<td class="num">{% if show %}{{ dercrystal }}{% else %}-{% endif %}</td>
	</tr>
</table>
{% if not isOwner %}
<table>
	<tr>
		<th>{{ LNG.al_leave_alliance }}</th>
	</tr>
	<tr>
		<td><a data-method="post" href="{{ path('game_alliance_close') }}" data-confirm-danger data-confirm="{{ LNG.al_leave_ally|e('html_attr') }}"><button>{{ LNG.al_continue }}</button></a></td>
	</tr>
</table>
{% endif %}
{% include 'game/shared.alliance.chart.html.twig' %}
{% endblock %}
