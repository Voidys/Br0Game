{% set currentPage = (app.request.attributes.get('_page') ?: app.request.query.get('page')|default('overview'))|lower %}
{% set currentMode = (app.request.query.get('mode')|default(''))|lower %}
{% macro link(href, iconName, label, active, extra) %}
  <li><a class="nav__link" href="{{ href }}"{% if active %} aria-current="page"{% endif %}{# raw: extra is a fixed attribute string from this template; label is LNG text (trusted) plus <span> badges built here around integers #}{{ extra|default('')|raw }}>{{ icon(iconName) }}<span class="nav__label">{{ label|raw }}</span></a></li>
{% endmacro %}
{% import _self as nav %}

<nav class="nav">
  <section class="nav__group">
    <h2 class="nav__heading">{{ LNG.ui_nav_empire|default('Empire') }}</h2>
    <ul>
      {{ nav.link(path('game_overview_show'), 'layout-dashboard', LNG.lm_overview, currentPage in ['overview', 'tutorial']) }}
      {% if isModuleAvailable(constant('MODULE_IMPERIUM')) and (not noobInterface or not tutorial or tutorial['id'] > 10) %}
        {{ nav.link(path('game_empire_show'), 'globe', LNG.lm_empire, currentPage == 'empire') }}
      {% endif %}
      {% if isModuleAvailable(constant('MODULE_BUILDING')) %}
        {{ nav.link(path('game_buildings_show'), 'building-2', LNG.lm_buildings, currentPage == 'buildings') }}
      {% endif %}
      {% if isModuleAvailable(constant('MODULE_RESEARCH')) and (not noobInterface or not tutorial or tutorial['id'] >= 6) %}
        {{ nav.link(path('game_research_show'), 'flask-conical', LNG.lm_research, currentPage == 'research') }}
      {% endif %}
      {% if isModuleAvailable(constant('MODULE_SHIPYARD_FLEET')) and (not noobInterface or not tutorial or tutorial['id'] >= 4) %}
        {{ nav.link(path('game_shipyard_show', {kind: 'shipyard'}), 'rocket', LNG.lm_shipshard, currentPage == 'shipyard' and app.request.attributes.get('kind') != 'defense') }}
      {% endif %}
      {% if isModuleAvailable(constant('MODULE_SHIPYARD_DEFENSIVE')) and (not noobInterface or not tutorial or tutorial['id'] >= 4) %}
        {{ nav.link(path('game_shipyard_show', {kind: 'defense'}), 'shield', LNG.lm_defenses, currentPage == 'shipyard' and app.request.attributes.get('kind') == 'defense') }}
      {% endif %}
      {% if isModuleAvailable(constant('MODULE_REPAIR_DOCK')) and (not noobInterface or not tutorial) %}
        {{ nav.link(path('game_repairdock_show'), 'wrench', LNG.lm_repairdock ~ (wreckfield ? ' <span class="nav__alert" title="!">!</span>' : ''), currentPage == 'repairdock') }}
      {% endif %}
      {% if isModuleAvailable(constant('MODULE_RESSOURCE_LIST')) %}
        {{ nav.link(path('game_resources_show'), 'chart-column', LNG.lm_resources, currentPage == 'resources') }}
      {% endif %}
      {% if isModuleAvailable(constant('MODULE_TECHTREE')) and (not noobInterface or not tutorial or tutorial['id'] >= 6) %}
        {{ nav.link(path('game_techtree_show'), 'git-fork', LNG.lm_technology, currentPage == 'techtree') }}
      {% endif %}
    </ul>
  </section>

  <section class="nav__group">
    <h2 class="nav__heading">{{ LNG.ui_nav_universe|default('Universe') }}</h2>
    <ul>
      {% if isModuleAvailable(constant('MODULE_GALAXY')) and (not noobInterface or not tutorial or tutorial['id'] >= 7) %}
        {{ nav.link(path('game_galaxy_show'), 'orbit', LNG.lm_galaxy, currentPage == 'galaxy') }}
      {% endif %}
      {% if (not noobInterface or not tutorial or tutorial['id'] > 6) %}
        {{ nav.link(path('game_fleet_table_show'), 'send', LNG.lm_fleet, currentPage starts with 'fleet' and currentPage != 'fleetdealer') }}
      {% endif %}
      {% if isModuleAvailable(constant('MODULE_MESSAGES')) %}
        {{ nav.link(path('game_messages_show'), 'mail', LNG.lm_messages ~ (new_message > 0 ? ' <span class="nav__count">' ~ new_message ~ '</span>' : ''), currentPage == 'messages') }}
      {% endif %}
      {% if isModuleAvailable(constant('MODULE_MISSION_TRADE')) and (not noobInterface or not tutorial) %}
        {{ nav.link(path('game_market_place_show'), 'store', LNG.lm_marketplace, currentPage in ['marketplace', 'fleetdealer']) }}
      {% endif %}
      {% if isModuleAvailable(constant('MODULE_SIMULATOR')) and (not noobInterface or not tutorial or tutorial['id'] > 6) %}
        {{ nav.link(path('game_battle_simulator_show'), 'swords', LNG.lm_battlesim, currentPage == 'battlesimulator') }}
      {% endif %}
    </ul>
  </section>

  <section class="nav__group">
    <h2 class="nav__heading">{{ LNG.ui_nav_community|default('Community') }}</h2>
    <ul>
      {% if isModuleAvailable(constant('MODULE_ALLIANCE')) %}
        {{ nav.link(path('game_alliance_show'), 'users', LNG.lm_alliance ~ (new_allyrequests > 0 ? ' <span class="nav__count">' ~ new_allyrequests ~ '</span>' : ''), currentPage in ['alliance', 'alliancedepot']) }}
      {% endif %}
      {% if isModuleAvailable(constant('MODULE_BUDDYLIST')) %}
        {{ nav.link(path('game_buddy_list_show'), 'user-plus', LNG.lm_buddylist ~ (new_buddyrequests > 0 ? ' <span class="nav__count">' ~ new_buddyrequests ~ '</span>' : ''), currentPage == 'buddylist') }}
      {% endif %}
      {% if isModuleAvailable(constant('MODULE_STATISTICS')) %}
        {{ nav.link(path('game_statistics_show'), 'trophy', LNG.lm_statistics, currentPage == 'statistics') }}
      {% endif %}
      {% if game_config('board_enabled', '1') != '0' %}
        {{ nav.link(path('account_board_show'), 'messages-square', LNG.lm_board, false, ' target="_blank" rel="noopener"') }}
      {% endif %}
      {{ nav.link(path('game_battle_hall_show'), 'skull', LNG.lm_topkb, currentPage == 'battlehall') }}
      {% if voteNav %}
        {{ nav.link(path('game_vote_show'), 'gift', LNG.lm_vote, currentPage == 'vote') }}
      {% endif %}
      {% if isModuleAvailable(constant('MODULE_RECORDS')) %}
        {{ nav.link(path('game_records_show'), 'medal', LNG.lm_records, currentPage == 'records') }}
      {% endif %}
      {% if not noobInterface or not tutorial %}
        {{ nav.link(path('game_achievements_show'), 'award', LNG.Achievements, currentPage == 'achievements') }}
        {{ nav.link(path('game_advanced_stats_show'), 'chart-line', LNG.advancedStats, currentPage == 'advancedstats') }}
      {% endif %}
      {% if isModuleAvailable(constant('MODULE_SEARCH')) %}
        {{ nav.link(path('game_search_show'), 'search', LNG.lm_search, currentPage == 'search') }}
      {% endif %}
      {% if isModuleAvailable(constant('MODULE_BANLIST')) %}
        {{ nav.link(path('game_ban_list_show'), 'ban', LNG.lm_banned, currentPage == 'banlist') }}
      {% endif %}
    </ul>
  </section>

  <section class="nav__group">
    <h2 class="nav__heading">{{ LNG.ui_nav_help|default('Help') }}</h2>
    <ul>
      {% if communityNav.wiki is defined %}
        {{ nav.link(communityNav.wiki, 'book-open', 'Wiki', false, ' target="_blank" rel="noopener"') }}
      {% endif %}
      {% if isModuleAvailable(constant('MODULE_SUPPORT')) %}
        {{ nav.link(path('game_ticket_show'), 'life-buoy', LNG.lm_support, currentPage == 'ticket') }}
      {% endif %}
      {{ nav.link(path('game_questions_show'), 'circle-help', LNG.lm_faq, currentPage == 'questions') }}
      {% if (not noobInterface or not tutorial or tutorial['id'] > 6) %}
        {{ nav.link(path('game_team_show'), 'users', 'Team', currentPage == 'team') }}
      {% endif %}
      {% if communityNav.discord is defined %}
        {{ nav.link(communityNav.discord, 'message-circle', 'Discord', false, ' target="_blank" rel="noopener"') }}
      {% endif %}
      {% if communityNav.donate is defined %}
        {{ nav.link(communityNav.donate, 'heart', LNG.donate, false, ' target="_blank" rel="noopener"') }}
      {% endif %}
    </ul>
  </section>

  <section class="nav__group">
    <h2 class="nav__heading">{{ LNG.ui_nav_personal|default('Personal') }}</h2>
    <ul>
      {% if isModuleAvailable(constant('MODULE_NOTICE')) and (not noobInterface or not tutorial) %}
        {{ nav.link(path('game_notes_show'), 'sticky-note', LNG.lm_notes, false, ' data-action="popup" data-url="' ~ path('game_notes_show') ~ '" data-width="720"') }}
      {% endif %}
      {{ nav.link(path('game_settings_show'), 'settings', LNG.lm_options, currentPage == 'settings') }}
      {% if account_id != 0 %}
        {{ nav.link(path('account_account_show'), 'user', LNG['Account'], false) }}
      {% endif %}
      {{ nav.link(path('login_data_privacy_show'), 'shield-check', LNG.lm_dataPrivacy, false, ' data-dialog data-dialog-width="820"') }}
      {% if authlevel > 0 %}
        {{ nav.link('./admin', 'shield-alert', LNG.lm_administration, false) }}
      {% endif %}
    </ul>
  </section>
</nav>
