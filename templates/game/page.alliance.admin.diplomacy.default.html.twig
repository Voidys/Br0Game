{% extends layout_template %}
{% block title %}{{ LNG.lm_alliance }}{{ parent() }}{% endblock %}
{% block content %}
<table>
	<tr>
		<th colspan="2">{{ LNG.al_diplo_head }}</th>
	</tr>
	<tr>
		<td colspan="2">{{ LNG.al_diplo_info }}</td>
	</tr>
	{% for diploMode, diploAlliances in (diploList[0])|php_iter %}	
	<tr>
		<th colspan="2">{{ LNG.al_diplo_level[diploMode] }}</th>
	</tr>
		{% for diploID, diploName in (diploAlliances)|php_iter %}
		<tr>
			<td>{{ diploName }}</td>
			<td class="act">
				{% if diploMode == php_const('DIPLO_WAR') %}
				<a href="game?page=alliance&amp;mode=admin&amp;action=diplomacyCreate&amp;diploMode={{ php_const('DIPLO_PEACE') }}&amp;id={{ diploID }}" data-dialog="" data-dialog-width="650"><img class="inline" src="styles/resource/images/false.webp" alt="" width="16" height="16"></a>
				{% else %}
				<a data-method="post" href="game?page=alliance&amp;mode=admin&amp;action=diplomacyDelete&amp;id={{ diploID }}" data-confirm-danger data-confirm="{{ LNG.al_diplo_confirm_delete|e('html_attr') }}"><img class="inline" src="styles/resource/images/false.webp" alt="" width="16" height="16"></a>
				{% endif %}
			</td>
		</tr>
		{% else %}
		<tr>
			<td colspan="2">{{ LNG.al_diplo_no_entry }}</td>
		</tr>
		{% endfor %}
	{% if diploMode != php_const('DIPLO_MAIN') %}
	<tr>
		<td colspan="2">
			<a href="game?page=alliance&amp;mode=admin&amp;action=diplomacyCreate&amp;diploMode={{ diploMode }}" data-dialog="" data-dialog-width="650">{{ LNG.al_diplo_create }}</a>
		</td>
	</tr>
	{% endif %}
	{% endfor %}
	</table>
<table>
	<tr>
		<th colspan="2">{{ LNG.al_diplo_accept }}</th>
	</tr>
	{% if array_filter(diploList[1]) %}
		{% for diploMode, diploAlliances in (diploList[1])|php_iter %}	
		{% if not empty(diploAlliances) %}
		<tr>
			<th colspan="2">{{ LNG.al_diplo_level[diploMode] }}</th>
		</tr>
		{% for diploID, diploName in (diploAlliances)|php_iter %}
		<tr>
			<td>{{ diploName }}</td>
			<td class="act">
				<a data-method="post" href="game?page=alliance&amp;mode=admin&amp;action=diplomacyAccept&amp;id={{ diploID }}" data-confirm="{{ LNG.al_diplo_accept_yes_confirm|e('html_attr') }}"><img class="inline" src="styles/resource/images/true.webp" alt="" width="16" height="16"></a>
				<a data-method="post" href="game?page=alliance&amp;mode=admin&amp;action=diplomacyReject&amp;id={{ diploID }}" data-confirm="{{ LNG.al_diplo_accept_no_confirm|e('html_attr') }}"><img class="inline" src="styles/resource/images/false.webp" alt="" width="16" height="16"></a>
			</td>
		</tr>
		{% endfor %}
		{% endif %}
		{% endfor %}
	{% else %}
	<tr>
		<td colspan="2">{{ LNG.al_diplo_no_accept }}</td>
	</tr>	
	{% endif %}
	</table>
<table>
	<tr>
		<th colspan="2">{{ LNG.al_diplo_accept_send }}</th>
	</tr>
	{% if array_filter(diploList[2]) %}
		{% for diploMode, diploAlliances in (diploList[2])|php_iter %}	
		{% if not empty(diploAlliances) %}
		<tr>
			<th colspan="2">{{ LNG.al_diplo_level[diploMode] }}</th>
		</tr>
		{% for diploID, diploName in (diploAlliances)|php_iter %}
		<tr>
			<td>{{ diploName }}</td>
			<td class="act">
				<a data-method="post" href="game?page=alliance&amp;mode=admin&amp;action=diplomacyDelete&amp;id={{ diploID }}" data-confirm-danger data-confirm="{{ LNG.al_diplo_withdraw_confirm|e('html_attr') }}"><img class="inline" src="styles/resource/images/false.webp" alt="" width="16" height="16"></a>
			</td>
		</tr>
		{% endfor %}
		{% endif %}
		{% endfor %}
	{% else %}
	<tr>
		<td colspan="2">{{ LNG.al_diplo_no_accept }}</td>
	</tr>	
	{% endif %}
	<tr>
		<th colspan="2"><a href="game?page=alliance&amp;mode=admin">{{ LNG.al_back }}</a></th>
	</tr>
	</table>
{% endblock %}