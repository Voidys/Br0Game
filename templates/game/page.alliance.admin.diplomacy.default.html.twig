{% extends layout_template %}
{% block title %}{{ LNG.lm_alliance }}{{ parent() }}{% endblock %}
{% block content %}
<table>
	<tr>
		<th colspan="2">{{ LNG.al_diplo_head }}</th>
	</tr>
	<tr>
		<td colspan="2">{{ LNG.al_diplo_info }}</td>
	</tr>
	{% for diploMode, diploAlliances in diploList[0] %}	
	<tr>
		<th colspan="2">{{ LNG.al_diplo_level[diploMode] }}</th>
	</tr>
		{% for diploID, diploName in diploAlliances %}
		<tr>
			<td>{{ diploName }}</td>
			<td class="act">
				{% if diploMode == constant('App\\Game\\Enum\\DiploType::War').value %}
				<a href="{{ path('game_alliance_admin_diplomacy_create', {diploMode: constant('App\\Game\\Enum\\DiploType::Peace').value, id: diploID}) }}" data-dialog="" data-dialog-width="650"><img class="inline" src="styles/resource/images/false.webp" alt="" width="16" height="16"></a>
				{% else %}
				<a data-method="post" href="{{ path('game_alliance_admin_diplomacy_delete', {id: diploID}) }}" data-confirm-danger data-confirm="{{ LNG.al_diplo_confirm_delete|e('html_attr') }}"><img class="inline" src="styles/resource/images/false.webp" alt="" width="16" height="16"></a>
				{% endif %}
			</td>
		</tr>
		{% else %}
		<tr>
			<td colspan="2">{{ LNG.al_diplo_no_entry }}</td>
		</tr>
		{% endfor %}
	{% if diploMode != constant('App\\Game\\Enum\\DiploType::Main').value %}
	<tr>
		<td colspan="2">
			<a href="{{ path('game_alliance_admin_diplomacy_create', {diploMode: diploMode}) }}" data-dialog="" data-dialog-width="650">{{ LNG.al_diplo_create }}</a>
		</td>
	</tr>
	{% endif %}
	{% endfor %}
	</table>
<table>
	<tr>
		<th colspan="2">{{ LNG.al_diplo_accept }}</th>
	</tr>
	{% if array_filter(diploList[1]) %}
		{% for diploMode, diploAlliances in diploList[1] %}	
		{% if diploAlliances %}
		<tr>
			<th colspan="2">{{ LNG.al_diplo_level[diploMode] }}</th>
		</tr>
		{% for diploID, diploName in diploAlliances %}
		<tr>
			<td>{{ diploName }}</td>
			<td class="act">
				<a data-method="post" href="{{ path('game_alliance_admin_diplomacy_accept', {id: diploID}) }}" data-confirm="{{ LNG.al_diplo_accept_yes_confirm|e('html_attr') }}"><img class="inline" src="styles/resource/images/true.webp" alt="" width="16" height="16"></a>
				<a data-method="post" href="{{ path('game_alliance_admin_diplomacy_reject', {id: diploID}) }}" data-confirm="{{ LNG.al_diplo_accept_no_confirm|e('html_attr') }}"><img class="inline" src="styles/resource/images/false.webp" alt="" width="16" height="16"></a>
			</td>
		</tr>
		{% endfor %}
		{% endif %}
		{% endfor %}
	{% else %}
	<tr>
		<td colspan="2">{{ LNG.al_diplo_no_accept }}</td>
	</tr>	
	{% endif %}
	</table>
<table>
	<tr>
		<th colspan="2">{{ LNG.al_diplo_accept_send }}</th>
	</tr>
	{% if array_filter(diploList[2]) %}
		{% for diploMode, diploAlliances in diploList[2] %}	
		{% if diploAlliances %}
		<tr>
			<th colspan="2">{{ LNG.al_diplo_level[diploMode] }}</th>
		</tr>
		{% for diploID, diploName in diploAlliances %}
		<tr>
			<td>{{ diploName }}</td>
			<td class="act">
				<a data-method="post" href="{{ path('game_alliance_admin_diplomacy_delete', {id: diploID}) }}" data-confirm-danger data-confirm="{{ LNG.al_diplo_withdraw_confirm|e('html_attr') }}"><img class="inline" src="styles/resource/images/false.webp" alt="" width="16" height="16"></a>
			</td>
		</tr>
		{% endfor %}
		{% endif %}
		{% endfor %}
	{% else %}
	<tr>
		<td colspan="2">{{ LNG.al_diplo_no_accept }}</td>
	</tr>	
	{% endif %}
	<tr>
		<th colspan="2"><a href="{{ path('game_alliance_admin') }}">{{ LNG.al_back }}</a></th>
	</tr>
	</table>
{% endblock %}