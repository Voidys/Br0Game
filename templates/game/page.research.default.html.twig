{% extends layout_template %}
{% block title %}{{ LNG.lm_research }}{{ parent() }}{% endblock %}
{% block content %}
	{% if not hasLab %}<div class="hidden-div">{{ LNG.bd_no_lab }}</div>{% endif %}
	{% include 'game/shared.buildqueue.html.twig' with {queuePage: 'research'} %}

	{% if IsLabinBuild %}<div class="hidden-div">{{ LNG.bd_building_lab }}</div>{% endif %}
	<div>
		<div class="planeto">
			<span class="segmented" role="group"><button id="lab1" data-action="filter-rows" data-filter-group="lab" data-hide=".infos" data-show="#t108, #t113, #t114, #t123, #t124">{{ LNG.fm_imperial }}</button><button id="lab2" data-action="filter-rows" data-filter-group="lab" data-hide=".infos" data-show="#t109, #t106, #t110, #t111, #t120, #t121, #t122, #t199">{{ LNG.fm_military }}</button><button id="lab3" data-action="filter-rows" data-filter-group="lab" data-hide=".infos" data-show="#t114, #t115, #t117, #t118">{{ LNG.fm_engines }}</button><button id="lab4" data-action="filter-rows" data-filter-group="lab" data-hide=".infos" data-show="#t131, #t132, #t133">{{ LNG.fm_mining }}</button><button id="lab5" class="selected" data-action="filter-rows" data-filter-group="lab" data-hide=".infos">{{ LNG.fm_all }}</button></span>
			{% if isCatchUp %}
				<br>{{ catchUp }} %
			{% endif %}
		</div>

		{% for ID, Element in (ResearchList)|php_iter %}
			{% if hide_useless == 0 or Element['max_useful_level'] == 0 or Element['level'] < Element['max_useful_level'] %}
				<div class="infos {% if Element.fade %}unavailable{% endif %}" id="t{{ ID }}">
					<div class="buildn relative">
						<a href="#" data-action="dialog-info" data-id="{{ ID }}">{{ LNG.tech[ID] }}</a>{% if Element.level != 0 %} ({{ LNG.bd_lvl }} {{ Element.level }}{% if Element.maxLevel != 255 %}/{{ Element.maxLevel }}{% endif %}){% endif %}
						{% if ID == watch %}
							<a href="?page=research&watch=0">
								<img class="watchlist-fav-button" src="./styles/theme/nova/img/fav.webp" alt="Unwatch">
							</a>
						{% else %}
							<a href="?page=research&watch={{ ID }}">
								<img class="watchlist-fav-button" src="./styles/theme/nova/img/nofav.webp" alt="Watch">
							</a>
						{% endif %}
					</div>
					<div class="buildl">
						<a href="#" data-action="dialog-info" data-id="{{ ID }}">
							<img class="float-left" src="{{ theme_asset('gebaeude/' ~ ID ~ '.gif') }}" width="120" height="120">
						</a>
						{% if not empty(Element.requirements) %}
							{{ LNG.tt_requirements }}: </br>
							{% for requireID, NeedLevel in (Element.requirements)|php_iter %}
								<a href="#" data-action="dialog-info" data-id="{{ requireID }}">
								<span class="{% if NeedLevel.own < NeedLevel.count %}colorNeutral{% else %}colorPositive{% endif %}">
									{{ LNG.tech[requireID] }} ({{ LNG.tt_lvl }} {{ NeedLevel.own }}/{{ NeedLevel.count }})
								</span>
								</a>{% if not loop.last %}<br>{% endif %}
							{% endfor %}
						{% else %}
							{{ LNG.bd_remaining }}:<br>
							{% for ResType, ResCount in (Element.costOverflow)|php_iter %}
								<a href='#' data-action="dialog-info" data-id="{{ ResType }}" class='tooltip' data-tooltip-content="{{ include('game/tooltip.element.html.twig', {id: ResType})|e('html_attr') }}">{{ LNG.tech[ResType] }}</a>: <span class="bold">{{ pretty_number(ResCount) }}</span><br>
							{% endfor %}
							{% if Element.timetobuild!= 0 %}<div>{{ LNG['whenbuildable'] }}: <span class="buildcountdown bold" timestamp="{{ Element.timetobuild }}"></span></div>{% endif %}
						{% endif %}
					</div>

					<div class="buildl">
						<span>
							{% for RessID, RessAmount in (Element.costResources)|php_iter %}
								<a href='#' data-action="dialog-info" data-id="{{ RessID }}" class='tooltip' data-tooltip-content="{{ include('game/tooltip.element.html.twig', {id: RessID})|e('html_attr') }}">{{ LNG.tech[RessID] }}</a>: <b><span class="{% if Element.costOverflow[RessID] == 0 %}colorPositive{% else %}colorNegative{% endif %}">{{ pretty_number(RessAmount) }}</span></b>
							{% endfor %}
							
							{% if Element.factor != null and empty(Element.requirements) and Element.buyable %}
								<span class="colorNeutral tooltip" data-tooltip-content="{{ LNG.sys_catchup_tooltip }}"><br>{{ LNG.format('sys_catchup_short', Element.factor) }} %</span>
							{% endif %}
						</span>
						<br><br>
						{% if vacation %}
							<span class="colorNeutral">{{ LNG.op_options_vacation_activated }}</span>
						{% elseif not empty(Element.requirements) %}
							<span class="colorNeutral">{{ LNG.bd_requirements }}</span>
						{% elseif Element.maxLevel == Element.levelToBuild %}
							<span class="colorNeutral">{{ LNG.bd_maxlevel }}</span>
						{% elseif IsLabinBuild %}
							<span class="colorNeutral">{{ LNG.sys_buildlist_fail }}</span>
						{% elseif IsFullQueue %}
							<span class="colorNeutral">{{ LNG.bd_researclist_full }}</span>
						{% elseif not Element.buyable %}
							<span class="colorNeutral">{{ LNG.bd_remaining }}</span>
						{% else %}
							<form action="game?page=research" method="post" class="build_form">
								<input type="hidden" name="cmd" value="insert">
								<input type="hidden" name="tech" value="{{ ID }}">
								<button type="submit" class="colorPositive build_submit">{% if Element.level == 0 and Element.levelToBuild == 0 %}{{ LNG.bd_tech }}{% else %}{{ LNG.bd_tech_next_level }}{{ Element.levelToBuild + 1 }}{% endif %}</button>
							</form>
						{% endif %}
						</br>
						{{ LNG.fgf_time }}
						<span class="statictime" timestamp="{{ Element.elementTime }}"></span>
					</div>
				</div>
			{% endif %}
		{% endfor %}
	</div>
{% endblock %}
{% block script %}{{ parent() }}
	{% if not empty(Queue) %}
		<script type="module" src="./scripts/game/research.js"></script>
	{% endif %}
{% endblock %}