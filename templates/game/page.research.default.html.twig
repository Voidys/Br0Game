{% extends layout_template %}
{% block title %}{{ LNG.lm_research }}{{ parent() }}{% endblock %}
{% block content %}
	{% if not hasLab %}<div class="hidden-div">{{ LNG.bd_no_lab }}</div>{% endif %}
	{% include 'game/shared.buildqueue.html.twig' with {queuePage: 'research'} %}

	{% if IsLabinBuild %}<div class="hidden-div">{{ LNG.bd_building_lab }}</div>{% endif %}
	<div>
		<div class="planeto">
			<button id="lab1">{{ LNG.fm_imperial }}</button> | <button id="lab2">{{ LNG.fm_military }}</button> | <button id="lab3">{{ LNG.fm_engines }}</button> | <button id="lab4">{{ LNG.fm_mining }}</button> | <button id="lab5" class="selected">{{ LNG.fm_all }}</button>
			{% if isCatchUp %}
				<br>{{ catchUp }} %
			{% endif %}
		</div>

		{% for ID, Element in (ResearchList)|php_iter %}
			{% if hide_useless == 0 or Element['max_useful_level'] == 0 or Element['level'] < Element['max_useful_level'] %}
				<div class="infos {% if Element.fade %}unavailable{% endif %}" id="t{{ ID }}">
					<div class="buildn relative">
						<a href="#" onclick="return Dialog.info({{ ID }})">{{ LNG.tech[ID] }}</a>{% if Element.level != 0 %} ({{ LNG.bd_lvl }} {{ Element.level }}{% if Element.maxLevel != 255 %}/{{ Element.maxLevel }}{% endif %}){% endif %}
						{% if ID == watch %}
							<a href="?page=research&watch=0">
								<img class="watchlist-fav-button" src="./styles/theme/nova/img/fav.png" alt="Unwatch">
							</a>
						{% else %}
							<a href="?page=research&watch={{ ID }}">
								<img class="watchlist-fav-button" src="./styles/theme/nova/img/nofav.png" alt="Watch">
							</a>
						{% endif %}
					</div>
					<div class="buildl">
						<a href="#" onclick="return Dialog.info({{ ID }})">
							<img class="float-left" src="{{ dpath }}gebaeude/{{ ID }}.gif" width="120" height="120">
						</a>
						{% if not empty(Element.requirements) %}
							{{ LNG.tt_requirements }}: </br>
							{% for requireID, NeedLevel in (Element.requirements)|php_iter %}
								<a href="#" onclick="return Dialog.info({{ requireID }})">
								<span class="{% if NeedLevel.own < NeedLevel.count %}colorNeutral{% else %}colorPositive{% endif %}">
									{{ LNG.tech[requireID] }} ({{ LNG.tt_lvl }} {{ NeedLevel.own }}/{{ NeedLevel.count }})
								</span>
								</a>{% if not loop.last %}<br>{% endif %}
							{% endfor %}
						{% else %}
							{{ LNG.bd_remaining }}:<br>
							{% for ResType, ResCount in (Element.costOverflow)|php_iter %}
								<a href='#' onclick='return Dialog.info({{ ResType }})' class='tooltip' data-tooltip-content="<table><tr><th>{{ LNG.tech[ResType] }}</th></tr><tr><table class='hoverinfo'><tr><td><img class='inline max-w-none' src='{{ dpath }}gebaeude/{{ ResType }}.{% if ResType >=600 and ResType <= 699 %}jpg{% else %}gif{% endif %}'></td><td>{{ LNG.shortDescription[ResType] }}</td></tr></table></tr></table>">{{ LNG.tech[ResType] }}</a>: <span class="bold">{{ pretty_number(ResCount) }}</span><br>
							{% endfor %}
							{% if Element.timetobuild!= 0 %}<div>{{ LNG['whenbuildable'] }}: <span class="buildcountdown bold" timestamp="{{ Element.timetobuild }}"></span></div>{% endif %}
						{% endif %}
					</div>

					<div class="buildl">
						<span>
							{% for RessID, RessAmount in (Element.costResources)|php_iter %}
								<a href='#' onclick='return Dialog.info({{ RessID }})' class='tooltip' data-tooltip-content="<table><tr><th>{{ LNG.tech[RessID] }}</th></tr><tr><table class='hoverinfo'><tr><td><img class='inline max-w-none' src='{{ dpath }}gebaeude/{{ RessID }}.{% if RessID >=600 and RessID <= 699 %}jpg{% else %}gif{% endif %}'></td><td>{{ LNG.shortDescription[RessID] }}</td></tr></table></tr></table>">{{ LNG.tech[RessID] }}</a>: <b><span class="{% if Element.costOverflow[RessID] == 0 %}colorPositive{% else %}colorNegative{% endif %}">{{ pretty_number(RessAmount) }}</span></b>
							{% endfor %}
							
							{% if Element.factor != null and empty(Element.requirements) and Element.buyable %}
								<span class="colorNeutral tooltip" data-tooltip-content="{{ LNG.sys_catchup_tooltip }}"><br>{{ sprintf(LNG.sys_catchup_short, Element.factor) }} %</span>
							{% endif %}
						</span>
						<br><br>
						{% if vacation %}
							<span class="colorNeutral">{{ LNG.op_options_vacation_activated }}</span>
						{% elseif not empty(Element.requirements) %}
							<span class="colorNeutral">{{ LNG.bd_requirements }}</span>
						{% elseif Element.maxLevel == Element.levelToBuild %}
							<span class="colorNeutral">{{ LNG.bd_maxlevel }}</span>
						{% elseif IsLabinBuild %}
							<span class="colorNeutral">{{ LNG.sys_buildlist_fail }}</span>
						{% elseif IsFullQueue %}
							<span class="colorNeutral">{{ LNG.bd_researclist_full }}</span>
						{% elseif not Element.buyable %}
							<span class="colorNeutral">{{ LNG.bd_remaining }}</span>
						{% else %}
							<form action="game?page=research" method="post" class="build_form">
								<input type="hidden" name="cmd" value="insert">
								<input type="hidden" name="tech" value="{{ ID }}">
								<button type="submit" class="colorPositive build_submit">{% if Element.level == 0 and Element.levelToBuild == 0 %}{{ LNG.bd_tech }}{% else %}{{ LNG.bd_tech_next_level }}{{ Element.levelToBuild + 1 }}{% endif %}</button>
							</form>
						{% endif %}
						</br>
						{{ LNG.fgf_time }}
						<span class="statictime" timestamp="{{ Element.elementTime }}"></span>
					</div>
				</div>
			{% endif %}
		{% endfor %}
	</div>
{% endblock %}
{% block script %}{{ parent() }}
	{% if not empty(Queue) %}
		<script type="module" src="./scripts/game/research.js"></script>
	{% endif %}
	<script>
		onPageInit(function() {
			var labs = {
				lab1: ['#t108', '#t113', '#t114', '#t123', '#t124'],
				lab2: ['#t109', '#t106', '#t110', '#t111', '#t120', '#t121', '#t122', '#t199'],
				lab3: ['#t114', '#t115', '#t117', '#t118'],
				lab4: ['#t131', '#t132', '#t133'],
				lab5: null
			};
			Object.keys(labs).forEach(function(id) {
				document.getElementById(id)?.addEventListener('click', function() {
					document.querySelectorAll('.infos').forEach(function(el) {
						el.style.display = labs[id] ? 'none' : '';
					});
					if (labs[id]) {
						document.querySelectorAll(labs[id].join(', ')).forEach(function(el) { el.style.display = ''; });
					}
					Object.keys(labs).forEach(function(other) {
						document.getElementById(other)?.classList.toggle('selected', other === id);
					});
				});
			});
		});
	</script>
{% endblock %}