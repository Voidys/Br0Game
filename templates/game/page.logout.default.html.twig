{% extends layout_template %}
{% block title %}{{ LNG.lm_logout }}{{ parent() }}{% endblock %}
{% block content %}<table>
	<tr>
		<th>{{ LNG.lo_title }}</th>
		</tr>
	<tr>
		<td>{{ LNG.lo_logout }}</td>
	</tr>
</table>
<br><br>
<table>
<tr>
	<th>{{ LNG.lo_redirect }}</th>
</tr>
<tr>
	<td>{{ LNG.lo_notify }}<br><a href="./">{{ LNG.lo_continue }}</a></td>
</tr>
</table>
{% endblock %}
{% block script %}{{ parent() }}
<script type="text/javascript">
    var second = 5;
	function Countdown(){
		if(second == 0)
			return;
			
		second--;
		document.getElementById('seconds').textContent = second;
	}
	window.setTimeout("window.location.href='./'", 5000);
	window.setInterval("Countdown()", 1000);
</script>
{% endblock %}