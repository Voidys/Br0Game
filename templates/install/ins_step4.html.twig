{% extends 'install/ins_layout.html.twig' %}
{% block heading %}{{ LNG.ins_step_database }}{% endblock %}
{% block panel %}
  {% include 'install/ins_checks.html.twig' %}
  {% if passed %}
    <div class="notice notice--success">{{ icon('circle-check') }}<div>{{ LNG.step2_db_done }}</div></div>
    <div class="install-actions"><a class="button btn--primary" href="./?mode=install&amp;step=5">{{ LNG.continue }}</a></div>
  {% else %}
    <div class="install-actions"><a class="button btn--primary" href="./?{{ back|e('html_attr') }}">{{ LNG.back }}</a></div>
  {% endif %}
{% endblock %}
