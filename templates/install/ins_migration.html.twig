{% extends 'install/ins_layout.html.twig' %}
{% block heading %}{{ LNG.upgrade_title }}{% endblock %}
{% block panel %}
  <p>{{ LNG.upgrade_message_admin }}</p>
  <p>{{ LNG.upgrade_message_user }}</p>
  <form class="install-form" action="?mode=upgrade" method="POST">
    <fieldset>
      <label class="install-field install-field--wide">{{ LNG.step1_mysql_migrationpass|trim(':') }}<input type="password" name="migrationpw" autocomplete="current-password"></label>
    </fieldset>
    <div class="install-actions">
      <button type="submit" class="btn--primary">{{ LNG.continueUpgrade }}</button>
      <a class="button" href="../game">{{ LNG.upgrade_return }}</a>
    </div>
  </form>
{% endblock %}
