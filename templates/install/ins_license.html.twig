{% extends 'install/ins_layout.html.twig' %}
{% block heading %}{{ LNG.licence_head }}{% endblock %}
{% block panel %}
  <p>{{ LNG.licence_desc }}</p>
  <pre class="install-licence" tabindex="0">{{ licenceText|e }}</pre>
  <form class="install-form" action="./?mode=install&amp;step=1" method="post">
    <input type="hidden" name="post" value="1">
    <label class="install-check"><input type="checkbox" name="accept" required> {{ LNG.licence_accept }}</label>
    {% if accept is defined %}
      <div class="notice notice--danger" role="alert">{{ icon('circle-alert') }}<div>{{ LNG.licence_need_accept }}</div></div>
    {% endif %}
    <div class="install-actions">
      <a class="button" href="./">{{ LNG.back }}</a>
      <button type="submit" class="btn--primary">{{ LNG.continue }}</button>
    </div>
  </form>
{% endblock %}
