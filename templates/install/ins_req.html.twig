{% extends 'install/ins_layout.html.twig' %}
{% block heading %}{{ LNG.ins_step_requirements }}{% endblock %}
{% block panel %}
  <p>{{ LNG.req_desc }}</p>
  {% include 'install/ins_checks.html.twig' %}
  <div class="install-actions">
    <a class="button" href="./?mode=install&amp;step=1">{{ LNG.back }}</a>
    {% if passed %}
      <a class="button btn--primary" href="./?mode=install&amp;step=3">{{ LNG.continue }}</a>
    {% else %}
      <a class="button" href="./?mode=install&amp;step=2">{{ icon('refresh-cw') }}{{ LNG.ins_recheck }}</a>
    {% endif %}
  </div>
{% endblock %}
