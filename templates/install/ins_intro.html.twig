{% extends 'install/ins_layout.html.twig' %}
{% block heading %}{{ LNG.intro_welcome }}{% endblock %}
{% block panel %}
  <p>{{ LNG.intro_text }}</p>
  <div class="install-actions">
    <a class="button btn--primary" href="./?mode=install&amp;step=1">{{ icon('rocket') }}{{ LNG.intro_install }}</a>
  </div>
  {% if canUpgrade %}
    <div class="install-upgrade">
      <h2>{{ LNG.intro_upgrade_head }}</h2>
      <p>{{ LNG.intro_upgrade_text }}</p>
      <a class="button" href="./?mode=upgrade">{{ LNG.continueUpgrade }}</a>
    </div>
  {% endif %}
{% endblock %}
