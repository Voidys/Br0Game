{% include 'admin/overall_header.html.twig' %}
<form action="admin?page=support&amp;mode=send" method="post" id="form" class="stack">
  <input type="hidden" name="id" value="0">
  <section class="card">
    <header class="card__head"><h2 class="card__title">{{ icon('ticket') }}{{ LNG.ti_create_head }}</h2></header>
    <div class="card__body">
      <div class="notice notice--info">{{ icon('info') }}<div>{{ LNG.ti_create_info }}</div></div>
      <div class="form-grid">
        <div class="field-row">
          <label for="category">{{ LNG.ti_category }}</label>
          <div class="field-control"><select id="category" name="category">{{ html_options({'options': categoryList}) }}</select></div>
        </div>
        <div class="field-row">
          <label for="subject">{{ LNG.ti_subject }}</label>
          <div class="field-control"><input type="text" required id="subject" name="subject" maxlength="255"></div>
        </div>
        <div class="field-row">
          <label for="message">{{ LNG.ti_message }}</label>
          <div class="field-control"><textarea required id="message" name="message" rows="6"></textarea></div>
        </div>
      </div>
    </div>
    <footer class="card__foot"><button type="submit" class="btn--primary">{{ icon('send') }}{{ LNG.ti_submit }}</button></footer>
  </section>
</form>
{% include 'admin/overall_footer.html.twig' %}
