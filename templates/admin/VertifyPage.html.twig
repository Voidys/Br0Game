{% include 'admin/overall_header.html.twig' %}
<div class="stack">
  <div class="notice notice--info">{{ icon('info') }}<div>{{ LNG.vt_info }}</div></div>
  <section class="card">
    <header class="card__head"><h2 class="card__title">{{ icon('shield-check') }}{{ LNG.vt_head }}</h2></header>
    <div class="card__body">
      <div class="toolbar">
        <a class="button" href="admin?page=vertify&amp;action=vertify&amp;ext=php">{{ LNG.vt_filephp }}</a>
        <a class="button" href="admin?page=vertify&amp;action=vertify&amp;ext=tpl">{{ LNG.vt_filetpl }}</a>
        <a class="button" href="admin?page=vertify&amp;action=vertify&amp;ext=css">{{ LNG.vt_filecss }}</a>
        <a class="button" href="admin?page=vertify&amp;action=vertify&amp;ext=js">{{ LNG.vt_filejs }}</a>
        <a class="button" href="admin?page=vertify&amp;action=vertify&amp;ext=png|jpg|gif">{{ LNG.vt_fileimg }}</a>
        <a class="button" href="admin?page=vertify&amp;action=vertify&amp;ext=htaccess">{{ LNG.vt_filehtaccess }}</a>
        <a class="button btn--primary" href="admin?page=vertify&amp;action=vertify&amp;ext=php|tpl|js|css|png|jpg|gif|htaccess">{{ LNG.vt_all }}</a>
      </div>
    </div>
  </section>
</div>
{% include 'admin/overall_footer.html.twig' %}
