{% import '_macros/forms.html.twig' as forms -%}
{% include 'admin/overall_header.html.twig' %}
<form name="message" id="message" action="admin?page=sendMessages&amp;action=send&amp;ajax=1" class="stack" data-empty-text="{{ LNG.mg_empty_text|e('html_attr') }}" data-confirm-text="{{ LNG.ma_send_global_message|e('html_attr') }}">
  <div class="cols cols--wide-left">
    <section class="card">
      <header class="card__head"><h2 class="card__title">{{ icon('megaphone') }}{{ LNG.ma_send_global_message }}</h2></header>
      <div class="card__body">
        <div class="form-grid">
          <div class="field-row">
            <label for="subject">{{ LNG.ma_subject }}</label>
            <div class="field-control"><input name="subject" id="subject" maxlength="40" value="{{ LNG.ma_none }}" type="text"></div>
          </div>
          <div class="field-row">
            <label for="text">{{ LNG.ma_message }} (<span id="cntChars">0</span> / 5000 {{ LNG.ma_characters }})</label>
            <div class="field-control">
              <textarea name="text" id="text" rows="10" data-count-chars="#cntChars"></textarea>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="card">
      <header class="card__head"><h2 class="card__title">{{ icon('users') }}{{ LNG.adm_ma_recipients }}</h2></header>
      <div class="card__body">
        <div class="stack">
          <div class="fields">
            <div class="field">
              <label for="ma-mode">{{ LNG.ma_mode }}</label>
              {{ forms.html_options({'name': 'mode', 'id': 'ma-mode', 'options': modes}) }}
            </div>
            <div class="field">
              <label for="ma-universe">{{ LNG.log_universe }}</label>
              {{ forms.html_options({'name': 'globalmessageuniverse', 'id': 'ma-universe', 'options': universeSelector}) }}
            </div>
            <div class="field">
              <label for="ma-lang">{{ LNG.se_lang }}</label>
              {{ forms.html_options({'name': 'globalmessagelang', 'id': 'ma-lang', 'options': langSelector}) }}
            </div>
          </div>
          <div class="notice notice--info">{{ icon('info') }}<div><strong>{{ LNG.adm_ma_recipients }}:</strong> <span id="ma-summary"></span></div></div>
        </div>
      </div>
    </section>
  </div>
  <div class="form-actions"><button type="submit" class="btn--primary">{{ icon('send') }}{{ LNG.button_submit }}</button></div>
</form>
<script type="module" src="./scripts/admin/pages/sendMessages.js?v={{ asset_version }}"></script>
{% include 'admin/overall_footer.html.twig' %}
