{% include 'admin/overall_header.html.twig' %}
{% macro option(name, label) %}
  <label class="check"><input type="checkbox" name="{{ name }}">{{ label }}</label>
{% endmacro %}
{% import _self as ui %}
<form action="" method="post" class="stack">
  <div class="notice notice--danger" role="alert">
    {{ icon('triangle-alert') }}
    <div>
      <strong>{{ LNG.re_reset_universe }}</strong>
      <p>{{ LNG.adm_reset_warning }}</p>
    </div>
  </div>

  <div class="grid">
    <section class="card card--danger">
      <header class="card__head"><h2 class="card__title">{{ icon('users') }}{{ re_player_and_planets }}</h2></header>
      <div class="card__body stack">
        {{ ui.option('players', re_reset_player) }}
        {{ ui.option('planets', re_reset_planets) }}
        {{ ui.option('moons', re_reset_moons) }}
      </div>
    </section>
    <section class="card card--danger">
      <header class="card__head"><h2 class="card__title">{{ icon('rocket') }}{{ re_defenses_and_ships }}</h2></header>
      <div class="card__body stack">
        {{ ui.option('defenses', re_defenses) }}
        {{ ui.option('ships', re_ships) }}
        {{ ui.option('h_d', re_reset_hangar) }}
      </div>
    </section>
    <section class="card card--danger">
      <header class="card__head"><h2 class="card__title">{{ icon('building-2') }}{{ re_buldings }}</h2></header>
      <div class="card__body stack">
        {{ ui.option('edif_p', re_buildings_pl) }}
        {{ ui.option('edif_l', re_buildings_lu) }}
        {{ ui.option('edif', re_reset_buldings) }}
      </div>
    </section>
    <section class="card card--danger">
      <header class="card__head"><h2 class="card__title">{{ icon('flask-conical') }}{{ re_inve }}</h2></header>
      <div class="card__body stack">
        {{ ui.option('inves', re_investigations) }}
        {{ ui.option('inves_c', re_reset_invest) }}
      </div>
    </section>
    <section class="card card--danger">
      <header class="card__head"><h2 class="card__title">{{ icon('database') }}{{ re_resources }}</h2></header>
      <div class="card__body stack">
        {{ ui.option('resources', re_resources_met_cry) }}
      </div>
    </section>
    <section class="card card--danger">
      <header class="card__head"><h2 class="card__title">{{ icon('layers') }}{{ re_general }}</h2></header>
      <div class="card__body stack">
        {{ ui.option('notes', re_reset_notes) }}
        {{ ui.option('rw', re_reset_rw) }}
        {{ ui.option('friends', re_reset_buddies) }}
        {{ ui.option('alliances', re_reset_allys) }}
        {{ ui.option('fleets', re_reset_fleets) }}
        {{ ui.option('banneds', re_reset_banned) }}
        {{ ui.option('messages', re_reset_messages) }}
        {{ ui.option('statpoints', re_reset_statpoints) }}
      </div>
    </section>
  </div>

  <div class="form-actions">
    <label class="check form-actions__hint"><input type="checkbox" name="resetall" data-check-all><strong>{{ re_reset_all }}</strong></label>
    <button data-confirm="{{ re_reset_universe_confirmation|e('html_attr') }}" type="submit" class="btn--danger">{{ icon('triangle-alert') }}{{ LNG.re_reset_universe }}</button>
  </div>
</form>
{% include 'admin/overall_footer.html.twig' %}
