{% include 'admin/overall_header.html.twig' %}
<div class="stack">
  <div class="notice notice--info">{{ icon('info') }}<div>{{ LNG.adm_ae_menu_hint }}</div></div>
  <div class="cols">
    <section class="card">
      <header class="card__head"><h2 class="card__title">{{ LNG.adm_ae_group_player }}</h2></header>
      <div class="card__body">
        <div class="quick-links">
          <a class="quick-link" href="?page=accountEditor&amp;edit=personal">{{ icon('user') }}<span>{{ LNG.ad_editor_personal }}</span></a>
          <a class="quick-link" href="?page=accountEditor&amp;edit=researchs">{{ icon('flask-conical') }}<span>{{ LNG.ad_editor_researchs }}</span></a>
          <a class="quick-link" href="?page=accountEditor&amp;edit=alliances">{{ icon('handshake') }}<span>{{ LNG.ad_editor_alliances }}</span></a>
