          <a class="quick-link" href="?page=accountEditor&amp;edit=ships">{{ icon('rocket') }}<span>{{ LNG.ad_editor_ships }}</span></a>
          <a class="quick-link" href="?page=accountEditor&amp;edit=defenses">{{ icon('shield') }}<span>{{ LNG.ad_editor_defenses }}</span></a>
