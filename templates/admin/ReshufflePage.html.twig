{% import '_macros/forms.html.twig' as forms -%}
{% include 'admin/overall_header.html.twig' %}
<form name="message" id="message" action="admin?page=reshuffle&amp;action=send&amp;ajax=1" class="stack">
  <section class="card card--danger">
    <header class="card__head"><h2 class="card__title">{{ icon('shuffle') }}{{ LNG.rp_header }}</h2></header>
    <div class="card__body stack">
      <div class="notice notice--warning">{{ icon('triangle-alert') }}<div>{{ LNG.rp_explain }}</div></div>
      <div class="form-grid">
        <div class="field-row">
          <label for="universe">{{ LNG.uni_reg }}</label>
          <div class="field-control">{{ forms.html_options({'name': 'universe', 'options': universes}) }}</div>
        </div>
      </div>
    </div>
    <footer class="card__foot">
      <button type="submit" class="btn--danger" data-confirm-danger data-confirm="">{{ icon('shuffle') }}{{ LNG.button_submit }}</button>
    </footer>
  </section>
</form>
<script type="module" src="./scripts/admin/pages/reshuffle.js?v={{ asset_version }}"></script>
{% include 'admin/overall_footer.html.twig' %}
