{% include 'admin/overall_header.html.twig' %}
{% macro player(id, name) %}<a href="admin?page=accountData&amp;id_u={{ id }}">{{ name }}</a>{% endmacro %}
{% macro links(row) %}
  {% if row.ip %}<span class="badge badge--danger">{{ LNG.abuse_link_ip }}</span>{% endif %}
  {% if row.device %}<span class="badge badge--danger">{{ LNG.abuse_link_device }}</span>{% endif %}
  {% if row.multi %}<span class="badge {{ row.multiKnown ? 'badge--muted' : 'badge--warn' }}">{{ row.multiKnown ? LNG.abuse_link_multi_known : LNG.abuse_link_multi }}</span>{% endif %}
  {% if row.subnet %}<span class="badge badge--muted">{{ LNG.abuse_link_subnet }}</span>{% endif %}
  {% if not row.ip and not row.device and not row.multi and not row.subnet %}<span class="muted">-</span>{% endif %}
{% endmacro %}
<div class="stack">
  <form action="" method="get" class="card">
    <div class="card__body">
      <div class="toolbar">
        <input type="hidden" name="page" value="abuseReport">
        <div class="field field--fixed-8">
          <label for="abuse-days">{{ LNG.abuse_days }}</label>
          <input id="abuse-days" type="number" name="days" min="1" max="{{ maxDays }}" value="{{ days }}">
        </div>
        <button type="submit" class="btn--primary">{{ icon('search') }}{{ LNG.abuse_apply }}</button>
        <span class="toolbar__spacer"></span>
        <span class="muted small">{{ LNG.abuse_weights }}: 1 : {{ report.weights.crystal|number_format(2) }} : {{ report.weights.deuterium|number_format(2) }}</span>
      </div>
    </div>
  </form>

  <p class="muted small">{{ LNG.format('abuse_thresholds', minTransfer, returnShare ~ ' %', minTrades, outlierPercent ~ ' %') }}</p>

  <section class="card">
    <header class="card__head">
      <h2 class="card__title">{{ icon('arrow-left-right') }}{{ LNG.abuse_transfers }}</h2>
      <div class="card__actions"><span class="badge badge--muted">{{ report.transfers|length }}</span></div>
    </header>
    <div class="card__body">
      <p class="muted small">{{ LNG.format('abuse_transfers_info', minTransfer, returnShare ~ ' %') }}</p>
    </div>
    <div class="card__body">
      {% if report.transfers %}
      <div class="table-wrap">
        <table class="data data--compact">
          <thead><tr>
            <th>{{ LNG.abuse_from }}</th><th>{{ LNG.abuse_to }}</th><th class="num">{{ LNG.abuse_count }}</th>
            <th class="num">{{ LNG.abuse_sent }}</th><th class="num">{{ LNG.abuse_back }}</th><th class="num">{{ LNG.abuse_net }}</th>
            <th>{{ LNG.abuse_linked }}</th><th>{{ LNG.abuse_last }}</th>
          </tr></thead>
          <tbody>
            {% for row in report.transfers %}
            <tr>
              <td>{{ _self.player(row.from, row.fromName) }}</td>
              <td>{{ _self.player(row.to, row.toName) }}</td>
              <td class="num">{{ row.count }}</td>
              <td class="num">{{ pretty_number(row.sent) }}</td>
              <td class="num">{{ pretty_number(row.back) }} <span class="muted small">({{ row.backCount }})</span></td>
              <td class="num"><strong>{{ pretty_number(row.net) }}</strong></td>
              <td>{{ _self.links(row) }}</td>
              <td class="nowrap">{{ row.lastDate }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <div class="empty">{{ icon('arrow-left-right') }}<p>{{ LNG.abuse_none }}</p></div>
      {% endif %}
    </div>
  </section>

  <section class="card">
    <header class="card__head">
      <h2 class="card__title">{{ icon('shuffle') }}{{ LNG.abuse_trades }}</h2>
      <div class="card__actions"><span class="badge badge--muted">{{ report.trades|length }}</span></div>
    </header>
    <div class="card__body">
      <p class="muted small">{{ LNG.format('abuse_trades_info', minTrades, outlierPercent ~ ' %') }}</p>
    </div>
    <div class="card__body">
      {% if report.trades %}
      <div class="table-wrap">
        <table class="data data--compact">
          <thead><tr>
            <th>{{ LNG.abuse_giver }}</th><th>{{ LNG.abuse_receiver }}</th><th class="num">{{ LNG.abuse_count }}</th>
            <th class="num">{{ LNG.abuse_net }}</th><th class="num">{{ LNG.abuse_ratio }}</th>
            <th>{{ LNG.abuse_linked }}</th><th>{{ LNG.abuse_last }}</th>
          </tr></thead>
          <tbody>
            {% for row in report.trades %}
            <tr>
              <td>{{ _self.player(row.giver, row.giverName) }}</td>
              <td>{{ _self.player(row.receiver, row.receiverName) }}</td>
              <td class="num">{{ row.count }}</td>
              <td class="num">{{ pretty_number(row.net) }}</td>
              <td class="num">
                {% if row.ratio is null %}n/a{% else %}{{ row.ratio|number_format(2) }}{% endif %}
                {% if row.outlier %}<span class="badge badge--warn">{{ LNG.abuse_outlier }}</span>{% endif %}
              </td>
              <td>{{ _self.links(row) }}</td>
              <td class="nowrap">{{ row.lastDate }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <div class="empty">{{ icon('shuffle') }}<p>{{ LNG.abuse_none }}</p></div>
      {% endif %}
    </div>
  </section>

  <section class="card">
    <header class="card__head">
      <h2 class="card__title">{{ icon('shield') }}{{ LNG.abuse_protections }}</h2>
      <div class="card__actions"><span class="badge badge--muted">{{ report.protections|length }}</span></div>
    </header>
    <div class="card__body">
      <p class="muted small">{{ LNG.abuse_protections_info }}</p>
    </div>
    <div class="card__body">
      {% if report.protections %}
      <div class="table-wrap">
        <table class="data data--compact">
          <thead><tr>
            <th>{{ LNG.abuse_protected }}</th><th>{{ LNG.abuse_granted }}</th><th>{{ LNG.abuse_opponents }}</th>
            <th class="num">{{ LNG.abuse_loot }}</th><th>{{ LNG.abuse_linked }}</th><th>{{ LNG.abuse_report }}</th>
          </tr></thead>
          <tbody>
            {% for row in report.protections %}
            <tr>
              <td>{{ _self.player(row.user, row.name) }}</td>
              <td class="nowrap">{{ row.grantedDate }}</td>
              <td>
                {% for o in row.opponents %}
                  {{ _self.player(o.id, o.name) }}{% if o.ip or o.multi %} <span class="badge {{ o.ip or not o.multiKnown ? 'badge--danger' : 'badge--muted' }}">{{ LNG.abuse_linked }}</span>{% elseif o.subnet %} <span class="badge badge--muted">{{ LNG.abuse_link_subnet }}</span>{% endif %}{% if not loop.last %}, {% endif %}
                {% else %}<span class="muted">-</span>{% endfor %}
              </td>
              <td class="num">{{ pretty_number(row.loot) }}</td>
              <td>
                {% if row.linked %}<span class="badge {{ row.linkedKnown ? 'badge--muted' : 'badge--danger' }}">{{ LNG.abuse_linked }}</span>{% else %}<span class="muted">-</span>{% endif %}
              </td>
              <td>{% if row.report %}<a href="CombatReport?raport={{ row.report }}" target="_blank" rel="noopener">{{ icon('external-link') }}</a>{% else %}<span class="muted">-</span>{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <div class="empty">{{ icon('shield') }}<p>{{ LNG.abuse_none }}</p></div>
      {% endif %}
    </div>
  </section>

  <section class="card">
    <header class="card__head">
      <h2 class="card__title">{{ icon('arrow-left') }}{{ LNG.abuse_recalls }}</h2>
      <div class="card__actions"><span class="badge badge--muted">{{ report.recalls|length }}</span></div>
    </header>
    <div class="card__body">
      <p class="muted small">{{ LNG.abuse_recalls_info }}</p>
    </div>
    <div class="card__body">
      {% if report.recalls %}
      <div class="table-wrap">
        <table class="data data--compact">
          <thead><tr>
            <th>{{ LNG.abuse_from }}</th><th>{{ LNG.abuse_to }}</th><th>{{ LNG.abuse_mission }}</th>
            <th>{{ LNG.abuse_arrival }}</th><th>{{ LNG.abuse_recalled }}</th><th class="num">{{ LNG.abuse_late }}</th>
          </tr></thead>
          <tbody>
            {% for row in report.recalls %}
            <tr>
              <td>{{ _self.player(row.owner, row.owner_name) }}</td>
              <td>{{ _self.player(row.target_owner, row.target_owner_name) }}</td>
              <td>{{ LNG['abuse_mission_' ~ row.mission] }}</td>
              <td class="nowrap">{{ row.arrivalDate }}</td>
              <td class="nowrap">{{ row.stayDate }}</td>
              <td class="num">{{ row.late }} s{% if row.fought %} <span class="badge badge--warn">{{ LNG.abuse_fought }}</span>{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <div class="empty">{{ icon('arrow-left') }}<p>{{ LNG.abuse_none }}</p></div>
      {% endif %}
    </div>
    <div class="card__body"><p class="muted small">{{ LNG.abuse_missiles_skipped }}</p></div>
  </section>

  <section class="card">
    <header class="card__head">
      <h2 class="card__title">{{ icon('network') }}{{ LNG.abuse_graph }}</h2>
      <div class="card__actions"><span class="badge badge--muted">{{ report.graph|length }}</span></div>
    </header>
    <div class="card__body">
      <p class="muted small">{{ LNG.format('abuse_graph_info', graphDays, graphMinValue, graphMinFlows, graphMaxClusters) }}</p>
    </div>
    <div class="card__body">
      {% if report.graph %}
      <div class="table-wrap">
        <table class="data data--compact">
          <thead><tr>
            <th>{{ LNG.abuse_members }}</th><th class="num">{{ LNG.abuse_value }}</th><th class="num">{{ LNG.abuse_flows }}</th>
            <th>{{ LNG.abuse_top_edge }}</th>
          </tr></thead>
          <tbody>
            {% for cluster in report.graph %}
            <tr>
              <td>
                {% for m in cluster.members %}
                  <div>{{ _self.player(m.id, m.name) }} {{ _self.links(m) }}</div>
                {% endfor %}
              </td>
              <td class="num"><strong>{{ pretty_number(cluster.value) }}</strong></td>
              <td class="num">{{ cluster.flows }}</td>
              <td>
                {{ _self.player(cluster.top.from, cluster.top.fromName) }} &rarr; {{ _self.player(cluster.top.to, cluster.top.toName) }}
                <span class="muted small">{{ pretty_number(cluster.top.net) }} ({{ (cluster.top.share * 100)|round }} %)</span>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <div class="empty">{{ icon('network') }}<p>{{ LNG.abuse_none }}</p></div>
      {% endif %}
    </div>
  </section>

  <section class="card">
    <header class="card__head">
      <h2 class="card__title">{{ icon('activity') }}{{ LNG.abuse_activity }}</h2>
      <div class="card__actions"><span class="badge badge--muted">{{ report.activity|length }}</span></div>
    </header>
    <div class="card__body">
      <p class="muted small">{{ LNG.abuse_activity_info }}</p>
    </div>
    <div class="card__body">
      {% if report.activity %}
      <div class="table-wrap">
        <table class="data data--compact">
          <thead><tr>
            <th>{{ LNG.abuse_player }}</th><th class="num">{{ LNG.abuse_launches }}</th><th class="num">{{ LNG.abuse_peak }}</th>
          </tr></thead>
          <tbody>
            {% for row in report.activity %}
            <tr>
              <td>{{ _self.player(row.id, row.name) }}</td>
              <td class="num">{{ row.launches }}</td>
              <td class="num">{{ row.peak }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <div class="empty">{{ icon('activity') }}<p>{{ LNG.abuse_none }}</p></div>
      {% endif %}
    </div>
  </section>
</div>
{% include 'admin/overall_footer.html.twig' %}
