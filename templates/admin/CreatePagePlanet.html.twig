{% include 'admin/overall_header.html.twig' %}
<div class="stack">
  {% include 'admin/CreateTabs.html.twig' with {'createMode': 'planet'} %}
  <form action="" method="post" class="card">
    <input type="hidden" name="mode" value="agregar">
    <header class="card__head"><h2 class="card__title">{{ icon('globe') }}{{ po_add_planet }}</h2></header>
    <div class="card__body stack">
      <div class="fields">
        <div class="field"><label for="c-id">{{ input_id_user }}</label><input id="c-id" name="id" type="text" inputmode="numeric"></div>
        <div class="field"><label for="c-name">{{ po_name_planet }}</label><input id="c-name" name="name" type="text" maxlength="25" value="{{ po_colony }}"></div>
        <div class="field"><label for="c-fields">{{ po_fields_max }}</label><input id="c-fields" name="field_max" type="text" maxlength="10" inputmode="numeric"></div>
      </div>
      <div class="fields">
        <div class="field"><label for="c-galaxy">{{ new_creator_coor }}: {{ po_galaxy }}</label><input id="c-galaxy" name="galaxy" type="text" maxlength="1" inputmode="numeric"></div>
        <div class="field"><label for="c-system">{{ po_system }}</label><input id="c-system" name="system" type="text" maxlength="3" inputmode="numeric"></div>
        <div class="field"><label for="c-planet">{{ LNG.adm_coord_position }}</label><input id="c-planet" name="planet" type="text" maxlength="2" inputmode="numeric"></div>
      </div>
    </div>
    <footer class="card__foot"><button type="submit" class="btn--primary">{{ icon('plus') }}{{ button_add }}</button></footer>
  </form>
</div>
{% include 'admin/overall_footer.html.twig' %}
