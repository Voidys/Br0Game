{% include 'admin/overall_header.html.twig' %}
<div class="stack">
  {% if Messages or cronWarning %}
    <div class="notice notice--danger" role="alert">
      {{ icon('triangle-alert') }}
      <div>
        <strong>{{ LNG.adm_dash_attention }}</strong>
        <ul>
          {% if cronWarning %}<li>{{ cronWarning }} <a href="{{ cronDocsUrl|e('html_attr') }}" target="_blank" rel="noopener">{{ LNG.adm_dash_cron_help }}</a></li>{% endif %}
          {% for Message in Messages %}<li>{{ Message }}</li>{% endfor %}
        </ul>
      </div>
    </div>
  {% else %}
    <div class="notice notice--success">{{ icon('circle-check') }}<div>{{ LNG.adm_dash_all_good }}</div></div>
  {% endif %}
  {% if update and update.newer %}
    <div class="notice notice--info" role="status">
      {{ icon('rocket') }}
      <div>
        <strong>{{ LNG.adm_update_available }}: {{ update.latest }}{% if update.publishedText %} ({{ LNG.adm_update_released }} {{ update.publishedText }}){% endif %}</strong> — {{ LNG.adm_update_you_run }} {{ update.current }}{% if gitVersion %} <span class="muted">(git {{ gitVersion }})</span>{% endif %}
        {% if update.notes %}<p class="muted small">{{ update.notes }}</p>{% endif %}
        <p>
          <a href="{{ update.url|e('html_attr') }}" target="_blank" rel="noopener">{{ LNG.adm_update_notes }}</a> ·
          <a href="{{ updateDocsUrl|e('html_attr') }}" target="_blank" rel="noopener">{{ LNG.adm_update_howto }}</a>
        </p>
        <form method="post" action="{{ path('admin_overview_update_check') }}"><button type="submit" class="btn btn--small">{{ icon('refresh-cw') }} {{ LNG.adm_update_check_now }}</button></form>
      </div>
    </div>
  {% endif %}
  {% if unprotected %}
    <div class="notice notice--warning" role="alert">
      {{ icon('triangle-alert') }}
      <div>
        <strong>{{ LNG.adm_dash_unprotected }}</strong>
        <ul>
          {% for line in unprotected %}<li>{{ line }}</li>{% endfor %}
        </ul>
      </div>
    </div>
  {% endif %}

  <div class="stats">
    <a class="stat" href="{{ path('admin_search_show', {search: 'online'}) }}">
      <span class="stat__label">{{ icon('wifi') }}{{ LNG.adm_dash_online }}</span>
      <span class="stat__value">{{ pretty_number(stats.online) }}</span>
    </a>
    <a class="stat" href="{{ path('admin_search_show', {search: 'users'}) }}">
      <span class="stat__label">{{ icon('users') }}{{ LNG.adm_dash_players }}</span>
      <span class="stat__value">{{ pretty_number(stats.players) }}</span>
    </a>
    <a class="stat{% if adminOpenTickets > 0 %} stat--alert{% endif %}" href="{{ path('admin_support_show') }}">
      <span class="stat__label">{{ icon('ticket') }}{{ LNG.adm_dash_tickets }}</span>
      <span class="stat__value">{{ pretty_number(adminOpenTickets) }}</span>
    </a>
    <a class="stat" href="{{ path('admin_flying_fleet_show') }}">
      <span class="stat__label">{{ icon('send') }}{{ LNG.adm_dash_fleets }}</span>
      <span class="stat__value">{{ pretty_number(stats.fleets) }}</span>
    </a>
  </div>

  <div class="cols cols--wide-left">
    <section class="card">
      <header class="card__head"><h2 class="card__title">{{ icon('layout-dashboard') }}{{ LNG.adm_dash_quick }}</h2></header>
      <div class="card__body">
        {% set quickPages = ['search', 'accountData', 'ban', 'support', 'messageList', 'log', 'giveaway', 'clearCache'] %}
        <div class="quick-links">
          {% for group in adminMenu %}
            {% for item in group.items %}
              {% set itemPage = item.page %}
              {% if itemPage in quickPages %}
                <a class="quick-link" href="{{ item.href }}">{{ icon(item.icon) }}<span>{{ item.label }}</span>{% if item.badge %}<span class="admin-nav__badge">{{ item.badge }}</span>{% endif %}</a>
              {% endif %}
            {% endfor %}
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="card">
      <header class="card__head"><h2 class="card__title">{{ icon('server') }}{{ LNG.adm_dash_system }}</h2></header>
      <div class="card__body">
        <dl class="kv">
          <dt>{{ LNG.adm_dash_version }}</dt><dd class="mono">{{ system.version }}</dd>
          {% if update and not update.newer %}<dt>{{ LNG.adm_update_check }}</dt><dd><span class="badge badge--ok">{{ LNG.adm_update_up_to_date }}</span> <span class="muted small">{{ update.checkedText }}</span>
            <form method="post" action="{{ path('admin_overview_update_check') }}" class="inline"><button type="submit" class="btn btn--small">{{ icon('refresh-cw') }} {{ LNG.adm_update_check_now }}</button></form></dd>{% endif %}
          <dt>{{ LNG.adm_dash_php }}</dt><dd class="mono">{{ system.php }}</dd>
          <dt>{{ LNG.adm_dash_uni_status }}</dt>
          <dd><span class="badge {{ system.uniStatusOpen ? 'badge--ok' : 'badge--warn' }}">{{ system.uniStatus }}</span></dd>
          <dt>{{ LNG.adm_dash_next_cron }}</dt>
          <dd>{% if system.nextCron %}{{ system.nextCron.name }} <span class="muted">· {{ nextCronTime }}</span>{% else %}–{% endif %}<br><span class="muted small">{{ system.cronjobs }} {{ LNG.adm_dash_cron_count }}</span></dd>
        </dl>
      </div>
      <footer class="card__foot">
        <a href="https://github.com/Voidys/V0Game" target="_blank" rel="noopener">{{ icon('external-link') }} {{ LNG.adm_dash_project }}</a>
      </footer>
    </section>
  </div>

  <details class="card disclosure">
    <summary class="card__head"><h2 class="card__title">{{ icon('heart') }}{{ LNG.adm_dash_credits }}</h2></summary>
    <div class="card__body cols">
      <div>
        <h3 class="small muted">{{ LNG.ow_proyect_leader }}</h3>
        <p><a href="https://github.com/jkroepke" target="_blank" rel="noopener">Jan</a></p>
        <h3 class="small muted">{{ LNG.ow_translator }}</h3>
        <dl class="kv">
          <dt>English, Português</dt><dd>QwataKayean</dd>
          <dt>Français</dt><dd><a href="https://github.com/BigTwoProduction" target="_blank" rel="noopener">BigTwoProduction</a></dd>
          <dt>Русский</dt><dd>InquisitorEA</dd>
          <dt>Español</dt><dd>Orion</dd>
          <dt>Türkçe</dt><dd>romansmac</dd>
        </dl>
      </div>
      <div>
        <h3 class="small muted">{{ LNG.ow_former_pr0game_crew }}</h3>
        <dl class="kv">
          <dt>{{ LNG.ow_crew_dev }}</dt><dd>Adman (Hyman), reflexrecon, Timo_Ka, Atain, DeepNorth</dd>
          <dt>{{ LNG.ow_crew_mod }}</dt><dd>Slippy, Masterspiel</dd>
          <dt>{{ LNG.ow_crew_community }}</dt><dd>Schmopfi, Cornag, Qualle</dd>
        </dl>
        <h3 class="small muted">{{ LNG.ow_pr0game_contributors }}</h3>
        <p>AxelFLOSS, blockchaaain, havoc, Keks, Christian Witte, Oconna, Voidy, joghurtrucksack, eichhorn, Marcin, Neffez, Rosenreeman, Magglish, Fionera, unnamed1, Captain Mrgl, Hackbrett, Torge, achim</p>
        <h3 class="small muted">{{ LNG.ow_special_thanks }}</h3>
        <p><a href="https://github.com/Hilarious001" target="_blank" rel="noopener">Hilarious001</a>, Ralf M., InquisitorEA, lucky, Metusalem, Meikel, Phil, Schnippi, Vobi, Sycrog, Raito, Chlorel, e-Zobar, Flousedid, jstar, scrippi</p>
      </div>
    </div>
  </details>
</div>
{% include 'admin/overall_footer.html.twig' %}
