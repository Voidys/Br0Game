{% include 'admin/overall_header.html.twig' %}
<div class="stack">
  <section class="card card--flush">
    <header class="card__head">
      <h2 class="card__title">{{ icon('message-circle') }}{{ LNG.adm_comments }} <span class="badge badge--muted">{{ comments|length }}</span></h2>
      <div class="card__actions"><input type="search" class="table-filter" data-table-filter="#comments-table" placeholder="{{ LNG.adm_filter_page }}"></div>
    </header>
    {% if comments|length > 0 %}
    <div class="card__body">
      <div class="table-wrap">
        <table class="data" id="comments-table" data-sortable>
          <thead>
            <tr>
              <th class="num">{{ LNG.input_id_user }}</th>
              <th>{{ LNG.ac_name }}</th>
              <th>{{ LNG.ac_alliance }}</th>
              <th>{{ LNG.adm_comment_col }}</th>
              <th>{{ LNG.adm_info_col }}</th>
              <th>{{ LNG.an_timestamp }}</th>
            </tr>
          </thead>
          <tbody>
            {% for Users in comments %}
            <tr>
              <td class="num">{{ Users.user_id }}</td>
              <td><a href="admin?page=accountData&amp;id_u={{ Users.user_id }}">{{ Users.username }}</a></td>
              <td>{{ Users.ally_name }}</td>
              <td class="break">{{ Users.comment }}</td>
              <td class="break">{{ Users.info }}</td>
              <td class="nowrap">{{ Users.created_at }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% else %}
    <div class="card__body"><div class="empty">{{ icon('message-circle') }}<p>–</p></div></div>
    {% endif %}
  </section>
</div>
{% include 'admin/overall_footer.html.twig' %}
