{% include 'admin/overall_header.html.twig' %}
<div class="grid">
{% for Mod in (MVC)|php_iter %}
  <section class="card">
    <header class="card__head"><h2 class="card__title">{{ icon('puzzle') }}{{ Mod.title }}</h2></header>
    <div class="card__body stack">
      <dl class="kv">
        <dt>{{ mvc_title }}</dt><dd>{{ Mod.title }}</dd>
        <dt>{{ mvc_author }}</dt><dd>{{ Mod.author }}</dd>
        <dt>{{ mvc_version }}</dt><dd>{{ Mod.version }}</dd>
        <dt>{{ mvc_link }}</dt><dd><a href="{{ Mod.link }}" target="_blank" rel="noopener">{{ Mod.link }}</a></dd>
        <dt>{{ mvc_desc }}</dt><dd>{{ Mod.description }}</dd>
        {% if Mod.udetails %}
        <dt>{{ mvc_update_version }}</dt><dd>{{ Mod.udetails.version }}</dd>
        <dt>{{ mvc_update_date }}</dt><dd>{{ Mod.udetails.date }}</dd>
        <dt>{{ mvc_download }}</dt><dd><a href="{{ Mod.udetails.download }}" target="_blank" rel="noopener">{{ Mod.udetails.download }}</a></dd>
        <dt>{{ mvc_announcement }}</dt><dd><a href="{{ Mod.udetails.announcement }}" target="_blank" rel="noopener">{{ Mod.udetails.announcement }}</a></dd>
        {% endif %}
      </dl>
      {% if Mod.update %}<div class="notice notice--info">{{ icon('info') }}<div>{{ Mod.update }}</div></div>{% endif %}
    </div>
  </section>
{% endfor %}
</div>
{% include 'admin/overall_footer.html.twig' %}
