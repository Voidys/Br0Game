{% include 'admin/overall_header.html.twig' %}
<div class="stack">
<nav class="tabs" aria-label="{{ LNG.ad_editor_title }}">
  <a href="?page=accountEditor">{{ icon('layout-dashboard') }}{{ LNG.ad_editor_title }}</a>
  <a href="?page=accountEditor&amp;edit=buildings">{{ icon('building-2') }}{{ LNG.ad_editor_buildings }}</a>
  <a href="?page=accountEditor&amp;edit=ships">{{ icon('rocket') }}{{ LNG.ad_editor_ships }}</a>
  <a href="?page=accountEditor&amp;edit=defenses">{{ icon('shield') }}{{ LNG.ad_editor_defenses }}</a>
  <a href="?page=accountEditor&amp;edit=researchs">{{ icon('flask-conical') }}{{ LNG.ad_editor_researchs }}</a>
  <a href="?page=accountEditor&amp;edit=resources">{{ icon('database') }}{{ LNG.ad_editor_resources }}</a>
  <a href="?page=accountEditor&amp;edit=planets">{{ icon('orbit') }}{{ LNG.ad_editor_planets }}</a>
  <a href="?page=accountEditor&amp;edit=personal" aria-current="page">{{ icon('user') }}{{ LNG.ad_editor_personal }}</a>
  <a href="?page=accountEditor&amp;edit=alliances">{{ icon('handshake') }}{{ LNG.ad_editor_alliances }}</a>
</nav>
  <form action="" method="post" data-track-dirty>
    <div class="stack">
      <section class="card">
        <header class="card__head"><h2 class="card__title">{{ icon('user') }}{{ LNG.ad_personal_title }}</h2></header>
        <div class="card__body form-grid">
          <div class="field-row">
            <label for="ae-id">{{ LNG.input_id_user }}</label>
            <div class="field-control"><input id="ae-id" name="id" type="text" inputmode="numeric"></div>
          </div>
          <div class="field-row">
            <label for="ae-username">{{ LNG.ad_personal_name }}</label>
            <div class="field-control"><input id="ae-username" name="username" type="text" autocomplete="off"></div>
          </div>
        </div>
      </section>
      <section class="card">
        <header class="card__head"><h2 class="card__title">{{ icon('clock') }}{{ LNG.ad_personal_vacat }}</h2></header>
        <div class="card__body">
          <div class="fields">
            <div class="field"><label for="ae-vacation">{{ LNG.ad_personal_vacat }}</label>{{ html_options({'name': 'vacation', 'id': 'ae-vacation', 'options': Selector}) }}</div>
            <div class="field"><label for="ae-d">{{ LNG.time_days }}</label><input id="ae-d" class="num" name="d" type="number" min="0" maxlength="5"></div>
            <div class="field"><label for="ae-h">{{ LNG.time_hours }}</label><input id="ae-h" class="num" name="h" type="number" min="0" maxlength="10"></div>
            <div class="field"><label for="ae-m">{{ LNG.time_minutes }}</label><input id="ae-m" class="num" name="m" type="number" min="0" maxlength="10"></div>
            <div class="field"><label for="ae-s">{{ LNG.time_seconds }}</label><input id="ae-s" class="num" name="s" type="number" min="0" maxlength="10"></div>
          </div>
        </div>
      </section>
      <div class="form-actions">
        <button type="submit" class="btn--primary">{{ icon('save') }}{{ LNG.button_submit }}</button>
      </div>
    </div>
  </form>
</div>
{% include 'admin/overall_footer.html.twig' %}
