includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - phpstan-baseline.neon

parameters:
    # level 6: new code must declare parameter, return, property and iterable value types; the existing gaps are baselined
    level: 6
    paths:
        - src
        - tests
    # constants and global helpers of the game (also loaded by composer "autoload.files")
    bootstrapFiles:
        - src/Game/Support/game_constants.php
        - src/Game/Support/functions.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    treatPhpDocTypesAsCertain: false
    # typed game-state rows (they stay arrays at runtime: in-place writes and copy semantics are unchanged);
    # the known columns are typed, further keys (settings, tech levels, merged data) stay open
    typeAliases:
        UserRow: 'array{id: int, username: string, universe: int, authlevel: int, ally_id: int, id_planet: int, galaxy: int, system: int, planet: int, onlinetime: int, register_time: int, urlaubs_modus: int, bana: int, banaday: int, user_lastip: string, ...<string, mixed>}'
        PlanetRow: 'array{id: int, name: string, id_owner: int, universe: int, galaxy: int, system: int, planet: int, planet_type: int|string, destruyed: int, last_update: int, id_luna: int, diameter: int, field_current: int, field_max: int, temp_min: int, temp_max: int, image: string, b_building: int|float, metal: int|float, crystal: int|float, deuterium: int|float, energy: int|float, energy_used: int|float, ...<string, mixed>}'
    # game state / config objects are dynamic bags (magic __get, ad-hoc property writes)
    universalObjectCratesClasses:
        - App\Game\Core\Singleton
        - App\Game\Core\Config
        - App\Game\Core\Log
        - App\Game\Core\Session
